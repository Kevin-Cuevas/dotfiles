#!/usr/bin/env bash
# dev-nvim — Instala/actualiza Neovim eligiendo entre dos métodos:
#   - tarball : binario precompilado oficial de los releases de GitHub
#               (rápido, seguro, funciona en x86_64 y arm64).
#   - build   : compila desde fuente con -march=native (solo x86_64, optimizado).
#
# Ambos métodos instalan en /opt/nvim + symlink /usr/local/bin/nvim, así que son
# INTERCAMBIABLES: reinstalar con el otro método reemplaza limpio lo anterior.
#
# Compatible con el bootstrap: respeta la env var NONINTERACTIVE. En modo no
# interactivo (sin terminal / `--all`) usa SIEMPRE el método más seguro: tarball.
set -euo pipefail

# ─── helpers ────────────────────────────────────────────────────────────────
log() { echo "[INFO] $*"; }
ok() { echo "[ OK] $*"; }
warn() { echo "[WARN] $*"; }
err() {
  echo "[ERR]  $*" >&2
  exit 1
}

# ─── constantes / entorno ────────────────────────────────────────────────────
NONINTERACTIVE="${NONINTERACTIVE:-false}"
ARCH="$(uname -m)"
NVIM_PREFIX="/opt/nvim"
NVIM_SYMLINK="/usr/local/bin/nvim"
BACKTITLE="dev-nvim · $(hostname) · $(date '+%Y-%m-%d %H:%M')"

# arch → nombre de arquitectura usado en los tarballs oficiales
case "$ARCH" in
x86_64) TARBALL_ARCH="x86_64" ;;
aarch64) TARBALL_ARCH="arm64" ;;
*) TARBALL_ARCH="" ;; # sin tarball oficial para esta arch
esac

# la compilación desde fuente solo está soportada en x86_64
BUILD_SUPPORTED=false
[[ "$ARCH" == "x86_64" ]] && BUILD_SUPPORTED=true

# ─── sudo keepalive + limpieza ───────────────────────────────────────────────
cleanup() {
  [[ -n "${SUDO_KEEPALIVE_PID:-}" ]] && kill "$SUDO_KEEPALIVE_PID" 2>/dev/null || true
  # borra todo el scratch (clone + build, pueden ser cientos de MB) para no
  # dejar archivos basura ocupando espacio.
  [[ -n "${TMP_DIR:-}" ]] && rm -rf "$TMP_DIR" 2>/dev/null || true
}
trap cleanup EXIT

log "Se requieren permisos de administrador..."
sudo -v
(while true; do
  sudo -n true
  sleep 55
done) &
SUDO_KEEPALIVE_PID=$!

TMP_DIR=$(mktemp -d)
log "Usando directorio temporal: $TMP_DIR"

# ─── UI: dialog si está disponible, si no read en texto plano ────────────────
have_dialog() { command -v dialog &>/dev/null; }

# Pregunta sí/no. Devuelve 0 = sí, 1 = no. Por defecto NO (seguro).
ask_yes_no() {
  local prompt="$1" rc
  if have_dialog; then
    # el if evita que un "No" (exit 1) aborte el script bajo `set -e`.
    if dialog --clear --backtitle "$BACKTITLE" \
      --title " Confirmar " --defaultno \
      --yesno "$prompt" 8 72; then
      rc=0
    else
      rc=$?
    fi
    clear
    return "$rc"
  fi
  warn "$prompt [s/N]"
  local reply
  read -r reply
  [[ "$reply" =~ ^[sS]$ ]]
}

# Elige el método de instalación. Deja el resultado en la global CHOSEN_METHOD:
# "build", "tarball", o "" (vacío) si el usuario cancela. NO se llama por command
# substitution a propósito: así el `clear`/dibujado de dialog no contaminan nada.
CHOSEN_METHOD=""
choose_method() {
  CHOSEN_METHOD=""
  if have_dialog; then
    local choice rc
    # el if captura el exit de dialog sin que Cancel/ESC (!=0) aborte por `set -e`.
    if choice=$(dialog --clear --backtitle "$BACKTITLE" \
      --title " Instalar Neovim " \
      --ok-label "Instalar" --cancel-label "Cancelar" \
      --menu "\nElige el método de instalación:" \
      13 72 2 \
      "build" "Compilar desde fuente  (-march=native, optimizado)" \
      "tarball" "Tarball precompilado oficial  (rápido, seguro)" \
      3>&1 1>&2 2>&3); then
      rc=0
    else
      rc=$?
    fi
    clear
    # rc!=0 → Cancel o ESC: dejar CHOSEN_METHOD vacío (= cancelado).
    if ((rc == 0)); then CHOSEN_METHOD="$choice"; fi
    return 0
  fi
  # fallback texto (sin dialog)
  echo ""
  echo "  Método de instalación de Neovim:"
  echo "    1) build   — compilar desde fuente (-march=native, optimizado)"
  echo "    2) tarball — precompilado oficial (rápido, seguro)"
  echo "    q) cancelar"
  local choice
  read -rp "  Opción [1/2/q]: " choice
  case "$choice" in
  1 | build | b) CHOSEN_METHOD="build" ;;
  2 | tarball | t) CHOSEN_METHOD="tarball" ;;
  q | Q | c | cancel) CHOSEN_METHOD="" ;; # cancelar
  *) CHOSEN_METHOD="tarball" ;;           # default seguro
  esac
  return 0
}

# ─── versión instalada actualmente ───────────────────────────────────────────
CURRENT_VERSION="$(nvim --version 2>/dev/null | head -1 || true)"
if [[ -n "$CURRENT_VERSION" ]]; then
  log "Versión actual: $CURRENT_VERSION"
else
  warn "nvim no encontrado, procediendo con instalación..."
fi

# ─── helpers de instalación (comunes a ambos métodos) ────────────────────────

# Lee la versión de Neovim desde el CMakeLists.txt clonado, SIN compilar.
# Produce la misma cadena que `nvim --version | head -1`, p.ej. "NVIM v0.12.2".
get_source_version() {
  local cml="$1/CMakeLists.txt"
  [[ -f "$cml" ]] || {
    echo ""
    return
  }
  local maj min pat pre
  maj=$(grep -m1 -E 'set\(NVIM_VERSION_MAJOR' "$cml" | grep -oE '[0-9]+' | head -1)
  min=$(grep -m1 -E 'set\(NVIM_VERSION_MINOR' "$cml" | grep -oE '[0-9]+' | head -1)
  pat=$(grep -m1 -E 'set\(NVIM_VERSION_PATCH' "$cml" | grep -oE '[0-9]+' | head -1)
  pre=$(grep -m1 -E 'set\(NVIM_VERSION_PRERELEASE' "$cml" | sed -E 's/[^"]*"([^"]*)".*/\1/')
  [[ -n "$maj$min$pat" ]] || {
    echo ""
    return
  }
  echo "NVIM v${maj}.${min}.${pat}${pre}"
}

# Decide si seguir adelante cuando la versión a instalar coincide con la actual.
# Devuelve 0 = proceder, 1 = cancelar.
confirm_same_version() {
  local new_version="$1"
  if [[ -n "$new_version" && "$CURRENT_VERSION" == "$new_version" ]]; then
    if [[ "$NONINTERACTIVE" == "true" ]]; then
      log "Non-interactive — reinstalando misma versión ($new_version)."
      return 0
    fi
    ask_yes_no "Ya tienes instalada $new_version.\n\n¿Instalar de todas formas?" || return 1
  else
    log "Actualizando: ${CURRENT_VERSION:-<ninguna>} → ${new_version:-<desconocida>}"
  fi
  return 0
}

# Elimina cualquier instalación previa (build, tarball o apt). Esto es lo que
# hace que los dos métodos sean intercambiables.
remove_previous_install() {
  log "Eliminando instalación anterior..."
  sudo rm -f "$NVIM_SYMLINK"
  sudo rm -rf "$NVIM_PREFIX"
  if dpkg -s neovim &>/dev/null; then
    log "nvim presente vía apt, desinstalando..."
    sudo apt-get remove --purge -y neovim
    sudo apt-get autoremove -y
  else
    ok "nvim no está instalado vía apt"
  fi
}

# Symlink final + reporte de versión. Común a ambos métodos.
finalize() {
  sudo ln -sf "$NVIM_PREFIX/bin/nvim" "$NVIM_SYMLINK"
  echo ""
  ok "Instalación completa"
  log "Versión instalada:"
  "$NVIM_PREFIX/bin/nvim" --version | head -1
}

# ─── método 1: tarball precompilado ──────────────────────────────────────────
install_tarball() {
  [[ -n "$TARBALL_ARCH" ]] || err "No hay tarball oficial para la arquitectura $ARCH"

  log "Modo: instalación desde tarball precompilado (${TARBALL_ARCH})"
  local tarball="nvim-linux-${TARBALL_ARCH}.tar.gz"
  local extract_dir="$TMP_DIR/nvim-linux-${TARBALL_ARCH}"

  log "Descargando $tarball..."
  curl -fL --progress-bar \
    "https://github.com/neovim/neovim/releases/download/stable/${tarball}" \
    -o "$TMP_DIR/$tarball" || err "Falló la descarga del tarball"

  log "Extrayendo..."
  tar xzf "$TMP_DIR/$tarball" -C "$TMP_DIR"

  local new_version
  new_version=$("$extract_dir/bin/nvim" --version | head -1)
  log "Versión a instalar: $new_version"

  confirm_same_version "$new_version" || return 1

  remove_previous_install
  log "Instalando en $NVIM_PREFIX..."
  sudo mv "$extract_dir" "$NVIM_PREFIX"
}

# ─── método 2: compilación desde fuente (solo x86_64) ────────────────────────

# Dependencias pesadas de compilación (apt). Solo se instalan si de verdad
# vamos a compilar (después de confirmar la versión).
install_build_deps() {
  log "Instalando dependencias de compilación..."
  # Habilitar deb-src si no está activo (necesario para build-dep)
  if ! grep -qE '^deb-src' /etc/apt/sources.list /etc/apt/sources.list.d/*.list 2>/dev/null; then
    log "Habilitando deb-src en sources.list..."
    sudo sed -i 's/^deb \(.*\)/deb \1\ndeb-src \1/' /etc/apt/sources.list
    sudo apt-get update -qq
  fi
  # build-dep jala todo lo que el paquete Debian necesita (luv, libuv, msgpack...)
  sudo apt-get build-dep -y neovim
  # gaps entre el paquete Debian y el upstream stable de GitHub:
  #   libutf8proc-dev -> requerido por nvim stable, no jalado por build-dep
  #   cmake           -> asegurar versión reciente
  sudo apt-get install -y --no-install-recommends \
    git ninja-build curl ca-certificates cmake \
    libutf8proc-dev libluajit-5.1-dev
}

build_source() {
  log "Modo: compilación desde fuente con flags nativos"

  # git es lo único imprescindible para clonar y leer la versión antes de nada.
  if ! command -v git &>/dev/null; then
    log "git no encontrado — instalando..."
    sudo apt-get install -y git
  fi

  # clonar (todavía SIN compilar) para conocer la versión que se construiría.
  local nvim_src="$TMP_DIR/neovim"
  log "Clonando repositorio neovim (rama stable)..."
  git clone --depth 1 --branch stable \
    https://github.com/neovim/neovim.git "$nvim_src"
  git -C "$nvim_src" config advice.detachedHead false

  local new_version
  new_version=$(get_source_version "$nvim_src")
  log "Versión a compilar: ${new_version:-<desconocida>}"

  # Si coincide con la instalada, preguntar ANTES de gastar tiempo compilando.
  confirm_same_version "$new_version" || return 1

  # Ahora sí: dependencias pesadas + compilación.
  install_build_deps

  # -march=native deja que GCC detecte el CPU exacto (Intel/AMD/Zen/etc) sin
  # adivinar vendor/familia. Requiere gcc>=9 para reconocer CPUs modernos; con
  # un gcc viejo caemos a un baseline x86-64 universalmente soportado.
  local gcc_major march_flag
  gcc_major=$(gcc -dumpversion | cut -d. -f1)
  if ((gcc_major >= 9)); then
    march_flag="-march=native"
  else
    warn "gcc $gcc_major < 9: usando baseline -march=x86-64"
    march_flag="-march=x86-64"
  fi

  # flags de compilación — vía un WRAPPER de gcc que appendea los flags al final
  # de cada invocación. Es el único mecanismo que los hace llegar a TODO de forma
  # uniforme:
  #   - core de nvim y deps de cmake (treesitter/libuv/luv): honran CMAKE_C_FLAGS,
  #     pero el wrapper también gana porque GCC es last-wins para -O/-march.
  #   - LuaJIT: ignora CMAKE_C_FLAGS y la env var CFLAGS; su Makefile solo honra CC
  #     (se compila con `make CC=${DEPS_C_COMPILER}` y -O2 hardcodeado). Al setear
  #     el wrapper como CMAKE_C_COMPILER, DEPS_C_COMPILER lo hereda y el -march
  #     appendeado llega a LuaJIT (mantiene su -O2, que es lo recomendado upstream).
  # Conservamos -g para que el binario lleve DWARF y la verificación sea válida.
  # El nivel de optimización (-O3) NO va aquí: lo fija CMAKE_C_FLAGS_RELEASE para
  # core y deps, y LuaJIT se queda en su -O2 nativo. Así evitamos duplicación -O.
  local native_cc append_flags cc_wrapper deps_dir build_dir nproc
  native_cc="$(command -v gcc)"
  append_flags="$march_flag -mtune=native -g -pipe"
  cc_wrapper="$TMP_DIR/cc-native"
  cat >"$cc_wrapper" <<EOF
#!/usr/bin/env bash
exec "$native_cc" "\$@" $append_flags
EOF
  chmod +x "$cc_wrapper"
  deps_dir="$nvim_src/.deps"
  build_dir="$nvim_src/build"
  nproc=$(nproc)

  log "Compilador: $native_cc ($(gcc --version | head -1))"
  log "Flags nativos (append): $append_flags"

  # ── paso 1: dependencias bundled (treesitter, luajit, luv) ──────────────
  # Debian Trixie trae libtree-sitter 0.22; nvim stable requiere >=0.25, por eso
  # se compilan bundled. También reciben los flags nativos vía el wrapper.
  log "Compilando dependencias bundled (treesitter, luajit, luv...)..."
  cmake -S "$nvim_src/cmake.deps" -B "$deps_dir" \
    -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_C_COMPILER="$cc_wrapper" \
    -DCMAKE_C_FLAGS_RELEASE="-O3 -DNDEBUG" \
    -DUSE_BUNDLED=ON \
    -DUSE_BUNDLED_TS=ON \
    -DUSE_BUNDLED_LUAJIT=ON \
    -DUSE_BUNDLED_LUV=ON
  cmake --build "$deps_dir" --parallel "$nproc"

  # ── paso 2: build principal ───────────────────────────────────────────
  log "Configurando build principal..."
  # CMAKE_C_FLAGS_RELEASE fija -O3 (sin -O2 heredado) para el core; el wrapper
  # (CMAKE_C_COMPILER) appendea -march=native/-g, que llega también a LuaJIT.
  cmake -S "$nvim_src" -B "$build_dir" \
    -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_C_COMPILER="$cc_wrapper" \
    -DCMAKE_C_FLAGS_RELEASE="-O3 -DNDEBUG" \
    -DCMAKE_INSTALL_PREFIX="$NVIM_PREFIX" \
    -DCMAKE_PREFIX_PATH="$deps_dir/usr"

  log "Compilando con $nproc núcleos..."
  cmake --build "$build_dir" --parallel "$nproc"

  remove_previous_install
  log "Instalando en $NVIM_PREFIX..."
  sudo cmake --install "$build_dir"

  # verificación: con el wrapper, TODOS los compile units (incl. LuaJIT, el primero
  # que reporta readelf) deben mostrar el -march real del CPU (p.ej. znver3), nunca
  # el x86-64 sin optimizar. El conteo de instrucciones AVX2 (ymm) no debería bajar.
  log "Verificando flags del binario instalado..."
  local producer detected_march ymm
  producer=$(readelf -wi "$NVIM_PREFIX/bin/nvim" 2>/dev/null |
    grep -am1 "DW_AT_producer" | sed -E 's/.*\): //')
  detected_march=$(grep -oE -- '-march=[^ ]+' <<<"$producer" | head -1)
  ymm=$(objdump -d "$NVIM_PREFIX/bin/nvim" 2>/dev/null | grep -c "ymm")
  case "$detected_march" in
  "" | "-march=x86-64")
    warn "El binario no quedó optimizado (${detected_march:-sin -march}): ${producer:-<sin DWARF>}"
    ;;
  *)
    ok "DWARF producer: ${detected_march} confirmado"
    ;;
  esac
  log "Instrucciones AVX2 (ymm): $ymm"
}

# ─── selección de método + ejecución ─────────────────────────────────────────
# No interactivo si: lo pide el bootstrap (NONINTERACTIVE=true) o no hay terminal
# (stdin no es un tty: pipe, CI, `curl | bash`...). En ambos casos no se puede
# mostrar el menú, así que se usa el método más seguro: tarball.
if [[ "$NONINTERACTIVE" == "true" ]] || ! [ -t 0 ]; then
  log "Modo no interactivo — usando tarball (método seguro)."
  METHOD="tarball"
else
  choose_method
  METHOD="$CHOSEN_METHOD"
fi

# Cancelado en el menú (Cancel/ESC/q): salir sin tocar nada.
if [[ -z "$METHOD" ]]; then
  log "Instalación cancelada."
  exit 0
fi

# Fallback: si se pide build pero el CPU/arquitectura no lo soporta, usar tarball.
if [[ "$METHOD" == "build" && "$BUILD_SUPPORTED" != "true" ]]; then
  warn "Compilación no soportada en $ARCH — usando tarball precompilado."
  METHOD="tarball"
fi

case "$METHOD" in
build)
  if build_source; then
    finalize
  else
    log "Instalación cancelada."
  fi
  ;;
tarball)
  if install_tarball; then
    finalize
  else
    log "Instalación cancelada."
  fi
  ;;
*)
  err "Método desconocido: $METHOD"
  ;;
esac
