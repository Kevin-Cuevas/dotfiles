# ===============================================================================
# SSH — nivek
# ===============================================================================

# -- config local ----------------------------------------------------------- #

Include ~/.ssh/config.local

# -- defaults ---------------------------------------------------------------- #

Host *
    AddKeysToAgent yes
    IdentitiesOnly yes
    ServerAliveInterval 30
    ServerAliveCountMax 3
    ControlMaster auto
    ControlPersist 10m
    ControlPath ~/.ssh/cm/%C

# ===============================================================================
# hosts
# ===============================================================================
#
# Los alias de host (Tailscale, LAN, familia, etc.) NO viven aquí: son específicos
# de cada máquina y se mantienen fuera del repositorio. Se cargan vía el Include de
# arriba desde ~/.ssh/config.local.
#
# Para crearlos/actualizarlos:  ./bootstrap  ->  opción "Configure SSH"
#   - Manual:    Host / HostName / User / Port / IdentityFile
#   - Tailscale: autodetecta los nodos de tu tailnet y rellena el User
#
# config.local no se rastrea; edita libremente FUERA del bloque gestionado.

