#!/usr/bin/env bash
# dev-packages — front door para todas las herramientas no-apt (nvim, tmux,
# kitty, yazi, peaclock, tmuxp, lavat): un único checklist `dialog` que instala
# o actualiza lo que el usuario marque. Standalone, igual que dev-ssh/dev-motd:
# no depende de bootstrap.d/*.sh ni de $DOTFILES_DIR, así que también corre
# suelto una vez stow-eado a ~/.local/bin.
#
# Cada instalador decide "¿ya está al día?" con lo mejor disponible para esa
# herramienta:
#   - nvim    -> build/tarball + detección de versión (corre en su propio
#                subshell con `set -e`, ver install_nvim más abajo).
#   - tmux    -> build desde fuente + último tag de git vs. versión instalada
#                (mismo patrón que nvim, ver install_tmux más abajo).
#   - yazi    -> compara versión contra el binario recién descargado.
#   - kitty   -> siempre re-corre el instalador oficial (in-place, seguro).
#   - tmuxp   -> pipx install / pipx upgrade.
#   - peaclock/lavat -> no publican versiones (solo git+build), así que se
#                compara el SHA remoto del HEAD contra uno guardado en
#                ~/.local/share/dev-packages/<tool>.sha tras el último build.
#
# nvim y tmux también tienen paquete apt con el mismo nombre: por defecto,
# instalarlos vía dev-packages remueve la versión apt (ver KEEP_APT_PKGS /
# --keep-apt más abajo) para que solo quede una versión en el PATH.
#
# Uso:
#   dev-packages                 checklist interactivo (dialog)
#   dev-packages --all           instala/actualiza todo, sin diálogo
#   dev-packages --only=a,b,c    instala/actualiza solo esas keys, sin diálogo
#   dev-packages --keep-apt      no purga el paquete apt si existe uno con el
#                                 mismo nombre (nvim/tmux) — deja ambos instalados
set -uo pipefail

# ─── helpers (mismo estilo que bootstrap.d/00-core.sh) ───────────────────────
RED='\e[38;2;191;97;106m'
GRN='\e[38;2;163;190;140m'
YLW='\e[38;2;235;203;139m'
BLU='\e[38;2;136;192;208m'
CYN='\e[38;2;143;188;187m'
DIM='\e[38;2;94;129;172m'
BLD='\e[1m'
RST='\e[0m'

info() { printf "${BLU}[INFO]${RST}  %s\n" "$*"; }
ok() { printf "${GRN}[OK]${RST}    %s\n" "$*"; }
err() { printf "${RED}[ERR]${RST}   %s\n" "$*" >&2; }
warn() { printf "${YLW}[WARN]${RST}  %s\n" "$*"; }
skip() { printf "${CYN}[SKIP]${RST}  %s\n" "$*"; }
sep() { printf "${DIM}%s${RST}\n" "  ──────────────────────────────────────────────────"; }

NONINTERACTIVE="${NONINTERACTIVE:-false}"
BACKTITLE="${DEV_PACKAGES_BACKTITLE:-dev-packages · $(hostname) · $(date '+%Y-%m-%d %H:%M')}"
STATE_DIR="$HOME/.local/share/dev-packages"

# ─── registro ─────────────────────────────────────────────────────────────
PKG_KEYS=(nvim tmux kitty yazi peaclock tmuxp lavat)
declare -A PKG_LABEL=(
  [nvim]="Neovim (build/tarball + versión)"
  [tmux]="tmux (terminal multiplexer, build desde fuente, versión-checked)"
  [kitty]="kitty (instalador oficial, actualiza in-place)"
  [yazi]="Yazi (file manager, release de GitHub, versión-checked)"
  [peaclock]="Peaclock (reloj de terminal, build desde fuente, sha-checked)"
  [tmuxp]="tmuxp (tmux session manager, pipx install/upgrade)"
  [lavat]="lavat (lava lamp de terminal, build desde fuente, sha-checked)"
)
declare -A PKG_FN=(
  [nvim]="install_nvim"
  [tmux]="install_tmux"
  [kitty]="install_kitty"
  [yazi]="install_yazi"
  [peaclock]="install_peaclock"
  [tmuxp]="install_tmuxp"
  [lavat]="install_lavat"
)

# ─── checklist propio (misma semántica que checklist_select_or_all) ─────────
select_packages() {
  local -n _out_ref="$1"
  _out_ref=()

  local _items=("__skip__" "Skip -- install none of the above" "off")
  local _key
  for _key in "${PKG_KEYS[@]}"; do
    _items+=("$_key" "${PKG_LABEL[$_key]}" "off")
  done

  local _raw
  _raw=$(dialog --clear --colors --backtitle "$BACKTITLE" \
    --title " dev-packages " --separate-output --checklist \
    "Select packages to install/update  [SPACE=toggle  ENTER=confirm]\n\nLeave everything unchecked and press ENTER to install/update ALL.\nCheck 'Skip' to do nothing." \
    18 72 10 "${_items[@]}" \
    3>&1 1>&2 2>&3) || return 1

  clear

  local _raw_chosen=() _line
  while IFS= read -r _line; do [[ -n "$_line" ]] && _raw_chosen+=("$_line"); done <<< "$_raw"

  for _line in "${_raw_chosen[@]}"; do
    [[ "$_line" == "__skip__" ]] && { _out_ref=(); return 0; }
  done

  if [[ ${#_raw_chosen[@]} -eq 0 ]]; then
    _out_ref=("${PKG_KEYS[@]}")
  else
    _out_ref=("${_raw_chosen[@]}")
  fi
}

# ─── utilidad compartida: SHA remoto del HEAD de un repo git ────────────────
remote_head_sha() {
  git ls-remote "$1" HEAD 2>/dev/null | awk '{print $1}'
}

# ─── utilidad compartida: remover paquete apt homónimo (nvim/tmux) ──────────
# Por defecto purga el paquete apt si existe uno con el mismo nombre, para
# que solo quede la versión de dev-packages en el PATH. KEEP_APT_PKGS=true
# (o --keep-apt) lo deja instalado en vez de purgarlo. log/warn/ok resuelven
# dinámicamente a lo que tenga definido el subshell que llame a esta función
# (igual que hoy hace install_nvim con sus funciones locales).
KEEP_APT_PKGS="${KEEP_APT_PKGS:-false}"
remove_apt_if_present() {
  local pkg="$1"
  if dpkg -s "$pkg" &>/dev/null; then
    if [[ "$KEEP_APT_PKGS" == "true" ]]; then
      warn "$pkg sigue instalado vía apt (KEEP_APT_PKGS=true) — puede haber dos binarios en PATH."
      return 0
    fi
    log "Removiendo $pkg instalado vía apt..."
    sudo apt-get remove --purge -y "$pkg"
    sudo apt-get autoremove -y
  else
    ok "$pkg no está instalado vía apt"
  fi
}

# ─── instaladores ────────────────────────────────────────────────────────────

# Instala/actualiza Neovim eligiendo entre dos métodos:
#   - tarball : binario precompilado oficial de los releases de GitHub
#               (rápido, seguro, funciona en x86_64 y arm64).
#   - build   : compila desde fuente con -march=native (solo x86_64, optimizado).
# Ambos métodos instalan en /opt/nvim + symlink /usr/local/bin/nvim, así que
# son INTERCAMBIABLES: reinstalar con el otro método reemplaza limpio lo
# anterior. En modo no interactivo usa SIEMPRE el método más seguro: tarball.
#
# Corre en un subshell propio con `set -euo pipefail`: es la forma más simple
# de que cualquier paso (descarga, compilación, cmake --install...) aborte
# esta instalación en particular sin tumbar el resto de dev-packages — y deja
# definir aquí adentro un err() que sale del subshell en vez del err() no
# fatal del resto del archivo, sin pisar el de afuera.
install_nvim() {
  sep
  (
    set -euo pipefail

    log() { echo "[INFO] $*"; }
    ok() { echo "[ OK] $*"; }
    warn() { echo "[WARN] $*"; }
    err() {
      echo "[ERR]  $*" >&2
      exit 1
    }

    ARCH="$(uname -m)"
    NVIM_PREFIX="/opt/nvim"
    NVIM_SYMLINK="/usr/local/bin/nvim"
    NVIM_BACKTITLE="dev-packages · nvim · $(hostname) · $(date '+%Y-%m-%d %H:%M')"

    case "$ARCH" in
    x86_64) TARBALL_ARCH="x86_64" ;;
    aarch64) TARBALL_ARCH="arm64" ;;
    *) TARBALL_ARCH="" ;;
    esac

    BUILD_SUPPORTED=false
    [[ "$ARCH" == "x86_64" ]] && BUILD_SUPPORTED=true

    cleanup() {
      [[ -n "${SUDO_KEEPALIVE_PID:-}" ]] && kill "$SUDO_KEEPALIVE_PID" 2>/dev/null || true
      [[ -n "${TMP_DIR:-}" ]] && rm -rf "$TMP_DIR" 2>/dev/null || true
    }
    trap cleanup EXIT

    log "Se requieren permisos de administrador..."
    sudo -v
    (while true; do
      sudo -n true
      sleep 55
    done) &
    SUDO_KEEPALIVE_PID=$!

    TMP_DIR=$(mktemp -d)
    log "Usando directorio temporal: $TMP_DIR"

    have_dialog() { command -v dialog &>/dev/null; }

    ask_yes_no() {
      local prompt="$1" rc
      if have_dialog; then
        if dialog --clear --backtitle "$NVIM_BACKTITLE" \
          --title " Confirmar " --defaultno \
          --yesno "$prompt" 8 72; then
          rc=0
        else
          rc=$?
        fi
        clear
        return "$rc"
      fi
      warn "$prompt [s/N]"
      local reply
      read -r reply
      [[ "$reply" =~ ^[sS]$ ]]
    }

    CHOSEN_METHOD=""
    choose_method() {
      CHOSEN_METHOD=""
      if have_dialog; then
        local choice rc
        if choice=$(dialog --clear --backtitle "$NVIM_BACKTITLE" \
          --title " Instalar Neovim " \
          --ok-label "Instalar" --cancel-label "Cancelar" \
          --menu "\nElige el método de instalación:" \
          13 72 2 \
          "build" "Compilar desde fuente  (-march=native, optimizado)" \
          "tarball" "Tarball precompilado oficial  (rápido, seguro)" \
          3>&1 1>&2 2>&3); then
          rc=0
        else
          rc=$?
        fi
        clear
        if ((rc == 0)); then CHOSEN_METHOD="$choice"; fi
        return 0
      fi
      echo ""
      echo "  Método de instalación de Neovim:"
      echo "    1) build   — compilar desde fuente (-march=native, optimizado)"
      echo "    2) tarball — precompilado oficial (rápido, seguro)"
      echo "    q) cancelar"
      local choice
      read -rp "  Opción [1/2/q]: " choice
      case "$choice" in
      1 | build | b) CHOSEN_METHOD="build" ;;
      2 | tarball | t) CHOSEN_METHOD="tarball" ;;
      q | Q | c | cancel) CHOSEN_METHOD="" ;;
      *) CHOSEN_METHOD="tarball" ;;
      esac
      return 0
    }

    CURRENT_VERSION="$(nvim --version 2>/dev/null | head -1 || true)"
    if [[ -n "$CURRENT_VERSION" ]]; then
      log "Versión actual: $CURRENT_VERSION"
    else
      warn "nvim no encontrado, procediendo con instalación..."
    fi

    get_source_version() {
      local cml="$1/CMakeLists.txt"
      [[ -f "$cml" ]] || {
        echo ""
        return
      }
      local maj min pat pre
      maj=$(grep -m1 -E 'set\(NVIM_VERSION_MAJOR' "$cml" | grep -oE '[0-9]+' | head -1)
      min=$(grep -m1 -E 'set\(NVIM_VERSION_MINOR' "$cml" | grep -oE '[0-9]+' | head -1)
      pat=$(grep -m1 -E 'set\(NVIM_VERSION_PATCH' "$cml" | grep -oE '[0-9]+' | head -1)
      pre=$(grep -m1 -E 'set\(NVIM_VERSION_PRERELEASE' "$cml" | sed -E 's/[^"]*"([^"]*)".*/\1/')
      [[ -n "$maj$min$pat" ]] || {
        echo ""
        return
      }
      echo "NVIM v${maj}.${min}.${pat}${pre}"
    }

    confirm_same_version() {
      local new_version="$1"
      if [[ -n "$new_version" && "$CURRENT_VERSION" == "$new_version" ]]; then
        if [[ "$NONINTERACTIVE" == "true" ]]; then
          log "Non-interactive — reinstalando misma versión ($new_version)."
          return 0
        fi
        ask_yes_no "Ya tienes instalada $new_version.\n\n¿Instalar de todas formas?" || return 1
      else
        log "Actualizando: ${CURRENT_VERSION:-<ninguna>} → ${new_version:-<desconocida>}"
      fi
      return 0
    }

    remove_previous_install() {
      log "Eliminando instalación anterior..."
      sudo rm -f "$NVIM_SYMLINK"
      sudo rm -rf "$NVIM_PREFIX"
      remove_apt_if_present neovim
    }

    finalize() {
      sudo ln -sf "$NVIM_PREFIX/bin/nvim" "$NVIM_SYMLINK"
      echo ""
      ok "Instalación completa"
      log "Versión instalada:"
      "$NVIM_PREFIX/bin/nvim" --version | head -1
    }

    install_tarball() {
      [[ -n "$TARBALL_ARCH" ]] || err "No hay tarball oficial para la arquitectura $ARCH"

      log "Modo: instalación desde tarball precompilado (${TARBALL_ARCH})"
      local tarball="nvim-linux-${TARBALL_ARCH}.tar.gz"
      local extract_dir="$TMP_DIR/nvim-linux-${TARBALL_ARCH}"

      log "Descargando $tarball..."
      curl -fL --progress-bar \
        "https://github.com/neovim/neovim/releases/download/stable/${tarball}" \
        -o "$TMP_DIR/$tarball" || err "Falló la descarga del tarball"

      log "Extrayendo..."
      tar xzf "$TMP_DIR/$tarball" -C "$TMP_DIR"

      local new_version
      new_version=$("$extract_dir/bin/nvim" --version | head -1)
      log "Versión a instalar: $new_version"

      confirm_same_version "$new_version" || return 1

      remove_previous_install
      log "Instalando en $NVIM_PREFIX..."
      sudo mv "$extract_dir" "$NVIM_PREFIX"
    }

    install_build_deps() {
      log "Instalando dependencias de compilación..."
      if ! grep -qE '^deb-src' /etc/apt/sources.list /etc/apt/sources.list.d/*.list 2>/dev/null; then
        log "Habilitando deb-src en sources.list..."
        sudo sed -i 's/^deb \(.*\)/deb \1\ndeb-src \1/' /etc/apt/sources.list
        sudo apt-get update -qq
      fi
      sudo apt-get build-dep -y neovim
      sudo apt-get install -y --no-install-recommends \
        git ninja-build curl ca-certificates cmake \
        libutf8proc-dev libluajit-5.1-dev
    }

    build_source() {
      log "Modo: compilación desde fuente con flags nativos"

      if ! command -v git &>/dev/null; then
        log "git no encontrado — instalando..."
        sudo apt-get install -y git
      fi

      local nvim_src="$TMP_DIR/neovim"
      log "Clonando repositorio neovim (rama stable)..."
      git clone --depth 1 --branch stable \
        https://github.com/neovim/neovim.git "$nvim_src"
      git -C "$nvim_src" config advice.detachedHead false

      local new_version
      new_version=$(get_source_version "$nvim_src")
      log "Versión a compilar: ${new_version:-<desconocida>}"

      confirm_same_version "$new_version" || return 1

      install_build_deps

      local gcc_major march_flag
      gcc_major=$(gcc -dumpversion | cut -d. -f1)
      if ((gcc_major >= 9)); then
        march_flag="-march=native"
      else
        warn "gcc $gcc_major < 9: usando baseline -march=x86-64"
        march_flag="-march=x86-64"
      fi

      local native_cc append_flags cc_wrapper deps_dir build_dir nproc
      native_cc="$(command -v gcc)"
      append_flags="$march_flag -mtune=native -g -pipe"
      cc_wrapper="$TMP_DIR/cc-native"
      cat >"$cc_wrapper" <<EOF
#!/usr/bin/env bash
exec "$native_cc" "\$@" $append_flags
EOF
      chmod +x "$cc_wrapper"
      deps_dir="$nvim_src/.deps"
      build_dir="$nvim_src/build"
      nproc=$(nproc)

      log "Compilador: $native_cc ($(gcc --version | head -1))"
      log "Flags nativos (append): $append_flags"

      log "Compilando dependencias bundled (treesitter, luajit, luv...)..."
      cmake -S "$nvim_src/cmake.deps" -B "$deps_dir" \
        -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_C_COMPILER="$cc_wrapper" \
        -DCMAKE_C_FLAGS_RELEASE="-O3 -DNDEBUG" \
        -DUSE_BUNDLED=ON \
        -DUSE_BUNDLED_TS=ON \
        -DUSE_BUNDLED_LUAJIT=ON \
        -DUSE_BUNDLED_LUV=ON
      cmake --build "$deps_dir" --parallel "$nproc"

      log "Configurando build principal..."
      cmake -S "$nvim_src" -B "$build_dir" \
        -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_C_COMPILER="$cc_wrapper" \
        -DCMAKE_C_FLAGS_RELEASE="-O3 -DNDEBUG" \
        -DCMAKE_INSTALL_PREFIX="$NVIM_PREFIX" \
        -DCMAKE_PREFIX_PATH="$deps_dir/usr"

      log "Compilando con $nproc núcleos..."
      cmake --build "$build_dir" --parallel "$nproc"

      remove_previous_install
      log "Instalando en $NVIM_PREFIX..."
      sudo cmake --install "$build_dir"

      log "Verificando flags del binario instalado..."
      local producer detected_march ymm
      producer=$(readelf -wi "$NVIM_PREFIX/bin/nvim" 2>/dev/null |
        grep -am1 "DW_AT_producer" | sed -E 's/.*\): //')
      detected_march=$(grep -oE -- '-march=[^ ]+' <<<"$producer" | head -1)
      ymm=$(objdump -d "$NVIM_PREFIX/bin/nvim" 2>/dev/null | grep -c "ymm")
      case "$detected_march" in
      "" | "-march=x86-64")
        warn "El binario no quedó optimizado (${detected_march:-sin -march}): ${producer:-<sin DWARF>}"
        ;;
      *)
        ok "DWARF producer: ${detected_march} confirmado"
        ;;
      esac
      log "Instrucciones AVX2 (ymm): $ymm"
    }

    if [[ "$NONINTERACTIVE" == "true" ]] || ! [ -t 0 ]; then
      log "Modo no interactivo — usando tarball (método seguro)."
      METHOD="tarball"
    else
      choose_method
      METHOD="$CHOSEN_METHOD"
    fi

    if [[ -z "$METHOD" ]]; then
      log "Instalación cancelada."
      exit 0
    fi

    if [[ "$METHOD" == "build" && "$BUILD_SUPPORTED" != "true" ]]; then
      warn "Compilación no soportada en $ARCH — usando tarball precompilado."
      METHOD="tarball"
    fi

    case "$METHOD" in
    build)
      if build_source; then
        finalize
      else
        log "Instalación cancelada."
      fi
      ;;
    tarball)
      if install_tarball; then
        finalize
      else
        log "Instalación cancelada."
      fi
      ;;
    *)
      err "Método desconocido: $METHOD"
      ;;
    esac
  )
}

# Instala/actualiza tmux compilando desde fuente. tmux no publica binarios
# precompilados en sus releases de GitHub (solo tarballs de código), así que,
# a diferencia de nvim, aquí solo hay un método: build. La versión objetivo
# se obtiene barato (sin clonar) con `git ls-remote --tags`, se compara contra
# `tmux -V` y solo si hace falta se clona/compila/instala.
#
# Mismo patrón que install_nvim: prefix /opt/tmux + symlink
# /usr/local/bin/tmux, subshell propio con `set -euo pipefail`, y
# remove_previous_install purga el paquete apt homónimo por defecto (ver
# remove_apt_if_present / KEEP_APT_PKGS arriba).
install_tmux() {
  sep
  (
    set -euo pipefail

    log() { echo "[INFO] $*"; }
    ok() { echo "[ OK] $*"; }
    warn() { echo "[WARN] $*"; }
    err() {
      echo "[ERR]  $*" >&2
      exit 1
    }

    TMUX_PREFIX="/opt/tmux"
    TMUX_SYMLINK="/usr/local/bin/tmux"
    TMUX_BACKTITLE="dev-packages · tmux · $(hostname) · $(date '+%Y-%m-%d %H:%M')"
    TMUX_REPO="https://github.com/tmux/tmux.git"

    cleanup() {
      [[ -n "${SUDO_KEEPALIVE_PID:-}" ]] && kill "$SUDO_KEEPALIVE_PID" 2>/dev/null || true
      [[ -n "${TMP_DIR:-}" ]] && rm -rf "$TMP_DIR" 2>/dev/null || true
    }
    trap cleanup EXIT

    have_dialog() { command -v dialog &>/dev/null; }

    ask_yes_no() {
      local prompt="$1" rc
      if have_dialog; then
        if dialog --clear --backtitle "$TMUX_BACKTITLE" \
          --title " Confirmar " --defaultno \
          --yesno "$prompt" 8 72; then
          rc=0
        else
          rc=$?
        fi
        clear
        return "$rc"
      fi
      warn "$prompt [s/N]"
      local reply
      read -r reply
      [[ "$reply" =~ ^[sS]$ ]]
    }

    CURRENT_VERSION="$(tmux -V 2>/dev/null || true)"
    if [[ -n "$CURRENT_VERSION" ]]; then
      log "Versión actual: $CURRENT_VERSION"
    else
      warn "tmux no encontrado, procediendo con instalación..."
    fi

    log "Consultando último tag de tmux upstream..."
    LATEST_TAG=$(git ls-remote --tags --refs "$TMUX_REPO" 2>/dev/null |
      awk -F/ '{print $NF}' | grep -E '^[0-9]+\.[0-9]+[a-z]?$' | sort -V | tail -1)
    [[ -n "$LATEST_TAG" ]] || err "No se pudo determinar el último tag de tmux"
    NEW_VERSION="tmux $LATEST_TAG"
    log "Última versión upstream: $NEW_VERSION"

    if [[ -n "$CURRENT_VERSION" && "$CURRENT_VERSION" == "$NEW_VERSION" ]]; then
      if [[ "$NONINTERACTIVE" == "true" ]]; then
        log "Non-interactive — reinstalando misma versión ($NEW_VERSION)."
      else
        ask_yes_no "Ya tienes instalada $NEW_VERSION.\n\n¿Instalar de todas formas?" || {
          log "Instalación cancelada."
          exit 0
        }
      fi
    else
      log "Actualizando: ${CURRENT_VERSION:-<ninguna>} → $NEW_VERSION"
    fi

    log "Se requieren permisos de administrador..."
    sudo -v
    (while true; do
      sudo -n true
      sleep 55
    done) &
    SUDO_KEEPALIVE_PID=$!

    TMP_DIR=$(mktemp -d)
    log "Usando directorio temporal: $TMP_DIR"

    log "Instalando dependencias de compilación..."
    sudo apt-get install -y --no-install-recommends \
      build-essential libevent-dev libncurses-dev bison pkg-config \
      autoconf automake git

    log "Clonando tmux $LATEST_TAG..."
    git clone --depth 1 --branch "$LATEST_TAG" "$TMUX_REPO" "$TMP_DIR/tmux"

    log "Generando configure (autogen.sh)..."
    (cd "$TMP_DIR/tmux" && sh autogen.sh)

    log "Configurando build (prefix: $TMUX_PREFIX)..."
    (cd "$TMP_DIR/tmux" && ./configure --prefix="$TMUX_PREFIX")

    nproc_count=$(nproc)
    log "Compilando con $nproc_count núcleos..."
    (cd "$TMP_DIR/tmux" && make -j"$nproc_count")

    log "Eliminando instalación anterior..."
    sudo rm -f "$TMUX_SYMLINK"
    sudo rm -rf "$TMUX_PREFIX"
    remove_apt_if_present tmux

    log "Instalando en $TMUX_PREFIX..."
    (cd "$TMP_DIR/tmux" && sudo make install)

    sudo ln -sf "$TMUX_PREFIX/bin/tmux" "$TMUX_SYMLINK"
    echo ""
    ok "Instalación completa"
    log "Versión instalada:"
    "$TMUX_PREFIX/bin/tmux" -V
  )
}

# Instala/actualiza kitty vía el instalador oficial (no hay paquete apt: la
# versión de Debian suele ir muy atrás). El propio script detecta una
# instalación previa en ~/.local/kitty.app y la reemplaza in-place sin tocar
# symlinks ni .desktop files, así que re-correrlo es también el mecanismo de
# actualización — no hace falta lógica de versión propia.
install_kitty() {
  sep
  info "Instalando/actualizando kitty..."
  if ! curl -L https://sw.kovidgoyal.net/kitty/installer.sh | sh /dev/stdin; then
    err "Falló el instalador de kitty"
    return 1
  fi
  ok "kitty instalado/actualizado -> $HOME/.local/kitty.app"
}

# Instala/actualiza yazi (terminal file manager) desde el binario precompilado
# oficial. Descarga y extrae primero para poder leer la versión candidata
# directamente del binario, la compara contra la instalada antes de tocar
# ~/.local/bin: si es la misma versión, pregunta (igual que install_nvim);
# si no, actualiza directo.
install_yazi() {
  sep
  local arch triple
  arch="$(uname -m)"
  case "$arch" in
  x86_64) triple="x86_64-unknown-linux-gnu" ;;
  aarch64) triple="aarch64-unknown-linux-gnu" ;;
  *)
    warn "No official yazi binary for architecture '$arch' — skipping."
    return 1
    ;;
  esac

  command -v unzip &>/dev/null || {
    err "unzip not found — install it first (sudo apt install unzip)."
    return 1
  }

  local current_version=""
  if command -v yazi &>/dev/null; then
    current_version="$(yazi --version 2>/dev/null | head -1)"
    info "Current yazi version: ${current_version:-unknown}"
  else
    info "yazi is not currently installed."
  fi

  local tmp
  tmp="$(mktemp -d)" || {
    err "Could not create temp dir for yazi download"
    return 1
  }

  local asset="yazi-${triple}.zip"
  local url="https://github.com/sxyazi/yazi/releases/latest/download/${asset}"

  info "Downloading $url ..."
  if ! curl -fL --progress-bar -o "$tmp/$asset" "$url"; then
    err "Failed to download $asset"
    rm -rf "$tmp"
    return 1
  fi

  info "Extracting..."
  if ! unzip -q -o "$tmp/$asset" -d "$tmp"; then
    err "Failed to extract $asset"
    rm -rf "$tmp"
    return 1
  fi

  local extracted_dir="$tmp/yazi-${triple}"
  if [[ ! -x "$extracted_dir/yazi" || ! -x "$extracted_dir/ya" ]]; then
    err "Expected yazi/ya binaries not found in $extracted_dir"
    rm -rf "$tmp"
    return 1
  fi

  local new_version
  new_version="$("$extracted_dir/yazi" --version 2>/dev/null | head -1)"

  if [[ -n "$current_version" && "$current_version" == "$new_version" ]]; then
    if [[ "$NONINTERACTIVE" == "true" ]]; then
      info "Non-interactive — reinstalling the same version ($new_version)."
    else
      if dialog \
          --clear --colors \
          --backtitle "$BACKTITLE" \
          --title " yazi " \
          --defaultno \
          --yesno "You already have $new_version installed.\n\nDownload and reinstall it anyway?" \
          9 64; then
        clear
      else
        clear
        skip "yazi reinstall skipped — already on $new_version"
        rm -rf "$tmp"
        return 0
      fi
    fi
  else
    info "Updating: ${current_version:-<none>} -> ${new_version:-<unknown>}"
  fi

  mkdir -p "$HOME/.local/bin"
  install -m 755 "$extracted_dir/yazi" "$HOME/.local/bin/yazi"
  install -m 755 "$extracted_dir/ya" "$HOME/.local/bin/ya"
  rm -rf "$tmp"

  ok "Installed yazi + ya -> $HOME/.local/bin ($new_version)"
}

# Instala/actualiza tmuxp (session manager de tmux) vía pipx, aislado en su
# propio venv. pipx trae su propio mecanismo de actualización — lo usamos
# directo en vez de reimplementar detección de versión.
install_tmuxp() {
  sep
  command -v pipx &>/dev/null || {
    err "pipx no encontrado — instálalo primero (sudo apt install pipx)."
    return 1
  }

  if command -v tmuxp &>/dev/null; then
    info "Actualizando tmuxp vía pipx..."
    if ! pipx upgrade tmuxp; then
      err "Falló 'pipx upgrade tmuxp'"
      return 1
    fi
    ok "tmuxp actualizado -> $(command -v tmuxp)"
  else
    info "Instalando tmuxp vía pipx..."
    if ! pipx install tmuxp &>/dev/null; then
      err "Falló 'pipx install tmuxp'"
      return 1
    fi
    ok "tmuxp instalado vía pipx -> $HOME/.local/bin/tmuxp"
  fi
}

# Compila peaclock (reloj estético de terminal) desde fuente. No hay binario
# oficial ni releases con versión, así que "¿hay actualización?" se decide
# comparando el SHA remoto del HEAD contra el que quedó guardado tras el
# último build exitoso — si no cambió, no vale la pena recompilar.
install_peaclock() {
  sep
  local repo="https://github.com/octobanana/peaclock"
  local state_file="$STATE_DIR/peaclock.sha"
  local remote_sha local_sha=""
  remote_sha="$(remote_head_sha "$repo")"
  [[ -f "$state_file" ]] && local_sha="$(<"$state_file")"

  if command -v peaclock &>/dev/null && [[ -n "$remote_sha" && "$remote_sha" == "$local_sha" ]]; then
    skip "peaclock ya está al día ($(command -v peaclock), $remote_sha)"
    return 0
  fi

  command -v git &>/dev/null || {
    err "git no encontrado — instálalo primero (sudo apt install git)."
    return 1
  }
  command -v cmake &>/dev/null || {
    err "cmake no encontrado — instálalo primero (sudo apt install cmake)."
    return 1
  }
  dpkg -s libicu-dev &>/dev/null || {
    err "Falta ICU — instala libicu-dev primero (sudo apt install libicu-dev)."
    return 1
  }

  local tmp
  tmp="$(mktemp -d)" || {
    err "No se pudo crear directorio temporal para peaclock"
    return 1
  }

  info "Clonando peaclock..."
  if ! git clone --depth=1 "$repo" "$tmp/peaclock" &>/dev/null; then
    err "Falló el clone de peaclock"
    rm -rf "$tmp"
    return 1
  fi

  info "Compilando peaclock (RUNME.sh build)..."
  if ! (cd "$tmp/peaclock" && ./RUNME.sh build --release) &>/dev/null; then
    err "Falló la compilación de peaclock"
    rm -rf "$tmp"
    return 1
  fi

  info "Instalando peaclock (RUNME.sh install)..."
  if ! (cd "$tmp/peaclock" && ./RUNME.sh install --release); then
    err "Falló la instalación de peaclock"
    rm -rf "$tmp"
    return 1
  fi

  rm -rf "$tmp"
  mkdir -p "$STATE_DIR"
  [[ -n "$remote_sha" ]] && echo "$remote_sha" > "$state_file"
  ok "peaclock instalado/actualizado -> $(command -v peaclock)"
}

# Compila lavat (lava lamp de terminal) desde fuente — mismo criterio que
# peaclock: sin releases con versión, se compara el SHA remoto del HEAD.
install_lavat() {
  sep
  local repo="https://github.com/AngelJumbo/lavat"
  local state_file="$STATE_DIR/lavat.sha"
  local remote_sha local_sha=""
  remote_sha="$(remote_head_sha "$repo")"
  [[ -f "$state_file" ]] && local_sha="$(<"$state_file")"

  if command -v lavat &>/dev/null && [[ -n "$remote_sha" && "$remote_sha" == "$local_sha" ]]; then
    skip "lavat ya está al día ($(command -v lavat), $remote_sha)"
    return 0
  fi

  command -v git &>/dev/null || {
    err "git no encontrado — instálalo primero (sudo apt install git)."
    return 1
  }

  local tmp
  tmp="$(mktemp -d)" || {
    err "No se pudo crear directorio temporal para lavat"
    return 1
  }

  info "Clonando lavat..."
  if ! git clone --depth=1 "$repo" "$tmp/lavat" &>/dev/null; then
    err "Falló el clone de lavat"
    rm -rf "$tmp"
    return 1
  fi

  info "Compilando lavat (make)..."
  if ! (cd "$tmp/lavat" && make) &>/dev/null; then
    err "Falló la compilación de lavat"
    rm -rf "$tmp"
    return 1
  fi

  info "Instalando lavat (sudo make install)..."
  if ! (cd "$tmp/lavat" && sudo make install) &>/dev/null; then
    err "Falló 'sudo make install' de lavat"
    rm -rf "$tmp"
    return 1
  fi

  rm -rf "$tmp"
  mkdir -p "$STATE_DIR"
  [[ -n "$remote_sha" ]] && echo "$remote_sha" > "$state_file"
  ok "lavat instalado/actualizado -> $(command -v lavat)"
}

# ─── arg parsing ─────────────────────────────────────────────────────────────
ONLY_KEYS=()
for arg in "$@"; do
  case "$arg" in
  --all) NONINTERACTIVE=true ;;
  --only=*)
    IFS=',' read -ra ONLY_KEYS <<< "${arg#--only=}"
    ;;
  --keep-apt) KEEP_APT_PKGS=true ;;
  *)
    err "Argumento desconocido: $arg"
    exit 1
    ;;
  esac
done

# ─── selección de keys a procesar ────────────────────────────────────────────
CHOSEN=()
if [[ ${#ONLY_KEYS[@]} -gt 0 ]]; then
  CHOSEN=("${ONLY_KEYS[@]}")
elif [[ "$NONINTERACTIVE" == "true" ]] || ! [ -t 0 ]; then
  info "Non-interactive mode — installing/updating all ${#PKG_KEYS[@]} package(s)"
  CHOSEN=("${PKG_KEYS[@]}")
else
  if ! command -v dialog &>/dev/null; then
    err "dialog no encontrado — instálalo primero (sudo apt install dialog) o usa --all/--only=."
    exit 1
  fi
  if ! select_packages CHOSEN; then
    warn "dev-packages cancelado."
    exit 0
  fi
fi

if [[ ${#CHOSEN[@]} -eq 0 ]]; then
  skip "No packages selected — nothing to do."
  exit 0
fi

# ─── ejecución + resumen ─────────────────────────────────────────────────────
succeeded=0
failed=()
for key in "${CHOSEN[@]}"; do
  fn="${PKG_FN[$key]:-}"
  if [[ -z "$fn" ]]; then
    warn "Unknown package key: $key"
    failed+=("$key")
    continue
  fi
  if "$fn"; then
    ((succeeded++)) || true
  else
    warn "Install/update failed: ${PKG_LABEL[$key]:-$key}"
    failed+=("$key")
  fi
done

sep
ok "Done — ok: $succeeded  failed: ${#failed[@]}"
[[ ${#failed[@]} -gt 0 ]] && warn "Failed: ${failed[*]}"
