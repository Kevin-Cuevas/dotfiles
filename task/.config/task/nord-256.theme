# Nord Theme for Taskwarrior
# Based on Nord color palette: https://www.nordtheme.com/

# Nord Theme for Taskwarrior - IMPROVED
# Based on Nord color palette: https://www.nordtheme.com/
# Tuned for terminals with a Nord theme

# Nord Theme for Taskwarrior - HIGH CONTRAST
# Tuned for terminals with a dark Nord background
# Uses more vibrant, higher-contrast colors

# Nord Theme for Taskwarrior - ELEGANT NORD BLUE
# Elegant design with an emphasis on Nord blues and underlines
# Tuned for maximum looks and usability

# Base colors - elegant and minimal
color.header=bold color4            # Strong Nord blue for headers
color.footnote=color8               # Medium Nord gray
color.error=bold color1             # Nord red for errors
color.debug=color4                  # Nord blue for debug

# Task states - elegant Nord blue palette
color.completed=bold color2         # Nord green - completed
color.deleted=color8                # Nord gray - deleted
color.active=bold color8 on color2            # NORD - active tasks
color.recurring=underline color5    # Underlined Nord purple - recurring
color.scheduled=color4              # Nord blue - scheduled
color.until=color3                  # Nord orange - until date
color.blocked=color1                # Nord red - blocked
color.blocking=bold color1          # Strong Nord red - blocking

# Due dates - natural but visible Nord gradient
color.due.today=bold underline color3    # Underlined orange for TODAY
color.due=color3                         # Nord orange for upcoming
color.overdue=bold color1                # Nord red for overdue

# Projects - Nord blue tones
color.project.none=color7           # Light Nord gray

# Tags - elegant Nord blues
color.tag.none=color7               # Light Nord gray
color.tagged=underline color4       # Underlined Nord blue for tagged

# Priorities - elegant Nord visual hierarchy
color.uda.priority.H=bold underline color1  # Underlined red - CRITICAL
color.uda.priority.M=bold color3            # Strong orange - MEDIUM
color.uda.priority.L=color7                 # Light gray - LOW
color.uda.priority.none=color8              # Medium gray - NO PRIORITY

# Labels - elegant Nord blue headers
color.label=bold color4             # Strong Nord blue
color.label.sort=bold underline color6 # Underlined cyan for sorted

# Calendar - beautiful Nord blue palette
color.calendar.due.today=bold white on color3     # White on orange
color.calendar.due=bold color1 on color8          # Red on gray
color.calendar.holiday=bold color2                # Nord green
color.calendar.overdue=bold white on color1       # White on red
color.calendar.today=bold underline color6        # Underlined cyan for today
color.calendar.weekend=color7                     # Light gray
color.calendar.weeknumber=color4                  # Nord blue

# Burndown - elegant Nord blue progress
color.burndown.done=bold white on color2      # White on green
color.burndown.pending=bold black on color3   # Black on orange
color.burndown.started=bold white on color4   # White on Nord blue

# History - semantic Nord colors
color.history.add=bold color2       # Nord green - added
color.history.delete=bold color1    # Nord red - deleted
color.history.done=bold color4      # Nord blue - completed

# Summary - elegant Nord blue
color.summary.background=bold color4 on color8  # Blue on gray
color.summary.bar=bold white on color4          # White on blue

# Alternating rows - very subtle Nord blue
color.alternate=on color0           # Alternating very dark Nord blue
