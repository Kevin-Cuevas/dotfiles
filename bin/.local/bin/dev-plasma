#!/usr/bin/env bash
# dev-plasma — sets up KDE Plasma with the dotfiles' Global Themes
# (NivekDarkNord / NivekLightNord): installs them from the repo's plasma/,
# installs whatever those themes reference, applies them as a light/dark pair
# and checks that no reference is left broken. Standalone, like
# dev-packages/dev-ssh: it doesn't depend on bootstrap.d/*.sh or $DOTFILES_DIR
# (plasma/ is located from this script's own real path).
#
# plasma/ is NOT stowed: Plasma reads Global Themes through KPackage, which
# rejects any file whose real path lies outside the package folder
# ("kf.package: Path traversal attempt detected"). With symlinks into
# ~/dotfiles it ignored contents/defaults and silently applied Breeze. So
# COPIES are installed, like any theme from "Get New…": the repo is the source
# and is edited there; then `dev-plasma --only=themes` reinstalls whatever
# changed.
#
# A Global Theme only NAMES its pieces (ColorScheme=, Icons Theme=,
# cursorTheme=, KSplash Theme=...) and Plasma doesn't complain if one is
# missing: it silently applies the rest. That's why each key installs one
# piece and --doctor checks that all of them exist:
#   - themes      -> the Global Themes with kpackagetool6 (Plasma's official
#                    package installer: -i or -u as needed), and the .colors
#                    and the wallpaper as copies (kpackagetool6 can't install
#                    image wallpapers: Wallpaper/Images has no root folder and
#                    its -u/-r fail). Only touches what differs. Also the
#                    launcher icon (nivek-debian, into hicolor). The themes
#                    have NO layout (contents/layouts): a layout replaces the
#                    whole panel, and the pinned apps with it.
#   - icons       -> papirus-icon-theme from apt + papirus-folders (GitHub)
#                    with "nordic" folders. apt installs Papirus with blue
#                    folders and resets them on every package upgrade, so the
#                    color is always checked, not just the install.
#   - splash      -> Kuro (bouteillerAlan/kuro, GPLv3) from git, not from the
#                    KDE store: "Get New…" URLs are signed and expire. No
#                    useful versions: the HEAD SHA is compared.
#   - sddm-cursor -> copies the theme's cursor to /usr/share/icons. SDDM runs
#                    as the `sddm` user, which can't enter a home with 0710
#                    permissions, so the login screen didn't show Bibata even
#                    when it was configured.
#   - apply       -> applies the theme matching the current mode and registers
#                    the light/dark pair in kdeglobals. It does NOT touch the
#                    "Switch to Dark Mode at Night" toggle (left as it was) or
#                    the panel.
#   - launcher-icon -> sets the nivek-debian icon on the launcher (Kickoff) of
#                    the panel you already have, through plasmashell
#                    scripting, and touches nothing else: no pinned apps, no
#                    widgets. Like the wallpaper: a hand-picked icon is kept
#                    in --all.
#   - wallpaper   -> sets Nord Flare (it has light and dark variants) only if
#                    the current wallpaper is KDE's stock one. A hand-picked
#                    one is kept in --all; it's only replaced when you choose
#                    this key.
#   - yakuake     -> writes the Yakuake settings listed in plasma/yakuake/
#                    yakuakerc (no borders, no title/tab bar, no tray icon...)
#                    key by key, so everything else in your yakuakerc stays.
#                    The Konsole profiles/colors come from the stowed konsole/
#                    package, and switching them with the light/dark mode is
#                    the job of dotfiles-konsole-theme-sync (dev-services).
#
# Outside KDE Plasma (servers, Termux) it does nothing and exits with 0.
#
# Usage:
#   dev-plasma                 interactive checklist (dialog)
#   dev-plasma --all           every key, no dialogs
#   dev-plasma --only=a,b,c    only those keys, no dialogs
#   dev-plasma --doctor        check only (installs/changes nothing)
#   dev-plasma --dark=ID       dark Global Theme  (default: NivekDarkNord)
#   dev-plasma --light=ID      light Global Theme (default: NivekLightNord)
#   dev-plasma -h | --help     this help
set -uo pipefail

# ─── helpers (same style as bootstrap.d/00-core.sh) ──────────────────────────
RED='\e[38;2;191;97;106m'
GRN='\e[38;2;163;190;140m'
YLW='\e[38;2;235;203;139m'
BLU='\e[38;2;136;192;208m'
CYN='\e[38;2;143;188;187m'
DIM='\e[38;2;94;129;172m'
# shellcheck disable=SC2034 # Nord palette shared across scripts; unused here
BLD='\e[1m'
RST='\e[0m'

info() { printf "${BLU}[INFO]${RST}  %s\n" "$*"; }
ok() { printf "${GRN}[OK]${RST}    %s\n" "$*"; }
err() { printf "${RED}[ERR]${RST}   %s\n" "$*" >&2; }
warn() { printf "${YLW}[WARN]${RST}  %s\n" "$*"; }
skip() { printf "${CYN}[SKIP]${RST}  %s\n" "$*"; }
sep() { printf "${DIM}%s${RST}\n" "  ──────────────────────────────────────────────────"; }

NONINTERACTIVE="${NONINTERACTIVE:-false}"
# The repo's plasma/, from the script's real path (bin/.local/bin/dev-plasma,
# stowed per-file into ~/.local/bin). DEV_PLASMA_SRC overrides it.
SRC_DIR="${DEV_PLASMA_SRC:-$(cd "$(dirname "$(readlink -f "$0")")/../../.." && pwd)/plasma}"
BACKTITLE="${DEV_PLASMA_BACKTITLE:-dev-plasma · $(hostname) · $(date '+%Y-%m-%d %H:%M')}"
STATE_DIR="$HOME/.local/share/dev-plasma"

THEME_DARK="${DEV_PLASMA_DARK:-NivekDarkNord}"
THEME_LIGHT="${DEV_PLASMA_LIGHT:-NivekLightNord}"
FOLDER_COLOR="${DEV_PLASMA_FOLDER_COLOR:-nordic}"
WALLPAPER="Nord-flare"
LAUNCHER_ICON="nivek-debian"
# true if the keys were picked by hand (checklist or --only), false in --all:
# decides whether the wallpaper may replace a hand-picked one.
EXPLICIT=true

LNF_DIRS=("$HOME/.local/share/plasma/look-and-feel" /usr/share/plasma/look-and-feel)
SCHEME_DIRS=("$HOME/.local/share/color-schemes" /usr/share/color-schemes)
# Same lookup order Plasma and papirus-folders use: the first one wins.
ICON_DIRS=("$HOME/.icons" "$HOME/.local/share/icons" /usr/share/icons)
SYSTEM_ICONS=/usr/share/icons

KURO_REPO="https://github.com/bouteillerAlan/kuro"
KURO_ID="a2n.kuro"
PAPIRUS_FOLDERS_URL="https://raw.githubusercontent.com/PapirusDevelopmentTeam/papirus-folders/master/papirus-folders"
PAPIRUS_FOLDERS_BIN="$HOME/.local/bin/papirus-folders"
SDDM_DROPIN=/etc/sddm.conf.d/dev-plasma.conf
YAKUAKE_RC_SRC="$SRC_DIR/yakuake/yakuakerc"
KONSOLE_DIR="$HOME/.local/share/konsole"
KONSOLE_DARK="NivekDarkNordKonsole"
KONSOLE_LIGHT="NivekLightNordKonsole"
TERM_SYNC_UNIT="dotfiles-konsole-theme-sync.service"

# ─── registry ───────────────────────────────────────────────────────────────
# PKG_KEYS order is the run order (regardless of --only's order): external
# pieces first, then applying the theme that uses them.
PKG_KEYS=(themes icons splash sddm-cursor apply wallpaper launcher-icon yakuake)
declare -A PKG_LABEL=(
  [themes]="Global Themes + colors + Nord Flare from the repo (kpackagetool6)"
  [icons]="Papirus from apt + $FOLDER_COLOR folders (papirus-folders)"
  [splash]="Kuro splash (git, sha-checked)"
  ["sddm-cursor"]="Theme cursor on the login screen too (SDDM, sudo)"
  [apply]="Apply $THEME_DARK / $THEME_LIGHT for the current mode"
  [wallpaper]="Nord Flare wallpaper (if you have the stock one)"
  ["launcher-icon"]="$LAUNCHER_ICON icon on the launcher (icon only)"
  [yakuake]="Yakuake settings: no borders, no title/tab bar, no tray icon"
)
declare -A PKG_FN=(
  [themes]="install_themes"
  [icons]="install_icons"
  [splash]="install_splash"
  ["sddm-cursor"]="install_sddm_cursor"
  [apply]="apply_theme"
  [wallpaper]="apply_wallpaper"
  ["launcher-icon"]="set_launcher_icon"
  [yakuake]="configure_yakuake"
)

# ─── utilities ──────────────────────────────────────────────────────────────

need_cmd() {
  command -v "$1" &>/dev/null && return 0
  err "$1 not found — install it first (sudo apt install ${2:-$1})."
  return 1
}

# Yes/No with dialog; without dialog, asks in plain text. Default: No.
ask_yes_no() {
  if command -v dialog &>/dev/null; then
    local rc=0
    dialog --clear --backtitle "$BACKTITLE" --title " Confirm " --defaultno \
      --yesno "$1" 10 72 || rc=$?
    clear
    return "$rc"
  fi
  warn "$1 [y/N]"
  local reply
  read -r reply
  [[ "$reply" =~ ^[yY]$ ]]
}

# plasma-apply-* talk to the session over DBus: from a TTY or over SSH there's
# nothing to apply anything to.
has_session() {
  [[ -n "${WAYLAND_DISPLAY:-}${DISPLAY:-}" ]]
}

# Folder of an installed Global Theme (user first, like Plasma).
lnf_dir() {
  local d
  for d in "${LNF_DIRS[@]}"; do
    [[ -f "$d/$1/metadata.json" ]] && {
      echo "$d/$1"
      return 0
    }
  done
  return 1
}

# A value from a Global Theme's contents/defaults. That file is a "blocked"
# kdeglobals: [file][group] followed by key=value.
#   lnf_default <id> <file> <group> <key>
lnf_default() {
  local dir
  dir="$(lnf_dir "$1")" || return 1
  awk -v hdr="[$2][$3]" -v key="$4" '
    /^\[/ { in_sec = ($0 == hdr); next }
    in_sec && index($0, key "=") == 1 { print substr($0, length(key) + 2); exit }
  ' "$dir/contents/defaults"
}

# Path of the .colors whose id is $1. The id is NOT the visible name: it's
# [General]ColorScheme= if present, otherwise the file name. Mixing these up
# is exactly the "the Global Theme shows as active but the colors don't
# change" bug.
scheme_file() {
  local d f id
  for d in "${SCHEME_DIRS[@]}"; do
    for f in "$d"/*.colors; do
      [[ -f "$f" ]] || continue
      id="$(awk '/^\[/ { g = ($0 == "[General]"); next } g && /^ColorScheme=/ { print substr($0, 13); exit }' "$f")"
      [[ -n "$id" ]] || id="$(basename "$f" .colors)"
      [[ "$id" == "$1" ]] && {
        echo "$f"
        return 0
      }
    done
  done
  return 1
}

# First folder where an icon/cursor theme is installed (the one that wins).
icon_theme_dir() {
  local d
  for d in "${ICON_DIRS[@]}"; do
    [[ -f "$d/$1/index.theme" ]] && {
      echo "$d/$1"
      return 0
    }
  done
  return 1
}

# Current Papirus folder color: folder.svg is a symlink to folder-<color>.svg
# (that's how papirus-folders changes it).
folder_color() {
  local dir icon
  dir="$(icon_theme_dir "$1")" || return 1
  icon="$(readlink -f "$dir/48x48/places/folder.svg")" || return 1
  icon="$(basename "$icon" .svg)"
  echo "${icon##*-}"
}

# Same rule as KPackage: every package file, once resolved (symlinks
# included), must stay inside the package's resolved root. Otherwise Plasma
# ignores it ("kf.package: Path traversal attempt detected") and silently
# applies Breeze. It happened with the old per-file stow: every file was a
# symlink into ~/dotfiles but the theme folder was real. Prints the first file
# that escapes.
kpackage_escape() {
  local root f real
  root="$(readlink -f "$1")" || return 1
  while IFS= read -r -d '' f; do
    real="$(readlink -f "$f")"
    [[ "$real" == "$root"/* ]] || {
      echo "${f#"$1"/} -> $real"
      return 0
    }
  done < <(find -L "$1" -type f -print0 2>/dev/null)
  return 1
}

remote_head_sha() {
  git ls-remote "$1" HEAD 2>/dev/null | awk '{print $1}'
}

# ─── themes ─────────────────────────────────────────────────────────────────
# Is $2 a faithful copy of $1? Besides comparing content it requires no
# symlinks: a leftover from the old stow would have the same content (diff
# follows links) but KPackage would still reject it.
same_tree() {
  [[ -e "$2" && ! -L "$2" ]] || return 1
  [[ -d "$2" && -n "$(find "$2" -type l -print -quit)" ]] && return 1
  diff -rq "$1" "$2" &>/dev/null
}

# Copies $1 to $2 (file or folder) unless it's already a faithful copy;
# replaces whatever was there entirely (including a symlink from the old
# stow).
sync_copy() {
  local src="$1" dst="$2"
  if same_tree "$src" "$dst"; then
    skip "$(basename "$dst") is already up to date"
    return 0
  fi
  mkdir -p "$(dirname "$dst")"
  rm -rf -- "${dst:?}"
  cp -r "$src" "$dst" || {
    err "Couldn't copy $src to $dst"
    return 1
  }
  ok "$(basename "$dst") installed -> $dst"
}

install_themes() {
  sep
  [[ -d "$SRC_DIR/look-and-feel" ]] || {
    err "Can't find the themes in $SRC_DIR (set DEV_PLASMA_SRC=<repo>/plasma)"
    return 1
  }
  need_cmd kpackagetool6 || return 1

  local src id dst op rc=0
  for src in "$SRC_DIR"/look-and-feel/*/; do
    src="${src%/}"
    id="$(basename "$src")"
    dst="${LNF_DIRS[0]}/$id"
    if same_tree "$src" "$dst"; then
      skip "$id is already up to date"
      continue
    fi
    # A symlink (from the old stow) is removed as a link, without touching
    # the repo.
    [[ -L "$dst" ]] && rm -f -- "$dst"
    op=--install
    [[ -d "$dst" ]] && op=--upgrade
    if kpackagetool6 -t Plasma/LookAndFeel "$op" "$src" &>/dev/null; then
      ok "$id installed (kpackagetool6 $op)"
    else
      err "kpackagetool6 $op $id failed"
      rc=1
    fi
  done

  local f
  for f in "$SRC_DIR"/color-schemes/*.colors; do
    [[ -f "$f" ]] || continue
    sync_copy "$f" "${SCHEME_DIRS[0]}/$(basename "$f")" || rc=1
  done
  for src in "$SRC_DIR"/wallpapers/*/; do
    [[ -d "$src" ]] || continue
    src="${src%/}"
    sync_copy "$src" "$HOME/.local/share/wallpapers/$(basename "$src")" || rc=1
  done
  # Our own icons (file by file: ~/.local/share/icons/hicolor already holds
  # other apps' icons). hicolor is every icon theme's fallback, so
  # nivek-debian shows up with Papirus, Breeze or any other.
  while IFS= read -r -d '' f; do
    sync_copy "$f" "$HOME/.local/share/icons/${f#"$SRC_DIR/icons/"}" || rc=1
  done < <(find "$SRC_DIR/icons" -type f -print0 2>/dev/null)
  return "$rc"
}

# ─── icon cache ─────────────────────────────────────────────────────────────
# Running apps (plasmashell included) keep in memory the icons they resolved
# at startup. After removing a Papirus copy, installing apt's, changing the
# folder color or copying a new icon, they keep showing broken icons or "?"
# until restarted. This rebuilds KDE's database (sycoca), restarts
# plasmashell ONCE per run and warns about the rest.
ICONS_CHANGED=false
PLASMA_REFRESHED=false
refresh_icon_caches() {
  $PLASMA_REFRESHED && return 0
  PLASMA_REFRESHED=true
  command -v kbuildsycoca6 &>/dev/null && kbuildsycoca6 --noincremental &>/dev/null
  if ! has_session; then
    skip "No graphical session — the new icons will show on the next login"
    return 0
  fi
  info "Restarting plasmashell so it loads the new icons..."
  if systemctl --user restart plasma-plasmashell.service 2>/dev/null; then
    ok "plasmashell restarted (icon cache up to date)"
  else
    warn "Couldn't restart plasmashell — run: systemctl --user restart plasma-plasmashell"
  fi
  warn "Apps that were already open keep the old icons: close and reopen them, or log out."
}

# ─── icons ──────────────────────────────────────────────────────────────────
# Papirus copies in ~/.local/share/icons (left by System Settings' "Get
# New…") shadow apt's: Plasma and papirus-folders use the first one they find.
# Removing them is offered; in --all it only warns, because it's ~245 MB of
# user files this script didn't install.
remove_user_papirus() {
  local user_dir="$HOME/.local/share/icons" found=() t
  for t in Papirus Papirus-Dark Papirus-Light; do
    [[ -d "$user_dir/$t" ]] && found+=("$t")
  done
  [[ ${#found[@]} -eq 0 ]] && return 0

  if [[ "$NONINTERACTIVE" == "true" ]]; then
    warn "There's a Papirus copy in $user_dir (${found[*]}) shadowing apt's — run 'dev-plasma --only=icons' to remove it."
    return 0
  fi
  if ! ask_yes_no "There's a Papirus copy in $user_dir\n(${found[*]}, probably from \"Get New…\").\n\nIt shadows the apt version. Delete it?"; then
    warn "User copy kept: it will keep taking precedence over apt's."
    return 0
  fi
  for t in "${found[@]}"; do
    rm -rf -- "${user_dir:?}/$t" && ok "Deleted $user_dir/$t"
  done
  ICONS_CHANGED=true
  warn "System Settings → Icons → Get New… may still list Papirus as installed: don't update it from there."
}

# Installs/updates papirus-folders into ~/.local/bin (it isn't in apt). The
# file is downloaded in full and checked before replacing the previous one
# (never `curl | sh`); the version comes from its `readonly VERSION=` line.
install_papirus_folders() {
  local tmp new cur=""
  tmp="$(mktemp -p "$WORK_DIR" papirus-folders.XXXXXX)" || return 1
  if ! curl -fsSL "$PAPIRUS_FOLDERS_URL" -o "$tmp"; then
    [[ -x "$PAPIRUS_FOLDERS_BIN" ]] && {
      warn "Couldn't download papirus-folders — using the one already installed."
      return 0
    }
    err "Couldn't download papirus-folders"
    return 1
  fi
  new="$(sed -n 's/^readonly VERSION="\(.*\)"/\1/p' "$tmp")"
  if [[ -z "$new" ]] || ! bash -n "$tmp"; then
    err "The downloaded papirus-folders doesn't look valid — not installing it."
    return 1
  fi
  [[ -x "$PAPIRUS_FOLDERS_BIN" ]] && cur="$(sed -n 's/^readonly VERSION="\(.*\)"/\1/p' "$PAPIRUS_FOLDERS_BIN")"
  if [[ "$cur" == "$new" ]]; then
    skip "papirus-folders is already up to date ($new)"
    return 0
  fi
  mkdir -p "$(dirname "$PAPIRUS_FOLDERS_BIN")"
  install -m 755 "$tmp" "$PAPIRUS_FOLDERS_BIN"
  ok "papirus-folders ${cur:-<none>} → $new ($PAPIRUS_FOLDERS_BIN)"
}

install_icons() {
  sep
  remove_user_papirus

  if dpkg -s papirus-icon-theme &>/dev/null; then
    skip "papirus-icon-theme is already installed (apt)"
  else
    info "Installing papirus-icon-theme (apt)..."
    sudo apt-get install -y papirus-icon-theme || {
      err "apt-get install papirus-icon-theme failed"
      return 1
    }
    ok "papirus-icon-theme installed"
    ICONS_CHANGED=true
  fi

  need_cmd curl || return 1
  install_papirus_folders || return 1

  # Dark and Light share Papirus' folders (their places/ are symlinks to
  # ../Papirus), but papirus-folders stores the color per theme for its -R,
  # so both are processed.
  local t cur
  for t in Papirus-Dark Papirus-Light; do
    cur="$(folder_color "$t")" || {
      err "$t isn't installed"
      return 1
    }
    if [[ "$cur" == "$FOLDER_COLOR" ]]; then
      skip "$t already has $FOLDER_COLOR folders"
      continue
    fi
    info "$t: folders $cur → $FOLDER_COLOR (papirus-folders asks for sudo if the theme is system-wide)..."
    "$PAPIRUS_FOLDERS_BIN" -C "$FOLDER_COLOR" -t "$t" || {
      err "papirus-folders failed on $t"
      return 1
    }
    ok "$t: $FOLDER_COLOR folders"
    ICONS_CHANGED=true
  done

  $ICONS_CHANGED && refresh_icon_caches
  return 0
}

# ─── splash ─────────────────────────────────────────────────────────────────
install_splash() {
  sep
  local dst="${LNF_DIRS[0]}/$KURO_ID"
  local state_file="$STATE_DIR/kuro.sha"
  local remote_sha local_sha=""
  remote_sha="$(remote_head_sha "$KURO_REPO")"
  [[ -f "$state_file" ]] && local_sha="$(<"$state_file")"

  if [[ -f "$dst/metadata.json" && -n "$remote_sha" && "$remote_sha" == "$local_sha" ]]; then
    skip "Kuro is already up to date ($remote_sha)"
    return 0
  fi
  if [[ -z "$remote_sha" && -f "$dst/metadata.json" ]]; then
    warn "Can't reach $KURO_REPO — keeping the Kuro already installed."
    return 0
  fi

  need_cmd git || return 1
  local src
  src="$(mktemp -d -p "$WORK_DIR" kuro.XXXXXX)" || return 1
  info "Cloning Kuro..."
  if ! git clone --depth=1 "$KURO_REPO" "$src" &>/dev/null; then
    err "Cloning Kuro failed"
    return 1
  fi
  # The repo ships several variants (a2n.kuro, a2n.kuro.oled...); only the
  # one the Global Themes reference is used.
  [[ -f "$src/$KURO_ID/metadata.json" ]] || {
    err "The Kuro repo no longer ships $KURO_ID/ — check $KURO_REPO"
    return 1
  }

  mkdir -p "${LNF_DIRS[0]}"
  rm -rf -- "$dst"
  cp -r "$src/$KURO_ID" "$dst"
  mkdir -p "$STATE_DIR"
  [[ -n "$remote_sha" ]] && echo "$remote_sha" >"$state_file"
  ok "Kuro installed/updated -> $dst"
}

# ─── sddm-cursor ────────────────────────────────────────────────────────────
install_sddm_cursor() {
  sep
  local cursor src dst
  cursor="$(lnf_default "$THEME_DARK" kcminputrc Mouse cursorTheme)"
  [[ -n "$cursor" ]] || {
    err "$THEME_DARK doesn't define cursorTheme (dev-plasma --only=themes)"
    return 1
  }
  dst="$SYSTEM_ICONS/$cursor"
  src="$(icon_theme_dir "$cursor")" || {
    err "Cursor $cursor isn't installed (is the icons package stowed?)"
    return 1
  }

  if [[ "$src" == "$dst" ]]; then
    skip "$cursor already lives in $SYSTEM_ICONS"
  elif diff -rq "$src/" "$dst/" &>/dev/null; then
    skip "$cursor is already copied to $dst"
  else
    # cp -L: ~/.icons is a symlink into the repo; /usr/share gets the content.
    info "Copying $cursor to $dst (sudo)..."
    if ! { sudo rm -rf -- "$dst" && sudo cp -rL "$src" "$dst" && sudo chmod -R a+rX "$dst"; }; then
      err "Couldn't copy $cursor to $dst"
      return 1
    fi
    ok "$cursor copied to $dst"
  fi

  # SDDM's KCM writes kde_settings.conf; our own drop-in is named
  # dev-plasma.conf so it sorts BEFORE it ("d" < "k") and a change made from
  # System Settings still wins. It's only written if nobody set it.
  local current
  current="$(sddm_value CursorTheme)"
  if [[ "$current" == "$cursor" ]]; then
    skip "SDDM already uses CursorTheme=$cursor"
    return 0
  fi
  if [[ -n "$current" ]]; then
    warn "SDDM uses CursorTheme=$current (set by hand) — not changing it."
    return 0
  fi
  info "Setting CursorTheme=$cursor in $SDDM_DROPIN (sudo)..."
  # A fresh install has no /etc/sddm.conf.d until System Settings writes to it.
  { sudo mkdir -p -- "$(dirname "$SDDM_DROPIN")" \
    && printf '[Theme]\nCursorTheme=%s\n' "$cursor" | sudo tee "$SDDM_DROPIN" >/dev/null; } || {
    err "Couldn't write $SDDM_DROPIN"
    return 1
  }
  ok "SDDM will use $cursor from the next login"
}

# Effective value of a [Theme] key in SDDM's config: drop-ins are read in
# alphabetical order and /etc/sddm.conf last; the last one wins.
sddm_value() {
  local f files=() val=""
  for f in /etc/sddm.conf.d/*.conf /etc/sddm.conf; do
    [[ -f "$f" ]] && files+=("$f")
  done
  [[ ${#files[@]} -eq 0 ]] && return 0
  for f in "${files[@]}"; do
    local v
    v="$(awk -v key="$1" '/^\[/ { t = ($0 == "[Theme]"); next } t && index($0, key "=") == 1 { print substr($0, length(key) + 2) }' "$f" | tail -1)"
    [[ -n "$v" ]] && val="$v"
  done
  echo "$val"
}

# ─── apply ──────────────────────────────────────────────────────────────────
# Is the system in light mode? It looks at the active scheme's window
# background (not the theme name, which could be anything).
is_light_mode() {
  local rgb r g b
  rgb="$(kreadconfig6 --file kdeglobals --group Colors:Window --key BackgroundNormal 2>/dev/null)"
  IFS=, read -r r g b <<<"$rgb"
  [[ -n "$b" ]] || return 1
  ((r * 299 + g * 587 + b * 114 > 128000))
}

# Registers the pair (the themes "Switch to Dark Mode at Night" would use),
# but the toggle itself is the user's decision: it isn't touched.
link_pair() {
  kwriteconfig6 --file kdeglobals --group KDE --key DefaultDarkLookAndFeel "$THEME_DARK"
  kwriteconfig6 --file kdeglobals --group KDE --key DefaultLightLookAndFeel "$THEME_LIGHT"
  ok "Pair registered: light=$THEME_LIGHT dark=$THEME_DARK"
}

apply_theme() {
  sep
  need_cmd plasma-apply-lookandfeel plasma-workspace || return 1
  need_cmd kwriteconfig6 || return 1
  local t
  for t in "$THEME_DARK" "$THEME_LIGHT"; do
    lnf_dir "$t" >/dev/null || {
      err "Global Theme $t isn't installed (dev-plasma --only=themes)"
      return 1
    }
  done

  if ! has_session; then
    link_pair
    skip "No graphical session — the theme applies on the next Plasma login"
    return 0
  fi

  local target="$THEME_DARK" current
  is_light_mode && target="$THEME_LIGHT"
  current="$(kreadconfig6 --file kdeglobals --group KDE --key LookAndFeelPackage 2>/dev/null)"
  if [[ "$current" == "$target" ]]; then
    skip "$target is already applied"
    link_pair
    return 0
  fi

  local automatic
  # plasma-apply-lookandfeel -a clears AutomaticLookAndFeel (picking a theme by
  # hand turns automatic mode off). It's saved before and restored after to
  # leave the toggle exactly as it was.
  automatic="$(kreadconfig6 --file kdeglobals --group KDE --key AutomaticLookAndFeel 2>/dev/null)"
  info "Applying $target..."
  plasma-apply-lookandfeel -a "$target" || {
    err "plasma-apply-lookandfeel failed"
    return 1
  }
  [[ -n "$automatic" ]] \
    && kwriteconfig6 --file kdeglobals --group KDE --key AutomaticLookAndFeel "$automatic"
  ok "$target applied"
  link_pair
}

# ─── wallpaper ──────────────────────────────────────────────────────────────
apply_wallpaper() {
  sep
  local pkg="$HOME/.local/share/wallpapers/$WALLPAPER"
  [[ -f "$pkg/metadata.json" ]] || {
    err "$WALLPAPER isn't in $pkg (dev-plasma --only=themes)"
    return 1
  }
  if ! has_session; then
    skip "No graphical session — can't change the wallpaper"
    return 0
  fi
  need_cmd plasma-apply-wallpaperimage plasma-workspace || return 1

  # Current wallpapers of every desktop (one per screen/activity).
  local appletsrc="$HOME/.config/plasma-org.kde.plasma.desktop-appletsrc"
  local images=() img custom=false
  [[ -f "$appletsrc" ]] && mapfile -t images < <(sed -n 's/^Image=//p' "$appletsrc")
  for img in "${images[@]}"; do
    [[ "$img" == *"/wallpapers/$WALLPAPER"* ]] && continue
    [[ -z "$img" || "$img" == *"/usr/share/wallpapers/"* ]] && continue
    custom=true
  done
  if [[ ${#images[@]} -gt 0 ]] && ! $custom && [[ "${images[*]}" == *"/wallpapers/$WALLPAPER"* ]]; then
    skip "$WALLPAPER is already your wallpaper"
    return 0
  fi
  if $custom && [[ "$EXPLICIT" == false ]]; then
    skip "You have a hand-picked wallpaper — keeping it (dev-plasma --only=wallpaper to change it)"
    return 0
  fi

  plasma-apply-wallpaperimage "$pkg" &>/dev/null || {
    err "plasma-apply-wallpaperimage failed"
    return 1
  }
  ok "Wallpaper: $WALLPAPER (switches between light/dark on its own)"
}

# ─── launcher-icon ──────────────────────────────────────────────────────────
# Changes only the General/icon key of every launcher (Kickoff, Kicker, Kicker
# Dash) on every panel, through plasmashell scripting over DBus: the rest of
# the panel (pinned apps, widgets, position) isn't touched. The script prints
# "changed same custom"; a custom icon (not empty, not start-here-*, not ours)
# is only replaced if the key was picked by hand.
set_launcher_icon() {
  sep
  [[ -f "$HOME/.local/share/icons/hicolor/scalable/apps/$LAUNCHER_ICON.svg" ]] || {
    err "$LAUNCHER_ICON isn't installed (dev-plasma --only=themes)"
    return 1
  }
  if ! has_session; then
    skip "No graphical session — can't change the launcher icon"
    return 0
  fi
  need_cmd qdbus6 qdbus-qt6 || return 1

  local force=false
  [[ "$EXPLICIT" == true ]] && force=true
  local script out
  script="var icon = '$LAUNCHER_ICON', force = $force, changed = 0, same = 0, custom = 0;
var launchers = ['org.kde.plasma.kickoff', 'org.kde.plasma.kicker', 'org.kde.plasma.kickerdash'];
panels().forEach(function (p) {
  p.widgets().forEach(function (w) {
    if (launchers.indexOf(w.type) < 0) return;
    w.currentConfigGroup = ['General'];
    var cur = String(w.readConfig('icon', ''));
    if (cur === icon) { same++; return; }
    if (cur !== '' && cur.indexOf('start-here') !== 0 && !force) { custom++; return; }
    w.writeConfig('icon', icon);
    w.reloadConfig();
    changed++;
  });
});
print(changed + ' ' + same + ' ' + custom);"
  out="$(qdbus6 org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript "$script" 2>&1)" || {
    err "plasmashell rejected the script: $out"
    return 1
  }
  local changed same custom
  read -r changed same custom <<<"$out"
  if [[ "${changed:-0}" -gt 0 ]]; then
    ok "$LAUNCHER_ICON icon on $changed launcher(s); the rest of the panel is unchanged"
    # An icon freshly copied into hicolor shows as "?" until plasmashell
    # restarts (kiconfinder6 does find it). Only happens when it changes.
    refresh_icon_caches
  elif [[ "${custom:-0}" -gt 0 ]]; then
    skip "The launcher has a hand-picked icon — keeping it (dev-plasma --only=launcher-icon to change it)"
  elif [[ "${same:-0}" -gt 0 ]]; then
    skip "The launcher already uses $LAUNCHER_ICON"
  else
    skip "There's no launcher (Kickoff/Kicker) on your panels"
  fi
}

# ─── yakuake ────────────────────────────────────────────────────────────────
# "group<TAB>key<TAB>value" for every key in the repo's yakuakerc.
yakuake_keys() {
  awk '
    /^[[:space:]]*(#|$)/ { next }
    /^\[/ { group = substr($0, 2, length($0) - 2); next }
    { i = index($0, "="); printf "%s\t%s\t%s\n", group, substr($0, 1, i - 1), substr($0, i + 1) }
  ' "$YAKUAKE_RC_SRC"
}

# The repo keys whose value in ~/.config/yakuakerc differs:
# "group<TAB>key<TAB>wanted<TAB>current".
yakuake_drift() {
  local group key want cur
  while IFS=$'\t' read -r group key want; do
    cur="$(kreadconfig6 --file yakuakerc --group "$group" --key "$key" 2>/dev/null)"
    [[ "$cur" == "$want" ]] || printf '%s\t%s\t%s\t%s\n' "$group" "$key" "$want" "$cur"
  done < <(yakuake_keys)
}

# rc files (yakuakerc / konsolerc) whose DefaultProfile names a profile that
# doesn't exist (e.g. one renamed in the repo): Konsole/Yakuake would open
# with the stock profile until the theme-sync service runs again.
broken_default_profiles() {
  local rc cur
  for rc in yakuakerc konsolerc; do
    cur="$(kreadconfig6 --file "$rc" --group "Desktop Entry" --key DefaultProfile 2>/dev/null)"
    [[ -n "$cur" && ! -f "$KONSOLE_DIR/$cur" ]] && echo "$rc"
  done
}

yakuake_running() {
  pgrep -u "$USER" -x yakuake &>/dev/null
}

# Yakuake writes its whole in-memory config back to yakuakerc when it quits,
# so keys written while it runs would be undone on its next exit. It's
# quit first (asking: its open tabs close), then started again.
quit_yakuake() {
  kquitapp6 yakuake &>/dev/null
  local tries=10
  while ((tries-- > 0)); do
    yakuake_running || return 0
    sleep 0.5
  done
  return 1
}

configure_yakuake() {
  sep
  [[ -f "$YAKUAKE_RC_SRC" ]] || {
    err "Can't find $YAKUAKE_RC_SRC"
    return 1
  }
  need_cmd kwriteconfig6 || return 1
  command -v yakuake &>/dev/null \
    || warn "Yakuake isn't installed (sudo apt install yakuake) — writing its settings anyway"

  # Links left behind by profiles/color schemes renamed in the repo: stow
  # only knows the package's current files, so it never removes these.
  local f
  for f in "$KONSOLE_DIR"/*; do
    [[ -L "$f" && ! -e "$f" && "$(readlink "$f")" == */konsole/.local/share/konsole/* ]] || continue
    rm -f -- "$f" && ok "Removed stale link $(basename "$f") (renamed in the repo)"
  done

  local p missing=()
  for p in "$KONSOLE_DARK" "$KONSOLE_LIGHT"; do
    [[ -f "$KONSOLE_DIR/$p.profile" ]] || missing+=("$p.profile")
  done
  if [[ ${#missing[@]} -gt 0 ]]; then
    err "${missing[*]} missing in $KONSOLE_DIR — stow the konsole package first (bootstrap option 4)"
    return 1
  fi

  local drift broken
  drift="$(yakuake_drift)"
  broken="$(broken_default_profiles)"
  if [[ -z "$drift" && -z "$broken" ]]; then
    skip "Yakuake settings are already up to date"
  else
    local restart=false
    if yakuake_running; then
      if [[ "$NONINTERACTIVE" == "true" ]]; then
        warn "Yakuake is running and would write its old settings back on exit — close it and run: dev-plasma --only=yakuake"
        return 0
      fi
      if ! ask_yes_no "Yakuake is running: it writes its own settings back when it quits, which would undo these.\n\nQuit Yakuake now and start it again? Its open tabs will close."; then
        warn "Yakuake settings not changed (close it and run: dev-plasma --only=yakuake)"
        return 0
      fi
      quit_yakuake || {
        err "Yakuake didn't quit — close it by hand and run dev-plasma --only=yakuake again"
        return 1
      }
      ok "Yakuake closed"
      restart=true
    fi

    local group key want cur
    while IFS=$'\t' read -r group key want cur; do
      [[ -n "$group" ]] || continue
      kwriteconfig6 --file yakuakerc --group "$group" --key "$key" "$want"
      ok "yakuakerc [$group] $key: ${cur:-<unset>} → $want"
    done <<<"$drift"

    # The profile for the current mode; the theme-sync service keeps it right
    # from then on.
    local profile="$KONSOLE_DARK.profile" rc
    is_light_mode && profile="$KONSOLE_LIGHT.profile"
    while IFS= read -r rc; do
      [[ -n "$rc" ]] || continue
      kwriteconfig6 --file "$rc" --group "Desktop Entry" --key DefaultProfile "$profile"
      ok "$rc: DefaultProfile → $profile (the previous one no longer exists)"
    done <<<"$broken"

    if $restart && has_session; then
      setsid -f yakuake &>/dev/null
      ok "Yakuake started again"
    fi
  fi

  if command -v systemctl &>/dev/null && ! systemctl --user is-active -q "$TERM_SYNC_UNIT" 2>/dev/null; then
    warn "$TERM_SYNC_UNIT isn't running: Konsole/Yakuake won't follow the light/dark mode (dev-services --install=konsole-theme-sync)"
  fi
  return 0
}

# ─── doctor ─────────────────────────────────────────────────────────────────
# Checks that every piece the Global Themes name really exists. Changes
# nothing. Returns 1 if something is broken (not for warnings).
DOC_FAIL=0
doc_ok() { ok "$*"; }
doc_warn() { warn "$*"; }
doc_fail() {
  err "$*"
  DOC_FAIL=1
}

doctor_theme() {
  local id="$1" dir v f
  dir="$(lnf_dir "$id")" || {
    doc_fail "$id: Global Theme not installed (dev-plasma --only=themes)"
    return
  }
  doc_ok "$id: $dir"
  if v="$(kpackage_escape "$dir")"; then
    doc_fail "  KPackage  $v is outside the package: Plasma ignores the theme and applies Breeze (dev-plasma --only=themes)"
  fi
  if [[ -d "$SRC_DIR/look-and-feel/$id" ]] && ! same_tree "$SRC_DIR/look-and-feel/$id" "$dir"; then
    doc_warn "  repo      the installed copy differs from $SRC_DIR/look-and-feel/$id (dev-plasma --only=themes)"
  fi

  v="$(lnf_default "$id" kdeglobals General ColorScheme)"
  if f="$(scheme_file "$v")"; then
    doc_ok "  colors    $v ($f)"
    if [[ -f "$SRC_DIR/color-schemes/$(basename "$f")" ]] && ! same_tree "$SRC_DIR/color-schemes/$(basename "$f")" "$f"; then
      doc_warn "            differs from the repo (dev-plasma --only=themes)"
    fi
  else
    doc_fail "  colors    $v — no .colors file has that id"
  fi

  v="$(lnf_default "$id" kdeglobals Icons Theme)"
  if [[ -n "$v" ]]; then
    if f="$(icon_theme_dir "$v")"; then
      doc_ok "  icons     $v ($f)"
      if [[ "$v" == Papirus* ]]; then
        local color
        color="$(folder_color "$v")"
        if [[ "$color" == "$FOLDER_COLOR" ]]; then
          doc_ok "            $color folders"
        else
          doc_warn "            ${color:-?} folders, expected $FOLDER_COLOR (dev-plasma --only=icons)"
        fi
        if [[ "$f" == "$HOME"/* ]]; then
          doc_warn "            the user copy is used, not apt's (dev-plasma --only=icons)"
        fi
      fi
    else
      doc_fail "  icons     $v — not installed (dev-plasma --only=icons)"
    fi
  fi

  v="$(lnf_default "$id" kcminputrc Mouse cursorTheme)"
  if [[ -n "$v" ]]; then
    if f="$(icon_theme_dir "$v")"; then
      doc_ok "  cursor    $v ($f)"
    else
      doc_fail "  cursor    $v — not installed (the dotfiles' icons package)"
    fi
  fi

  v="$(lnf_default "$id" ksplashrc KSplash Theme)"
  if [[ -n "$v" ]]; then
    if f="$(lnf_dir "$v")"; then
      doc_ok "  splash    $v ($f)"
    else
      doc_fail "  splash    $v — not installed (dev-plasma --only=splash)"
    fi
  fi
}

doctor_terminal() {
  local p rc
  for p in "$KONSOLE_DARK" "$KONSOLE_LIGHT"; do
    if [[ -f "$KONSOLE_DIR/$p.profile" ]]; then
      doc_ok "Konsole profile $p"
    else
      doc_warn "Konsole profile $p missing in $KONSOLE_DIR (stow the konsole package)"
    fi
  done
  while IFS= read -r rc; do
    [[ -n "$rc" ]] && doc_warn "$rc: DefaultProfile names a profile that doesn't exist (dev-plasma --only=yakuake)"
  done < <(broken_default_profiles)

  if ! command -v yakuake &>/dev/null; then
    doc_warn "Yakuake isn't installed (sudo apt install yakuake)"
  elif [[ -f "$YAKUAKE_RC_SRC" ]]; then
    local drift group key want cur
    drift="$(yakuake_drift)"
    if [[ -z "$drift" ]]; then
      doc_ok "Yakuake settings match the repo"
    else
      doc_warn "Yakuake settings differ from the repo (dev-plasma --only=yakuake):"
      while IFS=$'\t' read -r group key want cur; do
        doc_warn "  [$group] $key=${cur:-<unset>}, expected $want"
      done <<<"$drift"
    fi
  fi

  if command -v systemctl &>/dev/null; then
    if systemctl --user is-active -q "$TERM_SYNC_UNIT" 2>/dev/null; then
      doc_ok "$TERM_SYNC_UNIT active (Konsole/Yakuake follow the light/dark mode)"
    else
      doc_warn "$TERM_SYNC_UNIT isn't running (dev-services --install=konsole-theme-sync)"
    fi
  fi
}

run_doctor() {
  sep
  info "Doctor: $THEME_DARK / $THEME_LIGHT"
  DOC_FAIL=0
  doctor_theme "$THEME_DARK"
  doctor_theme "$THEME_LIGHT"

  local v
  if [[ -f "$HOME/.local/share/icons/hicolor/scalable/apps/$LAUNCHER_ICON.svg" ]]; then
    doc_ok "icon $LAUNCHER_ICON"
  else
    doc_warn "icon $LAUNCHER_ICON not installed (dev-plasma --only=themes)"
  fi
  if [[ -f "$HOME/.local/share/wallpapers/$WALLPAPER/metadata.json" ]]; then
    if v="$(kpackage_escape "$HOME/.local/share/wallpapers/$WALLPAPER")"; then
      doc_fail "wallpaper $WALLPAPER: $v is outside the package (dev-plasma --only=themes)"
    elif ! same_tree "$SRC_DIR/wallpapers/$WALLPAPER" "$HOME/.local/share/wallpapers/$WALLPAPER"; then
      doc_warn "wallpaper $WALLPAPER differs from the repo (dev-plasma --only=themes)"
    else
      doc_ok "wallpaper $WALLPAPER"
    fi
  else
    doc_fail "wallpaper $WALLPAPER is missing (dev-plasma --only=themes)"
  fi

  v="$(sddm_value CursorTheme)"
  if [[ -z "$v" ]]; then
    doc_warn "SDDM has no CursorTheme (dev-plasma --only=sddm-cursor)"
  elif [[ -f "$SYSTEM_ICONS/$v/index.theme" ]]; then
    doc_ok "SDDM cursor $v ($SYSTEM_ICONS/$v)"
  else
    doc_warn "SDDM asks for CursorTheme=$v but it isn't in $SYSTEM_ICONS: the login uses the stock one (dev-plasma --only=sddm-cursor)"
  fi

  local dark light auto
  dark="$(kreadconfig6 --file kdeglobals --group KDE --key DefaultDarkLookAndFeel 2>/dev/null)"
  light="$(kreadconfig6 --file kdeglobals --group KDE --key DefaultLightLookAndFeel 2>/dev/null)"
  auto="$(kreadconfig6 --file kdeglobals --group KDE --key AutomaticLookAndFeel 2>/dev/null)"
  if [[ "$dark" == "$THEME_DARK" && "$light" == "$THEME_LIGHT" ]]; then
    doc_ok "light/dark pair registered (Switch to Dark Mode at Night: ${auto:-false})"
  else
    doc_warn "current pair: light=${light:-?} dark=${dark:-?} (dev-plasma --only=apply)"
  fi

  doctor_terminal

  sep
  if [[ $DOC_FAIL -eq 0 ]]; then
    ok "Doctor: everything the themes reference exists"
  else
    err "Doctor: there are broken references — Plasma silently ignores them"
  fi
  return "$DOC_FAIL"
}

# ─── checklist ──────────────────────────────────────────────────────────────
select_keys() {
  local -n _out="$1"
  _out=()
  local items=() key
  for key in "${PKG_KEYS[@]}"; do
    items+=("$key" "${PKG_LABEL[$key]}" "on")
  done
  local raw
  raw=$(dialog --clear --colors --backtitle "$BACKTITLE" \
    --title " dev-plasma " --separate-output --checklist \
    "Select what to install/apply  [SPACE=toggle  ENTER=confirm]\n\nThe doctor runs at the end and checks nothing is left broken." \
    18 76 8 "${items[@]}" \
    3>&1 1>&2 2>&3) || return 1
  clear
  local line
  while IFS= read -r line; do [[ -n "$line" ]] && _out+=("$line"); done <<<"$raw"
}

# ─── help ───────────────────────────────────────────────────────────────────
usage() {
  sed -n '/^# Usage:/,/^[^#]/{/^#/s/^# \{0,1\}//p}' "$0"
  printf '\nKeys: %s\n' "${PKG_KEYS[*]}"
}

# ─── arg parsing ────────────────────────────────────────────────────────────
ONLY_KEYS=()
DOCTOR_ONLY=false
for arg in "$@"; do
  case "$arg" in
    --all) NONINTERACTIVE=true ;;
    --only=*) IFS=',' read -ra ONLY_KEYS <<<"${arg#--only=}" ;;
    --doctor) DOCTOR_ONLY=true ;;
    --dark=*) THEME_DARK="${arg#--dark=}" ;;
    --light=*) THEME_LIGHT="${arg#--light=}" ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      err "Unknown argument: $arg"
      usage >&2
      exit 1
      ;;
  esac
done

if ! command -v plasmashell &>/dev/null; then
  skip "KDE Plasma isn't installed — nothing to do"
  exit 0
fi

if $DOCTOR_ONLY; then
  run_doctor
  exit $?
fi

# ─── work dir + cleanup ─────────────────────────────────────────────────────
WORK_DIR="$(mktemp -d -t dev-plasma.XXXXXX)" || {
  err "Couldn't create the work directory"
  exit 1
}
trap 'rm -rf "$WORK_DIR"' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

# ─── key selection ──────────────────────────────────────────────────────────
CHOSEN=()
if [[ ${#ONLY_KEYS[@]} -gt 0 ]]; then
  CHOSEN=("${ONLY_KEYS[@]}")
elif [[ "$NONINTERACTIVE" == "true" ]] || ! [ -t 0 ]; then
  NONINTERACTIVE=true
  EXPLICIT=false
  info "Non-interactive mode — every key (${PKG_KEYS[*]})"
  CHOSEN=("${PKG_KEYS[@]}")
else
  need_cmd dialog || exit 1
  if ! select_keys CHOSEN; then
    warn "dev-plasma cancelled."
    exit 0
  fi
fi

if [[ ${#CHOSEN[@]} -eq 0 ]]; then
  skip "Nothing selected."
  exit 0
fi

for key in "${CHOSEN[@]}"; do
  [[ -n "${PKG_FN[$key]:-}" ]] || {
    err "Unknown key: $key"
    usage >&2
    exit 1
  }
done

# ─── run (in PKG_KEYS order) + doctor ───────────────────────────────────────
succeeded=0
failed=()
for key in "${PKG_KEYS[@]}"; do
  [[ " ${CHOSEN[*]} " == *" $key "* ]] || continue
  if "${PKG_FN[$key]}"; then
    ((succeeded++)) || true
  else
    warn "Failed: ${PKG_LABEL[$key]}"
    failed+=("$key")
  fi
done

run_doctor
doctor_rc=$?

sep
ok "Done — ok: $succeeded  failed: ${#failed[@]}"
if [[ ${#failed[@]} -gt 0 ]]; then
  warn "Failed: ${failed[*]}"
  exit 1
fi
exit "$doctor_rc"
