#!/usr/bin/env bash
# dev-boot — installs the dotfiles' boot themes: the GRUB theme "nord" (with
# the icon set of your choice) and a Plymouth animation (cuts_alt by default,
# or any of the 80 in the upstream repo). What lives in the repo's boot/ are
# GPLv3 copies of their upstreams (see boot/README.md). Standalone, like
# dev-plasma: it doesn't depend on bootstrap.d/*.sh or $DOTFILES_DIR (boot/ is
# located from this script's own real path).
#
# Everything here is system-wide (root) and touches the boot process, so every
# step is conservative:
#   - grub     -> assembles the theme (nord + the chosen icon set) in a temp
#                 dir, copies it to /boot/grub/themes/nord and writes ONLY
#                 /etc/default/grub.d/dev-boot.cfg (GRUB_THEME + GRUB_GFXMODE).
#                 /etc/default/grub is never touched: it holds per-machine
#                 settings (e.g. hid_apple.fnmode=2 on the kernel command
#                 line). grub-mkconfig reads grub.d/*.cfg AFTER
#                 /etc/default/grub, so the drop-in wins. update-grub only runs
#                 when something changed; if it fails the previous drop-in is
#                 restored (grub-mkconfig validates grub.cfg.new before
#                 replacing the real one, so the bootable grub.cfg is never
#                 lost). The chosen icon set is recorded in .dev-boot-icons
#                 inside the theme (no file = white).
#   - plymouth -> installs the chosen theme into /usr/share/plymouth/themes and
#                 keeps consistent the layers that pick the theme on Debian:
#                   1. /etc/plymouth/plymouthd.conf  Theme=   (the one that wins)
#                   2. /usr/share/plymouth/plymouthd.defaults (owned by the
#                      package; desktop-base overwrites it on every upgrade:
#                      left alone)
#                   3. the default.plymouth alternative (fallback; priority 100)
#                 Only the Theme= line of layer 1 is changed (backed up first).
#                 plymouth-set-default-theme isn't used: it edits with
#                 `sed -ie` and leaves a stray "plymouthd.confe". The theme
#                 lives INSIDE the initramfs, so update-initramfs runs when
#                 something changed or the initramfs lacks it (it's atomic:
#                 it builds .new and only swaps it in if mkinitramfs
#                 succeeded). Free space is checked first. The choice isn't
#                 stored anywhere else: it's layer 1's Theme=.
#
# Plymouth themes: the ones in boot/plymouth/themes (just cuts_alt today) and
# the 80 in adi1090x/plymouth-themes, pinned to PLY_UPSTREAM_COMMIT. From that
# repo ONLY the chosen theme's folder is downloaded (sparse git, not the
# ~270 MB) and installed on this machine, without adding it to the dotfiles.
# Before installing it is validated: name in upstream's list, no symlinks or
# special files, ModuleName=script with ImageDir/ScriptFile pointing to its own
# folder, and it never overwrites a theme owned by a Debian package. It's
# marked with .dev-boot-source (repo, commit, path) to recognize it later.
#
# Neither key edits the kernel command line: if "splash" is missing (Plymouth
# doesn't show without it) they only warn. Without GRUB or Plymouth (VMs,
# Termux, servers) the key is skipped. Idempotent: when there's nothing to
# change it doesn't ask for sudo. Without --plymouth/--grub-icons whatever is
# already set is kept (if it's a theme dev-boot knows; otherwise cuts_alt and
# white icons).
#
# Usage:
#   dev-boot                       interactive menu (dialog)
#   dev-boot --all                 every key, no dialogs
#   dev-boot --only=a,b            only those keys, no dialogs
#   dev-boot --plymouth=NAME       pick the animation (from boot/ or upstream)
#   dev-boot --grub-icons=SET      GRUB icon set: white | color | whitesur
#   dev-boot --list-plymouth       list the available Plymouth themes
#   dev-boot --dry-run             show what it would do, change nothing
#   dev-boot --doctor              check only (installs/changes nothing)
#   dev-boot -h | --help           this help
set -uo pipefail

# ─── helpers (same style as bootstrap.d/00-core.sh) ──────────────────────────
RED='\e[38;2;191;97;106m'
GRN='\e[38;2;163;190;140m'
YLW='\e[38;2;235;203;139m'
BLU='\e[38;2;136;192;208m'
CYN='\e[38;2;143;188;187m'
DIM='\e[38;2;94;129;172m'
# shellcheck disable=SC2034 # Nord palette shared across scripts; unused here
BLD='\e[1m'
RST='\e[0m'

info() { printf "${BLU}[INFO]${RST}  %s\n" "$*"; }
ok() { printf "${GRN}[OK]${RST}    %s\n" "$*"; }
err() { printf "${RED}[ERR]${RST}   %s\n" "$*" >&2; }
warn() { printf "${YLW}[WARN]${RST}  %s\n" "$*"; }
skip() { printf "${CYN}[SKIP]${RST}  %s\n" "$*"; }
sep() { printf "${DIM}%s${RST}\n" "  ──────────────────────────────────────────────────"; }

NONINTERACTIVE="${NONINTERACTIVE:-false}"
BACKTITLE="${DEV_BOOT_BACKTITLE:-dev-boot · $(hostname) · $(date '+%Y-%m-%d %H:%M')}"
DRY_RUN=false
MENU_MODE=false # in the menu, update-grub/update-initramfs output goes to a dialog box

# The repo's boot/, from the script's real path (bin/.local/bin/dev-boot,
# stowed per-file into ~/.local/bin). DEV_BOOT_SRC overrides it.
SRC_DIR="${DEV_BOOT_SRC:-$(cd "$(dirname "$(readlink -f "$0")")/../../.." && pwd)/boot}"

GRUB_THEME_NAME="nord"
GRUB_THEMES_DIR="/boot/grub/themes"
GRUB_GFXMODE_WANT="1920x1080,auto" # other resolutions fall back to "auto"
GRUB_DROPIN="/etc/default/grub.d/dev-boot.cfg"
# white is the set shipped in boot/grub/themes/nord/icons; the others live in
# boot/grub/icons/<set> and are laid on top when assembling the theme.
GRUB_ICON_VARIANTS=(white color whitesur)
declare -A GRUB_ICON_LABEL=(
  [white]="white, monochrome (the default)"
  [color]="color, round logo per OS"
  [whitesur]="color, square logo (WhiteSur style)"
)
GRUB_ICONS_MARK=".dev-boot-icons"
GRUB_ICONS="" # chosen; empty = whatever is installed (grub_resolve_icons)

PLY_DEFAULT="cuts_alt"
PLY_THEMES_DIR="/usr/share/plymouth/themes"
PLY_CONF="/etc/plymouth/plymouthd.conf"
PLY_DEFAULTS="/usr/share/plymouth/plymouthd.defaults"
PLY_ALT_LINK="$PLY_THEMES_DIR/default.plymouth"
PLY_UPSTREAM_URL="https://github.com/adi1090x/plymouth-themes"
PLY_UPSTREAM_COMMIT="5d8817458d764bff4ff9daae94cf1bbaabf16ede" # 2023-08-22, same as boot/README.md
PLY_UPSTREAM_MAX_MB=50                                         # the largest one is ~20 MB
PLY_MARK=".dev-boot-source"
PLY_THEME="" # chosen; empty = whatever is set (ply_resolve_theme)

# ─── registry ───────────────────────────────────────────────────────────────
PKG_KEYS=(grub plymouth)
declare -A PKG_LABEL=(
  [grub]="GRUB theme $GRUB_THEME_NAME (grub.d drop-in, sudo)"
  [plymouth]="Plymouth animation (+ initramfs, sudo)"
)
declare -A PKG_FN=(
  [grub]="install_grub"
  [plymouth]="install_plymouth"
)

# ─── utilities ──────────────────────────────────────────────────────────────

# Everything that needs root goes through here: in --dry-run it's only shown.
run_root() {
  if $DRY_RUN; then
    info "[dry-run] sudo $*"
    return 0
  fi
  sudo "$@"
}

# Like run_root, for the long commands (update-grub, update-initramfs): in the
# menu their output goes to a dialog box instead of flooding the screen.
# sudo -v runs first and outside the box, because the password prompt
# wouldn't be visible inside it.
run_root_box() {
  local title="$1"
  shift
  if $DRY_RUN || ! $MENU_MODE; then
    run_root "$@"
    return
  fi
  sudo -v || return 1
  local rc_file="$WORK_DIR/box.rc"
  {
    sudo "$@" 2>&1
    echo $? >"$rc_file"
  } | dialog --backtitle "$BACKTITLE" --title " $title " --programbox 22 90
  return "$(cat "$rc_file" 2>/dev/null || echo 1)"
}

# Is $2 (installed) a faithful copy of $1 (repo)? Compares content, not
# permissions or owner (install_tree sets those).
same_tree() {
  [[ -d "$2" && ! -L "$2" ]] || return 1
  diff -rq "$1" "$2" &>/dev/null
}

# Installs folder $1 as $2 (root:root, 644/755) only if it differs. Atomic:
# copies to $2.dev-boot-new and then swaps, so a theme is never left
# half-written if something gets interrupted. Sets TREE_CHANGED=true/false.
TREE_CHANGED=false
install_tree() {
  local src="$1" dst="$2" name
  name="$(basename "$dst")"
  TREE_CHANGED=false
  if same_tree "$src" "$dst"; then
    skip "$name is already up to date in $dst"
    return 0
  fi
  local new="${dst:?}.dev-boot-new" old="${dst:?}.dev-boot-old"
  info "Installing $name to $dst..."
  if ! { run_root rm -rf -- "$new" "$old" \
    && run_root cp -r -- "$src" "$new" \
    && run_root chown -R root:root "$new" \
    && run_root chmod -R u=rwX,go=rX "$new"; }; then
    err "Couldn't prepare $new"
    run_root rm -rf -- "$new"
    return 1
  fi
  if [[ -e "$dst" ]]; then
    run_root mv -- "$dst" "$old" || {
      err "Couldn't move the previous $name aside"
      return 1
    }
  fi
  run_root mv -- "$new" "$dst" || {
    err "Couldn't install $dst — restoring the previous one"
    [[ -e "$old" ]] && run_root mv -- "$old" "$dst"
    return 1
  }
  run_root rm -rf -- "$old"
  TREE_CHANGED=true
  ok "$name installed to $dst"
}

# Writes system file $2 with the contents of temp file $1 (root, 644) if it
# differs. If it already existed, it's backed up as $2.dev-boot.bak (the
# previous backup is overwritten: it's always the state before the last
# change).
FILE_CHANGED=false
write_root_file() {
  local tmp="$1" dst="$2"
  FILE_CHANGED=false
  if [[ -f "$dst" ]] && cmp -s "$tmp" "$dst"; then
    skip "$dst is already up to date"
    return 0
  fi
  info "Writing $dst"
  run_root mkdir -p -- "$(dirname "$dst")" || return 1
  if [[ -f "$dst" ]]; then
    run_root cp -p -- "$dst" "$dst.dev-boot.bak" || {
      err "Couldn't back up $dst"
      return 1
    }
    info "Backup: $dst.dev-boot.bak"
  fi
  run_root install -m 644 -o root -g root -- "$tmp" "$dst" || {
    err "Couldn't write $dst"
    return 1
  }
  FILE_CHANGED=true
  ok "$dst written"
}

# Undoes write_root_file: goes back to the backup, or removes the file if it
# didn't exist before this run.
restore_root_file() {
  local dst="$1" existed="$2"
  if [[ "$existed" == true && -f "$dst.dev-boot.bak" ]]; then
    run_root cp -p -- "$dst.dev-boot.bak" "$dst" && warn "Restored $dst from its backup"
  else
    run_root rm -f -- "$dst" && warn "Removed $dst (it didn't exist before)"
  fi
}

# Effective GRUB config values, read the same way grub-mkconfig does:
# /etc/default/grub and then /etc/default/grub.d/*.cfg (last one wins), in a
# clean bash so nothing leaks in from this script. Prints 3 lines: theme,
# gfxmode and the kernel command line.
grub_effective() {
  # shellcheck disable=SC2016 # expanded by the clean bash, not here
  env -i PATH=/usr/sbin:/usr/bin:/sbin:/bin bash -c '
    [ -f /etc/default/grub ] && . /etc/default/grub
    for f in /etc/default/grub.d/*.cfg; do [ -e "$f" ] && . "$f"; done
    printf "%s\n%s\n%s\n" "${GRUB_THEME:-}" "${GRUB_GFXMODE:-}" \
      "${GRUB_CMDLINE_LINUX_DEFAULT:-} ${GRUB_CMDLINE_LINUX:-}"
  ' 2>/dev/null
}

have_grub() { command -v update-grub &>/dev/null && [[ -d /boot/grub ]]; }
have_plymouth() { [[ -d "$PLY_THEMES_DIR" ]] && command -v plymouth &>/dev/null; }

# ─── grub: icon set ─────────────────────────────────────────────────────────

# Icon set of the installed theme (the mark grub_stage leaves; no mark =
# white, the one the theme ships with).
grub_installed_icons() {
  local v
  v="$(head -n1 "$GRUB_THEMES_DIR/$GRUB_THEME_NAME/$GRUB_ICONS_MARK" 2>/dev/null)"
  if [[ " ${GRUB_ICON_VARIANTS[*]} " == *" $v "* ]]; then
    echo "$v"
  else
    echo white
  fi
}

grub_resolve_icons() {
  [[ -n "$GRUB_ICONS" ]] || GRUB_ICONS="$(grub_installed_icons)"
}

# Assembles the theme to install in $WORK_DIR: the repo's nord and, if the set
# isn't white, its icons/ folder replaced by boot/grub/icons/<set> + the mark.
# Leaves the path in GRUB_STAGE, so everything else (install_tree, doctor)
# compares against what should really be installed.
GRUB_STAGE=""
grub_stage() {
  local v="$1" src="$SRC_DIR/grub/themes/$GRUB_THEME_NAME"
  local root="$WORK_DIR/grub-stage" stage="$WORK_DIR/grub-stage/$GRUB_THEME_NAME"
  [[ -f "$src/theme.txt" ]] || {
    err "Can't find $src/theme.txt (set DEV_BOOT_SRC=<repo>/boot)"
    return 1
  }
  [[ " ${GRUB_ICON_VARIANTS[*]} " == *" $v "* ]] || {
    err "Unknown GRUB icon set: $v (options: ${GRUB_ICON_VARIANTS[*]})"
    return 1
  }
  if ! { rm -rf -- "$root" && mkdir -p -- "$root" && cp -r -- "$src" "$stage"; }; then
    err "Couldn't assemble the theme in $root"
    return 1
  fi
  if [[ "$v" != white ]]; then
    [[ -d "$SRC_DIR/grub/icons/$v" ]] || {
      err "Can't find $SRC_DIR/grub/icons/$v"
      return 1
    }
    rm -rf -- "$stage/icons" && cp -r -- "$SRC_DIR/grub/icons/$v" "$stage/icons" || return 1
    printf '%s\n' "$v" >"$stage/$GRUB_ICONS_MARK"
  fi
  GRUB_STAGE="$stage"
}

# ─── plymouth: where each theme comes from ──────────────────────────────────

# Theme= of the [Daemon] section of a plymouthd.conf/.defaults.
ply_conf_theme() {
  [[ -f "$1" ]] || return 0
  awk '/^\[/ { d = ($0 == "[Daemon]"); next }
       d && /^[[:space:]]*Theme[[:space:]]*=/ { sub(/^[^=]*=[[:space:]]*/, ""); print; exit }' "$1"
}

# Themes saved in boot/plymouth/themes (one per line).
ply_repo_themes() {
  local d
  for d in "$SRC_DIR"/plymouth/themes/*/; do
    d="${d%/}"
    [[ -f "$d/${d##*/}.plymouth" ]] && echo "${d##*/}"
  done
}
ply_in_repo() { [[ -n "$1" && -f "$SRC_DIR/plymouth/themes/$1/$1.plymouth" ]]; }

# Field $2 (repo/commit/path) of the mark of a theme installed from upstream.
ply_mark_get() {
  sed -n "s/^$2=//p" "$PLY_THEMES_DIR/$1/$PLY_MARK" 2>/dev/null | head -n1
}
ply_from_upstream() { [[ -n "$1" && -f "$PLY_THEMES_DIR/$1/$PLY_MARK" ]]; }

# Themes installed from upstream (with the mark) that aren't in boot/.
ply_upstream_installed() {
  local d n
  for d in "$PLY_THEMES_DIR"/*/; do
    n="$(basename "$d")"
    ply_from_upstream "$n" && ! ply_in_repo "$n" && echo "$n"
  done
}

ply_origin() {
  if ply_in_repo "$1"; then
    echo "dotfiles"
  elif ply_from_upstream "$1"; then
    echo "upstream"
  elif [[ -n "$1" ]]; then
    echo "not managed by dev-boot"
  fi
}

# Without --plymouth: the one layer 1 already sets, if dev-boot knows it (from
# boot/ or installed from upstream); otherwise the default.
ply_resolve_theme() {
  [[ -n "$PLY_THEME" ]] && return 0
  local cur
  cur="$(ply_conf_theme "$PLY_CONF")"
  if ply_in_repo "$cur" || ply_from_upstream "$cur"; then
    PLY_THEME="$cur"
  else
    PLY_THEME="$PLY_DEFAULT"
  fi
}

# ─── plymouth: upstream catalog ─────────────────────────────────────────────
# Partial clone pinned to PLY_UPSTREAM_COMMIT: --filter=blob:none fetches only
# the trees (the theme list) and the sparse checkout later fetches the files
# of a single theme. It lives in $WORK_DIR, so it lasts for the run. The .ok
# mark (not a variable) lets subshells reuse it too (the menu's summary is
# computed in one).
CATALOG=() # pack_N/name
ply_catalog_load() {
  [[ ${#CATALOG[@]} -gt 0 ]] && return 0
  local dir="$WORK_DIR/catalog"
  if [[ ! -f "$dir/.ok" ]]; then
    command -v git &>/dev/null || {
      err "git isn't installed: can't query the upstream repo"
      return 1
    }
    rm -rf -- "$dir" && mkdir -p -- "$dir" || return 1
    if ! { git -C "$dir" init -q \
      && git -C "$dir" remote add origin "$PLY_UPSTREAM_URL" \
      && git -C "$dir" fetch -q --depth 1 --filter=blob:none origin "$PLY_UPSTREAM_COMMIT"; }; then
      err "Couldn't query $PLY_UPSTREAM_URL (offline?)"
      return 1
    fi
    touch "$dir/.ok"
  fi
  mapfile -t CATALOG < <(git -C "$dir" ls-tree -d --name-only "$PLY_UPSTREAM_COMMIT" -- pack_1/ pack_2/ pack_3/ pack_4/ \
    | grep -E '^pack_[0-9]+/[a-z0-9_]+$')
  [[ ${#CATALOG[@]} -gt 0 ]] || {
    err "The upstream repo has no themes at $PLY_UPSTREAM_COMMIT"
    return 1
  }
}

# Value of key $2 in a .plymouth file.
plymouth_key() {
  sed -n "s/^[[:space:]]*$2[[:space:]]*=[[:space:]]*//p" "$1" | head -n1 | tr -d '\r'
}

# Downloads theme $1 from upstream, validates it and leaves it ready for
# install_tree in $WORK_DIR/ply-stage/$1 (with data permissions and the mark).
ply_upstream_stage() {
  local name="$1" path dir="$WORK_DIR/catalog"
  ply_catalog_load || return 1
  path="$(printf '%s\n' "${CATALOG[@]}" | grep -m1 -xE "pack_[0-9]+/$name")"
  [[ -n "$path" ]] || {
    err "$name isn't in the upstream repo (dev-boot --list-plymouth)"
    return 1
  }
  info "Downloading $name from upstream ($path @ ${PLY_UPSTREAM_COMMIT:0:7})..."
  if ! { git -C "$dir" sparse-checkout set --no-cone "/$path/" \
    && git -c advice.detachedHead=false -C "$dir" checkout -q "$PLY_UPSTREAM_COMMIT"; }; then
    err "Couldn't download $path"
    return 1
  fi

  local stage="$WORK_DIR/ply-stage/$name"
  { rm -rf -- "$stage" && mkdir -p -- "$WORK_DIR/ply-stage" && cp -r -- "$dir/$path" "$stage"; } || return 1

  # Validation: this is content from the internet that ends up owned by root
  # and inside the initramfs.
  local desc="$stage/$name.plymouth" bad size
  [[ -f "$desc" ]] || {
    err "$path has no $name.plymouth — not installing it"
    return 1
  }
  bad="$(find "$stage" ! -type f ! -type d -print -quit)"
  [[ -z "$bad" ]] || {
    err "$path contains something that isn't a file or folder (${bad#"$stage"/}) — not installing it"
    return 1
  }
  size="$(du -sm "$stage" | cut -f1)"
  [[ "$size" -le "$PLY_UPSTREAM_MAX_MB" ]] || {
    err "$path weighs $size MB (max $PLY_UPSTREAM_MAX_MB) — not installing it"
    return 1
  }
  local module image script
  module="$(plymouth_key "$desc" ModuleName)"
  image="$(plymouth_key "$desc" ImageDir)"
  script="$(plymouth_key "$desc" ScriptFile)"
  if [[ "$module" != script || "$image" != "$PLY_THEMES_DIR/$name" ||
    "$script" != "$PLY_THEMES_DIR/$name/$name.script" ]]; then
    err "$name.plymouth isn't a script theme pointing to $PLY_THEMES_DIR/$name — not installing it"
    return 1
  fi
  [[ -f "$stage/$name.script" ]] || {
    err "$path has no $name.script — not installing it"
    return 1
  }
  # It's data: nothing executable (upstream ships .script/.plymouth as +x).
  find "$stage" -type d -exec chmod 755 {} + && find "$stage" -type f -exec chmod 644 {} +
  printf 'repo=%s\ncommit=%s\npath=%s\n' "$PLY_UPSTREAM_URL" "$PLY_UPSTREAM_COMMIT" "$path" \
    >"$stage/$PLY_MARK"
  ok "$name downloaded and validated"
}

# Leaves in PLY_SRC the folder to install for theme $1 and in PLY_ORIGIN where
# it comes from. boot/ wins over upstream (cuts_alt is in both). One already
# installed from the same commit is used as is: no network needed.
PLY_SRC=""
PLY_ORIGIN=""
ply_prepare() {
  local name="$1" dst="$PLY_THEMES_DIR/$1"
  [[ "$name" =~ ^[a-z0-9_]+$ ]] || {
    err "Invalid theme name: $name"
    return 1
  }
  if ply_in_repo "$name"; then
    PLY_SRC="$SRC_DIR/plymouth/themes/$name"
    PLY_ORIGIN="dotfiles"
    return 0
  fi
  PLY_ORIGIN="upstream"
  if [[ "$(ply_mark_get "$name" commit)" == "$PLY_UPSTREAM_COMMIT" ]]; then
    PLY_SRC="$dst"
    return 0
  fi
  if [[ -e "$dst" ]] && dpkg -S "$dst" &>/dev/null; then
    err "$dst belongs to package $(dpkg -S "$dst" 2>/dev/null | cut -d: -f1 | head -n1) — dev-boot won't overwrite it"
    return 1
  fi
  ply_upstream_stage "$name" || return 1
  PLY_SRC="$WORK_DIR/ply-stage/$name"
}

# initrd of the running kernel. It's the one checked and rebuilt: after a
# kernel upgrade, the initramfs-tools hook builds the new one with the
# plymouthd.conf we already left, so it will carry the theme too.
current_initrd() {
  echo "/boot/initrd.img-$(uname -r)"
}

# Does the initramfs carry theme $1? 0 yes, 1 no, 2 couldn't read it.
initramfs_has_theme() {
  local initrd
  initrd="$(current_initrd)"
  [[ -r "$initrd" ]] && command -v lsinitramfs &>/dev/null || return 2
  lsinitramfs "$initrd" 2>/dev/null \
    | grep -q "usr/share/plymouth/themes/$1/$1.plymouth"
}

# ─── grub ───────────────────────────────────────────────────────────────────
install_grub() {
  sep
  if ! have_grub; then
    skip "GRUB isn't installed here (no update-grub or /boot/grub)"
    return 0
  fi
  grub_resolve_icons
  local theme_txt="$GRUB_THEMES_DIR/$GRUB_THEME_NAME/theme.txt"
  info "Theme $GRUB_THEME_NAME with $GRUB_ICONS icons"
  grub_stage "$GRUB_ICONS" || return 1

  install_tree "$GRUB_STAGE" "$GRUB_THEMES_DIR/$GRUB_THEME_NAME" || return 1
  local changed=$TREE_CHANGED

  # Before pointing GRUB at the theme, the theme has to be in place.
  if ! $DRY_RUN && [[ ! -f "$theme_txt" ]]; then
    err "$theme_txt doesn't exist — not writing a GRUB_THEME that points nowhere"
    return 1
  fi

  local tmp existed=false
  tmp="$(mktemp -p "$WORK_DIR" grub-dropin.XXXXXX)" || return 1
  cat >"$tmp" <<EOF
# Managed by dev-boot (dotfiles): rewritten on every run.
# Theme only; per-machine settings stay in /etc/default/grub.
GRUB_THEME="$theme_txt"
GRUB_GFXMODE="$GRUB_GFXMODE_WANT"
EOF
  bash -n "$tmp" || {
    err "The generated drop-in isn't valid shell — not installing it"
    return 1
  }
  [[ -f "$GRUB_DROPIN" ]] && existed=true
  write_root_file "$tmp" "$GRUB_DROPIN" || return 1
  local dropin_changed=$FILE_CHANGED
  $FILE_CHANGED && changed=true

  if ! $changed; then
    skip "GRUB unchanged — no need for update-grub"
  else
    info "Regenerating grub.cfg (update-grub)..."
    if ! run_root_box "update-grub" update-grub; then
      err "update-grub failed — your previous grub.cfg is intact"
      $dropin_changed && restore_root_file "$GRUB_DROPIN" "$existed"
      return 1
    fi
    ok "grub.cfg regenerated"
  fi

  local cmdline
  cmdline="$(grub_effective | sed -n 3p)"
  [[ " $cmdline " == *" splash "* ]] \
    || warn "Your kernel command line has no 'splash': Plymouth won't show (add it in /etc/default/grub)"
  return 0
}

# ─── plymouth ───────────────────────────────────────────────────────────────
install_plymouth() {
  sep
  if ! have_plymouth; then
    skip "Plymouth isn't installed here"
    return 0
  fi
  ply_resolve_theme
  info "Animation $PLY_THEME"
  ply_prepare "$PLY_THEME" || return 1
  info "Source: $PLY_ORIGIN"
  local want="$PLY_THEMES_DIR/$PLY_THEME/$PLY_THEME.plymouth"
  [[ -f "$PLY_SRC/$PLY_THEME.plymouth" ]] || {
    err "Can't find $PLY_SRC/$PLY_THEME.plymouth (set DEV_BOOT_SRC=<repo>/boot)"
    return 1
  }

  install_tree "$PLY_SRC" "$PLY_THEMES_DIR/$PLY_THEME" || return 1
  local rebuild=$TREE_CHANGED

  # Layer 1: only the Theme= line of [Daemon]; the rest (ShowDelay...) is
  # kept. Without Theme= it's added under [Daemon]; without [Daemon], it's
  # created.
  local cur tmp
  cur="$(ply_conf_theme "$PLY_CONF")"
  if [[ "$cur" == "$PLY_THEME" ]]; then
    skip "$PLY_CONF already has Theme=$PLY_THEME"
  else
    tmp="$(mktemp -p "$WORK_DIR" plymouthd.XXXXXX)" || return 1
    if [[ -f "$PLY_CONF" ]]; then
      awk -v t="$PLY_THEME" '
        /^\[/ { if (d && !done) { print "Theme=" t; done = 1 } d = ($0 == "[Daemon]"); print; next }
        d && /^[[:space:]]*Theme[[:space:]]*=/ { if (!done) { print "Theme=" t; done = 1 } next }
        { print }
        END { if (!done) { if (!d) print "[Daemon]"; print "Theme=" t } }
      ' "$PLY_CONF" >"$tmp"
    else
      printf '[Daemon]\nTheme=%s\n' "$PLY_THEME" >"$tmp"
    fi
    info "Layer 1: Theme=${cur:-<none>} → $PLY_THEME"
    write_root_file "$tmp" "$PLY_CONF" || return 1
    rebuild=true
  fi

  # Layer 3: fallback alternative. --install is idempotent; --set only if it
  # points to another theme (that switches it to manual mode, on purpose).
  local alt_value
  alt_value="$(update-alternatives --query default.plymouth 2>/dev/null | sed -n 's/^Value: //p')"
  if ! update-alternatives --list default.plymouth 2>/dev/null | grep -qx "$want"; then
    run_root update-alternatives --install "$PLY_ALT_LINK" default.plymouth "$want" 100 >/dev/null \
      && ok "Layer 3: $want registered as an alternative (priority 100)"
    alt_value="$(update-alternatives --query default.plymouth 2>/dev/null | sed -n 's/^Value: //p')"
  fi
  if [[ "$alt_value" == "$want" ]]; then
    skip "Layer 3: default.plymouth already points to $PLY_THEME"
  else
    run_root update-alternatives --set default.plymouth "$want" >/dev/null \
      && ok "Layer 3: default.plymouth → $PLY_THEME"
  fi

  local has rc=0
  initramfs_has_theme "$PLY_THEME" || rc=$?
  case $rc in
    0) has=true ;;
    1)
      has=false
      rebuild=true
      ;;
    *) has=unknown ;;
  esac

  if ! $rebuild; then
    skip "initramfs already carries $PLY_THEME — no need to rebuild it"
  else
    [[ "$has" == unknown ]] && warn "Couldn't read $(current_initrd); rebuilding it just in case"
    local initrd need avail
    initrd="$(current_initrd)"
    need=$(($(stat -c %s "$initrd" 2>/dev/null || echo 0) * 2))
    avail="$(df --output=avail -B1 /boot 2>/dev/null | tail -1 | tr -d ' ')"
    if [[ -n "$avail" && "$need" -gt 0 && "$avail" -lt "$need" ]]; then
      err "Low space in /boot ($((avail / 1048576)) MB free, ~$((need / 1048576)) MB needed) — not rebuilding the initramfs"
      return 1
    fi
    info "Rebuilding the initramfs for $(uname -r) (this may take a while)..."
    if ! run_root_box "update-initramfs" update-initramfs -u -k "$(uname -r)"; then
      err "update-initramfs failed — the previous initramfs is intact (it's built separately and only swapped in on success)"
      return 1
    fi
    ok "initramfs rebuilt with $PLY_THEME"
  fi

  grep -qw splash /proc/cmdline 2>/dev/null \
    || warn "The kernel booted without 'splash': Plymouth won't show (add it in /etc/default/grub and run update-grub)"
  return 0
}

# ─── doctor ─────────────────────────────────────────────────────────────────
DOC_FAIL=0
doc_ok() { ok "$*"; }
doc_warn() { warn "$*"; }
doc_fail() {
  err "$*"
  DOC_FAIL=1
}

doctor_grub() {
  if ! have_grub; then
    skip "GRUB: not installed here"
    return
  fi
  local dir="$GRUB_THEMES_DIR/$GRUB_THEME_NAME" eff theme gfx cmdline icons
  icons="$(grub_installed_icons)"
  if [[ ! -f "$dir/theme.txt" ]]; then
    doc_fail "GRUB: theme $GRUB_THEME_NAME not installed (dev-boot --only=grub)"
  elif grub_stage "$icons" && same_tree "$GRUB_STAGE" "$dir"; then
    doc_ok "GRUB: theme $GRUB_THEME_NAME ($dir) with $icons icons, matches the repo"
  else
    doc_warn "GRUB: $dir differs from the repo (dev-boot --only=grub)"
  fi

  eff="$(grub_effective)"
  theme="$(sed -n 1p <<<"$eff")"
  gfx="$(sed -n 2p <<<"$eff")"
  cmdline="$(sed -n 3p <<<"$eff")"
  if [[ "$theme" == "$dir/theme.txt" ]]; then
    doc_ok "      effective GRUB_THEME = $theme"
  else
    doc_fail "      effective GRUB_THEME = ${theme:-<empty>} (expected $dir/theme.txt)"
  fi
  if [[ "$gfx" == "$GRUB_GFXMODE_WANT" ]]; then
    doc_ok "      effective GRUB_GFXMODE = $gfx"
  else
    doc_warn "      effective GRUB_GFXMODE = ${gfx:-<empty>} (expected $GRUB_GFXMODE_WANT)"
  fi
  if [[ -f "$GRUB_DROPIN" ]]; then
    doc_ok "      drop-in $GRUB_DROPIN"
  else
    doc_warn "      no $GRUB_DROPIN: the theme depends on /etc/default/grub (dev-boot --only=grub)"
  fi
  if [[ " $cmdline " == *" splash "* ]]; then
    doc_ok "      kernel command line has 'splash'"
  else
    doc_warn "      kernel command line has no 'splash' (Plymouth won't show)"
  fi

  if [[ -r /boot/grub/grub.cfg ]]; then
    if grep -qF "$dir/theme.txt" /boot/grub/grub.cfg; then
      doc_ok "      grub.cfg loads the theme"
    else
      doc_warn "      grub.cfg doesn't load the theme yet (dev-boot --only=grub)"
    fi
  else
    skip "      grub.cfg is only readable by root (not checked)"
  fi
}

# Checks the theme layer 1 sets TODAY, whatever it is: the doctor doesn't
# decide which theme you should have, only whether the boot will show the one
# you chose.
doctor_plymouth() {
  if ! have_plymouth; then
    skip "Plymouth: not installed here"
    return
  fi
  local name dir want v
  name="$(ply_conf_theme "$PLY_CONF")"
  if [[ -z "$name" ]]; then
    doc_fail "Plymouth: $PLY_CONF has no Theme= (dev-boot --only=plymouth)"
    return
  fi
  dir="$PLY_THEMES_DIR/$name"
  want="$dir/$name.plymouth"
  if [[ ! -f "$want" ]]; then
    doc_fail "Plymouth: theme $name not installed (dev-boot --only=plymouth)"
  elif ply_in_repo "$name"; then
    if same_tree "$SRC_DIR/plymouth/themes/$name" "$dir"; then
      doc_ok "Plymouth: theme $name ($dir) matches the repo"
    else
      doc_warn "Plymouth: $dir differs from the repo (dev-boot --only=plymouth)"
    fi
  elif ply_from_upstream "$name"; then
    v="$(ply_mark_get "$name" commit)"
    if [[ "$v" == "$PLY_UPSTREAM_COMMIT" ]]; then
      doc_ok "Plymouth: theme $name ($dir) from upstream, $(ply_mark_get "$name" path) @ ${v:0:7}"
    else
      doc_warn "Plymouth: theme $name from upstream @ ${v:0:7}, dev-boot uses ${PLY_UPSTREAM_COMMIT:0:7} (dev-boot --only=plymouth)"
    fi
  else
    doc_warn "Plymouth: theme $name ($dir) isn't managed by dev-boot (dev-boot --plymouth=$PLY_DEFAULT to go back to the dotfiles one)"
  fi

  v="$(ply_conf_theme "$PLY_CONF")"
  doc_ok "      layer 1 $PLY_CONF: Theme=$v (wins)"
  v="$(ply_conf_theme "$PLY_DEFAULTS")"
  skip "      layer 2 $PLY_DEFAULTS: Theme=${v:-<none>} (package's; ignored while layer 1 exists)"
  v="$(update-alternatives --query default.plymouth 2>/dev/null | sed -n 's/^Value: //p')"
  if [[ "$v" == "$want" ]]; then
    doc_ok "      layer 3 default.plymouth → $name"
  else
    doc_warn "      layer 3 default.plymouth → ${v:-<none>} (dev-boot --only=plymouth)"
  fi

  local rc=0
  initramfs_has_theme "$name" || rc=$?
  case $rc in
    0) doc_ok "      initramfs $(current_initrd) carries $name" ;;
    1) doc_fail "      initramfs $(current_initrd) does NOT carry $name: a different one will show at boot (dev-boot --only=plymouth)" ;;
    *) skip "      couldn't read $(current_initrd) (not checked)" ;;
  esac
  if grep -qw splash /proc/cmdline 2>/dev/null; then
    doc_ok "      the kernel booted with 'splash'"
  else
    doc_warn "      the kernel booted without 'splash' (Plymouth isn't shown)"
  fi
}

run_doctor() {
  sep
  info "Doctor: GRUB $GRUB_THEME_NAME / Plymouth $(ply_conf_theme "$PLY_CONF")"
  DOC_FAIL=0
  doctor_grub
  doctor_plymouth
  sep
  if [[ $DOC_FAIL -eq 0 ]]; then
    ok "Doctor: the boot uses the chosen themes"
  else
    err "Doctor: something is broken or pending — see above"
  fi
  return "$DOC_FAIL"
}

# ─── running keys ───────────────────────────────────────────────────────────
RUN_OK=0
RUN_FAILED=()
run_keys() {
  RUN_OK=0
  RUN_FAILED=()
  local key
  for key in "${PKG_KEYS[@]}"; do
    [[ " $* " == *" $key "* ]] || continue
    if "${PKG_FN[$key]}"; then
      ((RUN_OK++)) || true
    else
      warn "Failed: ${PKG_LABEL[$key]}"
      RUN_FAILED+=("$key")
    fi
  done
}

list_plymouth() {
  local n
  info "In your dotfiles (boot/plymouth/themes):"
  while IFS= read -r n; do
    printf '    %s%s\n' "$n" "$([[ "$n" == "$PLY_DEFAULT" ]] && echo '  (default)')"
  done < <(ply_repo_themes)
  info "Installed here from upstream:"
  ply_upstream_installed | sed 's/^/    /'
  info "Upstream ($PLY_UPSTREAM_URL @ ${PLY_UPSTREAM_COMMIT:0:7}):"
  ply_catalog_load || return 1
  printf '%s\n' "${CATALOG[@]}" | awk -F/ '{ printf "    %-24s %s\n", $2, $1 }'
}

# ─── menu (dialog) ──────────────────────────────────────────────────────────
pause() { read -rp "  Press ENTER to return to menu..." _; }

# Pads $1 with spaces up to $2 characters. printf "%-Ns" counts bytes and "·"
# takes two, which misaligned the columns; ${#} counts characters.
pad() {
  local s="$1"
  while ((${#s} < $2)); do s+=" "; done
  printf '%s' "$s"
}

# Current state for the menu header (no sudo: lsinitramfs takes <1 s).
MENU_STATUS=""
menu_status() {
  local g p icons cur st
  if have_grub; then
    icons="$(grub_installed_icons)"
    if [[ -f "$GRUB_DROPIN" ]] && grub_stage "$icons" 2>/dev/null \
      && same_tree "$GRUB_STAGE" "$GRUB_THEMES_DIR/$GRUB_THEME_NAME"; then
      st="✔ up to date"
    else
      st="⚠ pending"
    fi
    g="GRUB      $(pad "$GRUB_THEME_NAME · $icons icons" 34) $st"
  else
    g="GRUB      not installed here"
  fi
  if have_plymouth; then
    cur="$(ply_conf_theme "$PLY_CONF")"
    if [[ -n "$cur" && -f "$PLY_THEMES_DIR/$cur/$cur.plymouth" ]] && initramfs_has_theme "$cur" \
      && { ! ply_in_repo "$cur" || same_tree "$SRC_DIR/plymouth/themes/$cur" "$PLY_THEMES_DIR/$cur"; }; then
      st="✔ up to date"
    else
      st="⚠ pending"
    fi
    p="Plymouth  $(pad "${cur:-<none>} ($(ply_origin "$cur"))" 34) $st"
  else
    p="Plymouth  not installed here"
  fi
  MENU_STATUS="$g\n$p"
}

# Upstream list: first a name filter (80 is a lot for a single list), then
# the radiolist with the matches. Sets PLY_THEME.
pick_upstream() {
  dialog --backtitle "$BACKTITLE" --infobox "Querying the upstream Plymouth repo..." 3 50
  local errf="$WORK_DIR/catalog.err"
  if ! ply_catalog_load >/dev/null 2>"$errf"; then
    dialog --backtitle "$BACKTITLE" --title " Upstream " \
      --msgbox "$(sed -E 's/\x1b\[[0-9;]*m//g' "$errf")" 8 70
    return 1
  fi
  local filter items path name tag choice
  while true; do
    filter=$(dialog --backtitle "$BACKTITLE" --title " Upstream · ${#CATALOG[@]} themes " \
      --inputbox "Filter by name (empty = all).\n\nPreviews of every animation: $PLY_UPSTREAM_URL" \
      11 72 "" 3>&1 1>&2 2>&3) || return 1
    items=()
    for path in "${CATALOG[@]}"; do
      name="${path#*/}"
      [[ -z "$filter" || "$name" == *"${filter,,}"* ]] || continue
      tag="${path%%/*}"
      tag="pack ${tag#pack_}"
      ply_from_upstream "$name" && tag+=" · installed"
      items+=("$name" "$tag" off)
    done
    if [[ ${#items[@]} -eq 0 ]]; then
      dialog --backtitle "$BACKTITLE" --msgbox "No theme contains \"$filter\"." 6 50
      continue
    fi
    choice=$(dialog --backtitle "$BACKTITLE" --title " Upstream " \
      --radiolist "Pick an animation  [SPACE=select  ENTER=confirm]\nIt's installed on this machine only (not added to the dotfiles)." \
      22 72 14 "${items[@]}" 3>&1 1>&2 2>&3) || continue
    [[ -n "$choice" ]] || continue
    PLY_THEME="$choice"
    return 0
  done
}

# Radiolist with the dotfiles themes + the ones already installed from
# upstream + the entry that opens the upstream list. Sets PLY_THEME.
pick_plymouth() {
  if ! have_plymouth; then
    dialog --backtitle "$BACKTITLE" --msgbox "Plymouth isn't installed here." 6 50
    return 1
  fi
  local cur items=() n desc choice
  cur="$(ply_conf_theme "$PLY_CONF")"
  while IFS= read -r n; do
    desc="dotfiles"
    [[ "$n" == "$PLY_DEFAULT" ]] && desc+=" · default"
    [[ "$n" == "$cur" ]] && desc+=" · current"
    items+=("$n" "$desc" "$([[ "$n" == "$cur" ]] && echo on || echo off)")
  done < <(ply_repo_themes)
  while IFS= read -r n; do
    desc="upstream"
    [[ "$n" == "$cur" ]] && desc+=" · current"
    items+=("$n" "$desc" "$([[ "$n" == "$cur" ]] && echo on || echo off)")
  done < <(ply_upstream_installed)
  items+=("+upstream" "🌐 Browse the upstream themes…" off)

  choice=$(dialog --backtitle "$BACKTITLE" --title " Plymouth animation " \
    --radiolist "Pick the boot animation  [SPACE=select  ENTER=confirm]" \
    18 72 9 "${items[@]}" 3>&1 1>&2 2>&3) || return 1
  case "$choice" in
    "") return 1 ;;
    +upstream) pick_upstream ;;
    *) PLY_THEME="$choice" ;;
  esac
}

pick_grub_icons() {
  if ! have_grub; then
    dialog --backtitle "$BACKTITLE" --msgbox "GRUB isn't installed here." 6 50
    return 1
  fi
  local cur items=() v choice
  cur="$(grub_installed_icons)"
  for v in "${GRUB_ICON_VARIANTS[@]}"; do
    if [[ "$v" == "$cur" ]]; then
      items+=("$v" "${GRUB_ICON_LABEL[$v]} · current" on)
    else
      items+=("$v" "${GRUB_ICON_LABEL[$v]}" off)
    fi
  done
  choice=$(dialog --backtitle "$BACKTITLE" --title " GRUB icons " \
    --radiolist "Icons for the GRUB menu entries  [SPACE=select  ENTER=confirm]" \
    12 72 3 "${items[@]}" 3>&1 1>&2 2>&3) || return 1
  [[ -n "$choice" ]] || return 1
  GRUB_ICONS="$choice"
}

# Readable summary of a --dry-run: what would change, without the internal
# steps (install_tree's rm/cp/chown...) or what's already up to date. Of the
# [OK] lines only layer 3's stay: update-alternatives runs with >/dev/null,
# so its [dry-run] line never gets here.
plan_text() {
  sed -E 's/\x1b\[[0-9;]*m//g' | awk '
    /^\[ERR\]/ { sub(/^\[ERR\][[:space:]]*/, ""); print "✖ " $0; next }
    /^\[WARN\]/ { sub(/^\[WARN\][[:space:]]*/, ""); print "⚠ " $0; next }
    /^\[OK\][[:space:]]*Layer 3/ { sub(/^\[OK\][[:space:]]*/, ""); print "• " $0; next }
    /^\[INFO\][[:space:]]*\[dry-run\]/ { next }
    /^\[INFO\]/ { sub(/^\[INFO\][[:space:]]*/, ""); print "• " $0; next }'
}

# Only called inside $(...): the DRY_RUN change never leaves the subshell.
plan_keys() {
  DRY_RUN=true
  MENU_MODE=false
  run_keys "$@"
}

# Computes the plan with the same code in --dry-run (in a subshell: changes
# nothing), shows it and, if accepted, applies it for real. Launched with
# --dry-run, it only shows the plan.
apply_flow() {
  dialog --backtitle "$BACKTITLE" --infobox "Computing changes..." 3 40
  local raw plan h
  raw="$(plan_keys "$@" 2>&1)"
  plan="$(plan_text <<<"$raw")"
  if grep -q '^✖' <<<"$plan"; then
    dialog --backtitle "$BACKTITLE" --title " Can't apply " --msgbox "$plan" 20 90
    return 1
  fi
  if ! grep -q '\[dry-run\]' <<<"$raw"; then
    dialog --backtitle "$BACKTITLE" --title " All up to date " \
      --msgbox "Nothing to change.\n\n$plan" 12 90
    return 0
  fi
  if $DRY_RUN; then
    dialog --backtitle "$BACKTITLE" --title " Dry run (--dry-run) " --msgbox "$plan" 22 90
    return 0
  fi
  h=$(($(wc -l <<<"$plan") + 7))
  ((h > 24)) && h=24
  dialog --backtitle "$BACKTITLE" --title " Will run with sudo " \
    --yes-label "Apply" --no-label "Cancel" --yesno "$plan" "$h" 90 || return 1

  clear
  run_keys "$@"
  sep
  if [[ ${#RUN_FAILED[@]} -eq 0 ]]; then
    ok "Done: $*"
  else
    err "Failed: ${RUN_FAILED[*]}"
  fi
  pause
}

menu_loop() {
  MENU_MODE=true
  local choice dry=""
  $DRY_RUN && dry="\n[--dry-run: nothing will be applied]"
  while true; do
    menu_status
    choice=$(dialog --clear --colors --backtitle "$BACKTITLE" --title " dev-boot " \
      --cancel-label "Quit" --menu \
      "$MENU_STATUS\n\nNeeds sudo. Never touches /etc/default/grub or the kernel command line.$dry" \
      16 78 4 \
      1 "Apply / update everything" \
      2 "Plymouth animation  ▸" \
      3 "GRUB icons  ▸" \
      4 "Check (doctor)" \
      3>&1 1>&2 2>&3) || break
    case "$choice" in
      1) apply_flow "${PKG_KEYS[@]}" ;;
      2) pick_plymouth && apply_flow plymouth ;;
      3) pick_grub_icons && apply_flow grub ;;
      4)
        clear
        run_doctor
        pause
        ;;
    esac
    # A choice that wasn't applied (Cancel) isn't carried over: it's read
    # back from the system on the next action.
    PLY_THEME=""
    GRUB_ICONS=""
  done
  clear
}

# ─── help ───────────────────────────────────────────────────────────────────
usage() {
  sed -n '/^# Usage:/,/^[^#]/{/^#/s/^# \{0,1\}//p}' "$0"
  printf '\nKeys: %s\n' "${PKG_KEYS[*]}"
}

# ─── arg parsing ────────────────────────────────────────────────────────────
ONLY_KEYS=()
DOCTOR_ONLY=false
LIST_PLY=false
for arg in "$@"; do
  case "$arg" in
    --all) NONINTERACTIVE=true ;;
    --only=*) IFS=',' read -ra ONLY_KEYS <<<"${arg#--only=}" ;;
    --plymouth=*) PLY_THEME="${arg#--plymouth=}" ;;
    --grub-icons=*) GRUB_ICONS="${arg#--grub-icons=}" ;;
    --list-plymouth) LIST_PLY=true ;;
    --dry-run) DRY_RUN=true ;;
    --doctor) DOCTOR_ONLY=true ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      err "Unknown argument: $arg"
      usage >&2
      exit 1
      ;;
  esac
done

if [[ -n "$GRUB_ICONS" && " ${GRUB_ICON_VARIANTS[*]} " != *" $GRUB_ICONS "* ]]; then
  err "--grub-icons=$GRUB_ICONS doesn't exist (options: ${GRUB_ICON_VARIANTS[*]})"
  exit 1
fi
if [[ -n "$PLY_THEME" && ! "$PLY_THEME" =~ ^[a-z0-9_]+$ ]]; then
  err "--plymouth=$PLY_THEME: invalid name (dev-boot --list-plymouth)"
  exit 1
fi

[[ -d "$SRC_DIR" ]] || {
  err "Can't find $SRC_DIR (set DEV_BOOT_SRC=<repo>/boot)"
  exit 1
}

# ─── work dir + cleanup ─────────────────────────────────────────────────────
# Before the doctor: it also assembles the GRUB theme there to compare it.
WORK_DIR="$(mktemp -d -t dev-boot.XXXXXX)" || {
  err "Couldn't create the work directory"
  exit 1
}
trap 'rm -rf "$WORK_DIR"' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP # terminal closed mid-run: still clean up WORK_DIR

if $DOCTOR_ONLY; then
  run_doctor
  exit $?
fi
if $LIST_PLY; then
  list_plymouth
  exit $?
fi

# ─── key selection ──────────────────────────────────────────────────────────
# --plymouth/--grub-icons alone imply their key; with --all/--only those win.
CHOSEN=()
if [[ ${#ONLY_KEYS[@]} -gt 0 ]]; then
  CHOSEN=("${ONLY_KEYS[@]}")
elif [[ "$NONINTERACTIVE" == "true" ]]; then
  info "Non-interactive mode — every key (${PKG_KEYS[*]})"
  CHOSEN=("${PKG_KEYS[@]}")
elif [[ -n "$PLY_THEME" || -n "$GRUB_ICONS" ]]; then
  [[ -n "$GRUB_ICONS" ]] && CHOSEN+=(grub)
  [[ -n "$PLY_THEME" ]] && CHOSEN+=(plymouth)
elif ! [ -t 0 ]; then
  info "No terminal — every key (${PKG_KEYS[*]})"
  CHOSEN=("${PKG_KEYS[@]}")
else
  command -v dialog &>/dev/null || {
    err "dialog not found — install it (sudo apt install dialog) or use --all/--only="
    exit 1
  }
  menu_loop
  exit 0
fi

for key in "${CHOSEN[@]}"; do
  [[ -n "${PKG_FN[$key]:-}" ]] || {
    err "Unknown key: $key"
    usage >&2
    exit 1
  }
done
$DRY_RUN && warn "--dry-run mode: nothing is changed, only shown"

# ─── run (in PKG_KEYS order) + doctor ───────────────────────────────────────
run_keys "${CHOSEN[@]}"

doctor_rc=0
$DRY_RUN || {
  run_doctor
  doctor_rc=$?
}

sep
ok "Done — ok: $RUN_OK  failed: ${#RUN_FAILED[@]}"
if [[ ${#RUN_FAILED[@]} -gt 0 ]]; then
  warn "Failed: ${RUN_FAILED[*]}"
  exit 1
fi
exit "$doctor_rc"
