#!/usr/bin/env bash
set -uo pipefail

# ==============================================================================
# dev-ssh — manage per-machine SSH hosts in ~/.ssh/config.local
# ==============================================================================
# Run with no args to open the dialog menu (control dir + add servers via Manual
# or Tailscale autocomplete). Run with --setup for the non-interactive bits only
# (control-master dir + ensure config.local exists). bootstrap calls this script.
#
#   dev-ssh                  open the interactive menu
#   dev-ssh --setup          create ~/.ssh/cm + ensure config.local (no prompts)
#   dev-ssh --target=DIR     operate against DIR instead of $HOME (bootstrap test)
# ==============================================================================

TARGET="$HOME"
MODE="menu"
for arg in "$@"; do
  case "$arg" in
    --setup) MODE="setup" ;;
    --target=*) TARGET="${arg#--target=}" ;;
    *) ;;
  esac
done

# ------------------------------------------------------------------------------
# Look & feel (shared with bootstrap)
# ------------------------------------------------------------------------------
RED='\e[38;2;191;97;106m'
GRN='\e[38;2;163;190;140m'
YLW='\e[38;2;235;203;139m'
BLU='\e[38;2;136;192;208m'
CYN='\e[38;2;143;188;187m'
DIM='\e[38;2;94;129;172m'
BLD='\e[1m'
RST='\e[0m'

info() { printf "${BLU}[INFO]${RST}  %s\n" "$*"; }
ok() { printf "${GRN}[OK]${RST}    %s\n" "$*"; }
err() { printf "${RED}[ERR]${RST}   %s\n" "$*" >&2; }
warn() { printf "${YLW}[WARN]${RST}  %s\n" "$*"; }
skip() { printf "${CYN}[SKIP]${RST}  %s\n" "$*"; }
die() {
  err "$*"
  exit 1
}
sep() { printf "${DIM}%s${RST}\n" "  ──────────────────────────────────────────────────"; }

# When launched from bootstrap, reuse its backtitle so it looks identical.
BACKTITLE="${DEV_SSH_BACKTITLE:-DEV-SSH · $(hostname) · $(date '+%Y-%m-%d %H:%M')}"

print_header() {
  clear
  printf "${DIM}  ════════════════════════════════════════════════${RST}\n"
  printf "${BLU}${BLD}   DEV-SSH${RST}\n"
  printf "${CYN}   Host: %s   Date: %s${RST}\n" "$(hostname)" "$(date '+%Y-%m-%d %H:%M')"
  printf "${DIM}  ════════════════════════════════════════════════${RST}\n\n"
}

# Trim leading/trailing whitespace (no subprocess).
trim() {
  local s="$1"
  s="${s#"${s%%[![:space:]]*}"}"
  s="${s%"${s##*[![:space:]]}"}"
  printf '%s' "$s"
}

# Markers of the managed host block inside ~/.ssh/config.local. dev-ssh ONLY
# rewrites whatever is between these two lines; everything else (e.g. your
# IdentityFile entries) is preserved untouched across runs.
SSH_MARK_BEGIN="# >>> dotfiles:ssh-hosts (managed — do not edit by hand) >>>"
SSH_MARK_END="# <<< dotfiles:ssh-hosts <<<"
# Legacy (pre-English) begin marker, upgraded in place on first run.
SSH_MARK_BEGIN_LEGACY="# >>> dotfiles:ssh-hosts (managed — no editar a mano) >>>"

# ------------------------------------------------------------------------------
# Control dir + config.local
# ------------------------------------------------------------------------------
setup_ssh() {
  sep
  info "Setting up SSH control-master directory..."
  local ssh_dir="$TARGET/.ssh"
  local cm_dir="$ssh_dir/cm"
  mkdir -p "$cm_dir"
  chmod 700 "$ssh_dir"
  chmod 700 "$cm_dir"
  ok "SSH ready — $cm_dir (700)"
  ensure_config_local
}

# Create/repair ~/.ssh/config.local idempotently. User content (outside the
# markers) is always preserved; this only guarantees the empty managed block.
ensure_config_local() {
  local ssh_dir="$TARGET/.ssh"
  local cfg="$ssh_dir/config.local"
  mkdir -p "$ssh_dir"
  chmod 700 "$ssh_dir"

  # Upgrade the legacy (Spanish) begin marker to the current one, if present.
  if [[ -f "$cfg" ]] && grep -qF "$SSH_MARK_BEGIN_LEGACY" "$cfg"; then
    sed -i "s|$SSH_MARK_BEGIN_LEGACY|$SSH_MARK_BEGIN|" "$cfg"
    ok "Upgraded managed-block marker to the current format — $cfg"
  fi

  if [[ ! -e "$cfg" ]]; then
    (
      umask 077
      {
        printf '%s\n' "# ~/.ssh/config.local — machine-specific, NOT tracked by dotfiles."
        printf '%s\n' "# Anything OUTSIDE the managed block below is preserved across dev-ssh"
        printf '%s\n' "# runs; the managed block is regenerated by dev-ssh. Your IdentityFile"
        printf '%s\n' "# entries, hand-written hosts, etc. go here (outside the markers)."
        printf '\n'
        printf '%s\n' "$SSH_MARK_BEGIN"
        printf '%s\n' "$SSH_MARK_END"
      } >"$cfg"
    )
    chmod 600 "$cfg"
    ok "config.local created (empty managed block) — $cfg"
    return
  fi

  if ! grep -qF "$SSH_MARK_BEGIN" "$cfg"; then
    {
      printf '\n'
      printf '%s\n' "$SSH_MARK_BEGIN"
      printf '%s\n' "$SSH_MARK_END"
    } >>"$cfg"
    chmod 600 "$cfg"
    ok "Managed block added (preserving your config.local) — $cfg"
    return
  fi

  skip "config.local already has a managed block — $cfg"
}

# Read "Host ..." blocks from stdin and insert/update them in the managed block
# of config.local, under group $1 (e.g. "manual" or "tailnet:<name>"). Hosts are
# tagged with "#@ group:<gid>" comment headers. GLOBAL dedup by alias: an alias
# lives in a single group (the last one it was added to). Atomic, chmod 600,
# preserves everything outside the markers.
ssh_upsert_hosts() {
  local gid="${1:-}"
  ensure_config_local
  local cfg="$TARGET/.ssh/config.local"

  local newblocks; newblocks="$(cat)"
  if [[ -z "${newblocks//[$' \t\n']/}" ]]; then
    warn "Nothing to add."
    return
  fi

  local newfile tmp
  newfile="$(mktemp)"; tmp="$(mktemp)"
  printf '%s\n' "$newblocks" >"$newfile"

  awk -v B="$SSH_MARK_BEGIN" -v E="$SSH_MARK_END" -v G="$gid" '
    # Phase 1: new blocks (FNR==NR -> first file). All go into group G.
    FNR==NR {
      if ($0 ~ /^[[:space:]]*$/) next
      if ($0 ~ /^Host /) { a=$2; cur=a; if (!(a in blk)) ord[++n]=a; blk[a]=$0 ORS; group[a]=G; next }
      if (cur != "") blk[cur]=blk[cur] $0 ORS
      next
    }
    # Phase 2: existing config.local
    {
      if ($0 == B) { print; inman=1; cg=""; next }
      if ($0 == E) { emit(); print; inman=0; next }
      if (inman) {
        if ($0 ~ /^[[:space:]]*$/) next
        if ($0 ~ /^#@ group:/) { cg=substr($0, length("#@ group:") + 1); next }
        if ($0 ~ /^Host /) {
          a=$2
          if (a in blk) { cur2="" }                  # already in the new set: drop the old one
          else { cur2=a; ord[++n]=a; blk[a]=$0 ORS; group[a]=cg }
          next
        }
        if (cur2 != "") blk[cur2]=blk[cur2] $0 ORS
        next
      }
      print
    }
    # Emit: loose hosts first (gid=""), then each group (alphabetical) with its
    # header; hosts sorted within each group.
    function emit(   i,j,t,a,g,gl,gn,keys,m) {
      emit_one("")
      gn=0
      for (i=1;i<=n;i++) { a=ord[i]; g=group[a]; if (g!="" && !(g in gseen)) { gseen[g]=1; gl[++gn]=g } }
      for (i=1;i<=gn;i++) for (j=i+1;j<=gn;j++) if (gl[j] < gl[i]) { t=gl[i]; gl[i]=gl[j]; gl[j]=t }
      for (i=1;i<=gn;i++) { print "#@ group:" gl[i]; emit_one(gl[i]) }
    }
    function emit_one(g,   i,j,t,a,keys,m) {
      m=0
      for (i=1;i<=n;i++) { a=ord[i]; if (group[a]==g) keys[++m]=a }
      for (i=1;i<=m;i++) for (j=i+1;j<=m;j++) if (keys[j] < keys[i]) { t=keys[i]; keys[i]=keys[j]; keys[j]=t }
      for (i=1;i<=m;i++) printf "%s", blk[keys[i]]
    }
  ' "$newfile" "$cfg" >"$tmp"

  chmod 600 "$tmp"
  mv "$tmp" "$cfg"
  rm -f "$newfile"
}

# ------------------------------------------------------------------------------
# Tailscale helpers
# ------------------------------------------------------------------------------
# Returns Tailscale peers (self excluded) as "name<TAB>state". Uses the MagicDNS
# label (.DNSName, first label) — not .HostName, which may carry spaces or OS
# hostnames (e.g. "Pixel 9 Pro XL", "ip-172-31-...").
ssh_tailscale_peers() {
  if command -v jq &>/dev/null; then
    tailscale status --json 2>/dev/null \
      | jq -r '.Peer[]? | [(.DNSName | split(".")[0]), (if .Online then "online" else "offline" end)] | @tsv'
  elif command -v python3 &>/dev/null; then
    tailscale status --json 2>/dev/null | python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(0)
for p in (d.get("Peer") or {}).values():
    label = (p.get("DNSName", "") or "").split(".")[0]
    if label:
        print("%s\t%s" % (label, "online" if p.get("Online") else "offline"))
'
  else
    local self_ip; self_ip="$(tailscale ip -4 2>/dev/null | head -1)"
    tailscale status 2>/dev/null \
      | awk -v self="$self_ip" '$1 ~ /^100\./ && $1 != self { printf "%s\t?\n", $2 }'
  fi
}

# tailscale instalado pero sin tailnets visibles suele deberse a que el usuario
# no es 'operator' del daemon, así que status/switch no devuelven nada sin sudo.
# Le otorgamos ese permiso (requiere sudo) para que funcionen sin sudo después.
# Idempotente; se llama solo cuando no se detecta ninguna tailnet.
ssh_tailscale_fix_operator() {
  info "No se detectan tailnets — otorgando control a $USER (sudo tailscale set --operator=$USER)..."
  if sudo tailscale set --operator="$USER" &>/dev/null; then
    ok "Operador de Tailscale configurado: $USER"
    return 0
  fi
  warn "No se pudo ejecutar: sudo tailscale set --operator=$USER"
  return 1
}

# ------------------------------------------------------------------------------
# Username history per (tailnet, node)
# ------------------------------------------------------------------------------
# Hidden, per-machine, NOT tracked file. Share it across your own nodes manually
# (scp). TSV per line: tailnet \t node \t username \t epoch. Append-only; queries
# dedup and order by recency. Tailscale flow only.
ssh_hist_file() { printf '%s\n' "$TARGET/.ssh/.ssh_user_history"; }

# Distinct usernames for (tailnet, node), most recent first.
ssh_hist_users() { # $1=tailnet  $2=node
  local f; f="$(ssh_hist_file)"
  [[ -f "$f" ]] || return 0
  awk -F'\t' -v t="$1" -v n="$2" '$1==t && $2==n {print $4"\t"NR"\t"$3}' "$f" \
    | sort -t"$(printf '\t')" -k1,1nr -k2,2nr \
    | awk -F'\t' '!seen[$3]++ { print $3 }'
}

# Record the use of a username for (tailnet, node) with a timestamp.
ssh_hist_record() { # $1=tailnet  $2=node  $3=username
  [[ -z "$3" ]] && return 0
  local f; f="$(ssh_hist_file)"
  mkdir -p "$(dirname "$f")"
  printf '%s\t%s\t%s\t%s\n' "$1" "$2" "$3" "$(date +%s)" >>"$f"
  chmod 600 "$f" 2>/dev/null || true
}

# ------------------------------------------------------------------------------
# Add hosts — Manual
# ------------------------------------------------------------------------------
# Manual host entry (form). Everything optional except Host.
ssh_add_manual() {
  sep
  command -v dialog &>/dev/null || { warn "dialog not available"; return; }

  local out
  out=$(dialog \
    --clear --colors \
    --backtitle "$BACKTITLE" \
    --title " SSH · Manual " \
    --form "Define a host. Only 'Host' is required.\n(empty HostName = Host · empty User = $USER)" \
    16 64 5 \
    "Host"         1 1 "" 1 16 40 0 \
    "HostName"     2 1 "" 2 16 40 0 \
    "User"         3 1 "" 3 16 40 0 \
    "Port"         4 1 "" 4 16 40 0 \
    "IdentityFile" 5 1 "" 5 16 40 0 \
    3>&1 1>&2 2>&3) || { clear; skip "Cancelled."; return; }
  clear

  local host hostname user port idfile
  { IFS= read -r host; IFS= read -r hostname; IFS= read -r user; IFS= read -r port; IFS= read -r idfile; } <<<"$out"
  host="$(trim "$host")"
  hostname="$(trim "$hostname")"
  user="$(trim "$user")"
  port="$(trim "$port")"
  idfile="$(trim "$idfile")"

  if [[ -z "$host" ]]; then
    warn "Empty Host — nothing to do."
    return
  fi
  [[ -z "$hostname" ]] && hostname="$host"
  [[ -z "$user" ]] && user="$USER"

  local block="Host $host"$'\n'"    HostName $hostname"$'\n'"    User $user"$'\n'
  [[ -n "$port" ]] && block+="    Port $port"$'\n'
  [[ -n "$idfile" ]] && block+="    IdentityFile $idfile"$'\n'

  printf '%s' "$block" | ssh_upsert_hosts "manual"
  ok "Host '$host' saved to config.local (group: manual)"
}

# ------------------------------------------------------------------------------
# Add hosts — Tailscale autocomplete
# ------------------------------------------------------------------------------
ssh_add_tailscale() {
  sep
  command -v dialog &>/dev/null || { warn "dialog not available"; return; }
  command -v tailscale &>/dev/null || { warn "tailscale is not installed"; return; }

  # --- pick a tailnet (profile) --------------------------------------------
  # `tailscale switch --list`: ID  Tailnet(name)  Account(* = active).
  # tailscale está instalado pero a veces no se ven las tailnets porque el
  # usuario no es 'operator'. Si pasa, ejecutamos 'sudo tailscale set
  # --operator' una vez y reintentamos la detección.
  local cur_id="" sw line lid lname attempt operator_fixed=false
  local ts_items=()
  local -A TS_NAME=()
  for attempt in 1 2; do
    ts_items=()
    TS_NAME=()
    if tailscale status &>/dev/null; then
      sw="$(tailscale switch --list 2>/dev/null)"
      cur_id="$(awk 'NR>1 && index($0,"*"){print $1}' <<<"$sw")"
      while IFS= read -r line; do
        [[ "$line" == ID* ]] && continue
        [[ -z "${line// /}" ]] && continue
        lid="${line%% *}"
        lname="$(awk '{print $2}' <<<"$line")"
        TS_NAME["$lid"]="$lname"
        [[ "$lid" == "$cur_id" ]] && lname="$lname [active]"
        ts_items+=("$lid" "$lname")
      done <<<"$sw"
    fi

    [[ ${#ts_items[@]} -gt 0 ]] && break

    # No se detectó ninguna tailnet: intentamos arreglar el operador una vez.
    if [[ "$operator_fixed" == false ]] && ssh_tailscale_fix_operator; then
      operator_fixed=true
      continue
    fi
    break
  done

  if [[ ${#ts_items[@]} -eq 0 ]]; then
    warn "No se detectaron tailnets. ¿Sesión iniciada? — tailscale up / tailscale login"
    return
  fi

  local chosen_id
  if [[ ${#ts_items[@]} -eq 2 ]]; then
    chosen_id="${ts_items[0]}"     # single profile: use it without asking
  else
    chosen_id=$(dialog \
      --clear --colors \
      --backtitle "$BACKTITLE" \
      --title " SSH · Tailscale " \
      --default-item "$cur_id" \
      --menu "Pick the tailnet whose nodes you want to autodetect:" \
      14 70 6 \
      "${ts_items[@]}" \
      3>&1 1>&2 2>&3) || { clear; skip "Cancelled."; return; }
    clear
  fi

  local tailnet_name="${TS_NAME[$chosen_id]:-$chosen_id}"

  # If the chosen one is not the active profile, switch to it (no restore).
  if [[ -n "$chosen_id" && "$chosen_id" != "$cur_id" ]]; then
    info "Switching to tailnet '$tailnet_name' (tailscale switch $chosen_id)..."
    if ! tailscale switch "$chosen_id" &>/dev/null; then
      warn "Could not switch to tailnet '$tailnet_name'."
      return
    fi
    tailscale status &>/dev/null || sleep 1
    ok "Active tailnet now: $tailnet_name"
  fi

  local peers; peers="$(ssh_tailscale_peers)"
  if [[ -z "${peers//[$' \t\n']/}" ]]; then
    warn "No peers found in your tailnet."
    return
  fi

  local items=() name state
  while IFS=$'\t' read -r name state; do
    [[ -z "$name" ]] && continue
    items+=("$name" "$state" "off")
  done <<<"$peers"

  local count=$((${#items[@]} / 3))
  local list_height="$count"
  [[ $list_height -gt 14 ]] && list_height=14
  [[ $list_height -lt 4 ]] && list_height=4
  local win_height=$((list_height + 9))
  [[ $win_height -gt 22 ]] && win_height=22

  local raw
  raw=$(dialog \
    --clear --colors \
    --backtitle "$BACKTITLE" \
    --title " SSH · Tailscale " \
    --separate-output \
    --checklist \
    "Select the nodes to add  [SPACE=toggle  ENTER=confirm]\n\nYou'll then set the User for each node (with carry-over)." \
    "$win_height" 64 "$list_height" \
    "${items[@]}" \
    3>&1 1>&2 2>&3) || { clear; skip "Cancelled."; return; }
  clear

  local chosen=()
  while IFS= read -r name; do
    [[ -n "$name" ]] && chosen+=("$name")
  done <<<"$raw"
  if [[ ${#chosen[@]} -eq 0 ]]; then
    warn "No nodes selected."
    return
  fi

  # User per node. Default priority: node history (most recent) > session carry
  # ($last_user, starts at $USER). If the node has history, a selector of the
  # usernames used before is shown + "type another". Every choice is recorded.
  local total=${#chosen[@]} last_user="$USER" blocks="" n u idx=0
  for n in "${chosen[@]}"; do
    idx=$((idx + 1))

    local -a hist=()
    local hu
    while IFS= read -r hu; do [[ -n "$hu" ]] && hist+=("$hu"); done < <(ssh_hist_users "$tailnet_name" "$n")
    local recent="${hist[0]:-}"

    u=""
    if [[ ${#hist[@]} -gt 0 ]]; then
      local menu_items=()
      for hu in "${hist[@]}"; do menu_items+=("$hu" "used before"); done
      menu_items+=("+" "✎ Type another username…")
      local lh=$((${#hist[@]} + 1))
      [[ $lh -gt 10 ]] && lh=10
      # Window must fit the 3-line prompt + the full list (no scroll) + buttons.
      local win=$((lh + 10))

      local pick
      pick=$(dialog \
        --clear --colors \
        --backtitle "$BACKTITLE" \
        --title " SSH · Tailscale " \
        --default-item "$recent" \
        --menu "User for '$n'   ($idx/$total)\n\nPick a username already used on this node, or type another:" \
        "$win" 64 "$lh" \
        "${menu_items[@]}" \
        3>&1 1>&2 2>&3) || { clear; skip "Cancelled."; return; }
      clear

      if [[ "$pick" == "+" ]]; then
        u=$(dialog \
          --clear --colors \
          --backtitle "$BACKTITLE" \
          --title " SSH · Tailscale " \
          --inputbox "New User for '$n'   ($idx/$total)" \
          9 64 "$recent" \
          3>&1 1>&2 2>&3) || { clear; skip "Cancelled."; return; }
        clear
      else
        u="$pick"
      fi
    else
      u=$(dialog \
        --clear --colors \
        --backtitle "$BACKTITLE" \
        --title " SSH · Tailscale " \
        --inputbox "User for '$n'   ($idx/$total)\n\n(no history for this node · Enter = '$last_user')" \
        10 64 "$last_user" \
        3>&1 1>&2 2>&3) || { clear; skip "Cancelled."; return; }
      clear
    fi

    u="$(trim "$u")"
    [[ -z "$u" ]] && u="${recent:-$last_user}"
    last_user="$u"
    ssh_hist_record "$tailnet_name" "$n" "$u"
    blocks+="Host $n"$'\n'"    HostName $n"$'\n'"    User $u"$'\n'
  done

  printf '%s' "$blocks" | ssh_upsert_hosts "tailnet:$tailnet_name"
  ok "$total host(s) from '$tailnet_name' saved"
}

# ------------------------------------------------------------------------------
# Menu
# ------------------------------------------------------------------------------
ssh_menu() {
  while true; do
    local choice
    choice=$(dialog \
      --clear --colors \
      --backtitle "$BACKTITLE" \
      --title " Configure SSH " \
      --menu "\ZbSelect an action:\ZB" \
      14 64 5 \
      "1" "Control dir (~/.ssh/cm) + ensure config.local" \
      "2" "Add server — Manual" \
      "3" "Add servers — Autocomplete (Tailscale)" \
      "b" "Back" \
      3>&1 1>&2 2>&3) || break

    print_header
    case "$choice" in
    1) (setup_ssh) || true ;;
    2) (ssh_add_manual) || true ;;
    3) (ssh_add_tailscale) || true ;;
    b | B) break ;;
    esac

    [[ "$choice" == "b" || "$choice" == "B" ]] && break
    echo
    read -rp "  Press ENTER to continue..." _
  done
}

# ------------------------------------------------------------------------------
# Main
# ------------------------------------------------------------------------------
main() {
  case "$MODE" in
  setup)
    setup_ssh
    ;;
  menu)
    command -v dialog &>/dev/null || die "dialog not found. Install it: sudo apt install dialog"
    ssh_menu
    ;;
  esac
}

main
