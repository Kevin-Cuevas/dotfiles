#!/usr/bin/env bash
# Keeps tmux's status bar theme in sync with the system light/dark
# preference for the lifetime of the login session. Applies the current
# theme once, then re-applies it every time the freedesktop portal reports
# a color-scheme change (same signal auto-dark-mode.nvim listens for).
set -euo pipefail

sync_bin="$HOME/.local/bin/tmux-theme-sync"

"$sync_bin"

dbus-monitor --session \
  "type=signal,interface=org.freedesktop.portal.Settings,member=SettingChanged,path=/org/freedesktop/portal/desktop,arg0='org.freedesktop.appearance',arg1='color-scheme'" |
while read -r line; do
  case "$line" in
    *member=SettingChanged*) "$sync_bin" ;;
  esac
done
