#!/usr/bin/env bash
# dev-packages — front door for every non-apt tool (nvim, tmux, kitty, yazi,
# tree-sitter, peaclock, tmuxp, lavat, pgcli, mycli, csvkit): two `dialog`
# checklists in sequence (build/tarball, then pipx) that install or update
# whatever the user checks. Standalone, like dev-ssh/dev-motd: it doesn't
# depend on bootstrap.d/*.sh or $DOTFILES_DIR, so it also runs on its own once
# stowed into ~/.local/bin.
#
# Each installer decides "is it already up to date?" with the best signal
# available for that tool:
#   - nvim    -> build/tarball + version detection (runs in its own subshell
#                with `set -e`, see install_nvim below).
#   - tmux    -> build from source + latest git tag vs. installed version
#                (same pattern as nvim, see install_tmux below).
#   - yazi, tree-sitter -> binary from the latest GitHub release, version of
#                the downloaded binary vs. the installed one
#                (github_release_install).
#   - kitty   -> official current-version.txt vs. the installed one; if
#                needed, re-runs the official installer (in place, safe).
#   - tmuxp/pgcli/mycli/csvkit -> pipx install / pipx upgrade (see
#                install_via_pipx below). If pipx isn't installed,
#                dev-packages installs it via apt on its own before touching
#                any of the four.
#   - peaclock/lavat -> they don't publish versions (git+build only), so the
#                remote HEAD SHA is compared against one saved in
#                ~/.local/share/dev-packages/<tool>.sha after the last build.
#
# nvim, tmux and tree-sitter also have an apt package: by default, installing
# them through dev-packages removes the apt version (see KEEP_APT_PKGS /
# --keep-apt below) so only one version is left in PATH.
#
# Everything temporary (downloads, clones, builds) lives in a single WORK_DIR
# that a trap deletes on exit, Ctrl-C included: no installer cleans up by hand.
#
# Usage:
#   dev-packages                 interactive checklist (dialog)
#   dev-packages --all           install/update everything, no dialogs
#   dev-packages --only=a,b,c    install/update only those keys, no dialogs
#   dev-packages --keep-apt      don't purge the same-named apt package
#                                (nvim/tmux/tree-sitter), keep both installed
#   dev-packages -h | --help     this help
set -uo pipefail

# ─── helpers (same style as bootstrap.d/00-core.sh) ──────────────────────────
RED='\e[38;2;191;97;106m'
GRN='\e[38;2;163;190;140m'
YLW='\e[38;2;235;203;139m'
BLU='\e[38;2;136;192;208m'
CYN='\e[38;2;143;188;187m'
DIM='\e[38;2;94;129;172m'
# shellcheck disable=SC2034 # Nord palette shared across scripts; unused here
BLD='\e[1m'
RST='\e[0m'

info() { printf "${BLU}[INFO]${RST}  %s\n" "$*"; }
ok() { printf "${GRN}[OK]${RST}    %s\n" "$*"; }
err() { printf "${RED}[ERR]${RST}   %s\n" "$*" >&2; }
warn() { printf "${YLW}[WARN]${RST}  %s\n" "$*"; }
skip() { printf "${CYN}[SKIP]${RST}  %s\n" "$*"; }
sep() { printf "${DIM}%s${RST}\n" "  ──────────────────────────────────────────────────"; }

# Fatal only inside the installers that run in their own subshell
# (install_nvim / install_tmux): `exit` leaves that subshell, not the script.
die() {
  err "$*"
  exit 1
}

NONINTERACTIVE="${NONINTERACTIVE:-false}"
BACKTITLE="${DEV_PACKAGES_BACKTITLE:-dev-packages · $(hostname) · $(date '+%Y-%m-%d %H:%M')}"
STATE_DIR="$HOME/.local/share/dev-packages"

# ─── registry ───────────────────────────────────────────────────────────────
PKG_KEYS=(nvim tmux kitty yazi tree-sitter peaclock tmuxp lavat pgcli mycli csvkit)
declare -A PKG_LABEL=(
  [nvim]="Neovim (build/tarball + version-checked)"
  [tmux]="tmux (terminal multiplexer, built from source, version-checked)"
  [kitty]="kitty (official installer, version-checked)"
  [yazi]="Yazi (file manager, GitHub release, version-checked)"
  ["tree-sitter"]="tree-sitter CLI (nvim-treesitter parsers, GitHub release)"
  [peaclock]="Peaclock (terminal clock, built from source, sha-checked)"
  [tmuxp]="tmuxp (tmux session manager, pipx install/upgrade)"
  [lavat]="lavat (terminal lava lamp, built from source, sha-checked)"
  [pgcli]="pgcli (Postgres client, pipx install/upgrade)"
  [mycli]="mycli (MySQL/MariaDB client, pipx install/upgrade)"
  [csvkit]="csvkit (CSV command-line utilities, pipx install/upgrade)"
)
declare -A PKG_FN=(
  [nvim]="install_nvim"
  [tmux]="install_tmux"
  [kitty]="install_kitty"
  [yazi]="install_yazi"
  ["tree-sitter"]="install_tree_sitter"
  [peaclock]="install_peaclock"
  [tmuxp]="install_tmuxp"
  [lavat]="install_lavat"
  [pgcli]="install_pgcli"
  [mycli]="install_mycli"
  [csvkit]="install_csvkit"
)

# Which checklist (step) each key belongs to: "build" is shown first, "pipx"
# second. See select_group/select_packages below.
declare -A PKG_GROUP=(
  [nvim]="build"
  [tmux]="build"
  [kitty]="build"
  [yazi]="build"
  ["tree-sitter"]="build"
  [peaclock]="build"
  [lavat]="build"
  [tmuxp]="pipx"
  [pgcli]="pipx"
  [mycli]="pipx"
  [csvkit]="pipx"
)
GROUP_ORDER=(build pipx)
declare -A GROUP_TITLE=(
  [build]="build / tarball"
  [pipx]="pipx"
)
declare -A GROUP_PROMPT=(
  [build]="Select build/tarball tools to install/update  [SPACE=toggle  ENTER=confirm]\n\nLeave everything unchecked and press ENTER to install/update ALL of this group.\nCheck 'Skip' to skip this group."
  [pipx]="Select pipx-managed CLIs to install/update  [SPACE=toggle  ENTER=confirm]\n\nLeave everything unchecked and press ENTER to install/update ALL of this group.\nCheck 'Skip' to skip this group."
)

# ─── single-group checklist (build or pipx) ─────────────────────────────────
select_group() {
  local _group="$1"
  local -n _grp_out="$2"
  _grp_out=()

  local _items=("__skip__" "Skip -- install none from this group" "off")
  local _key
  for _key in "${PKG_KEYS[@]}"; do
    [[ "${PKG_GROUP[$_key]}" == "$_group" ]] || continue
    _items+=("$_key" "${PKG_LABEL[$_key]}" "off")
  done

  local _raw
  _raw=$(dialog --clear --colors --backtitle "$BACKTITLE" \
    --title " dev-packages · ${GROUP_TITLE[$_group]} " --separate-output --checklist \
    "${GROUP_PROMPT[$_group]}" \
    18 72 10 "${_items[@]}" \
    3>&1 1>&2 2>&3) || return 1

  clear

  local _raw_chosen=() _line
  while IFS= read -r _line; do [[ -n "$_line" ]] && _raw_chosen+=("$_line"); done <<<"$_raw"

  for _line in "${_raw_chosen[@]}"; do
    [[ "$_line" == "__skip__" ]] && {
      _grp_out=()
      return 0
    }
  done

  if [[ ${#_raw_chosen[@]} -eq 0 ]]; then
    local _all=()
    for _key in "${PKG_KEYS[@]}"; do
      [[ "${PKG_GROUP[$_key]}" == "$_group" ]] && _all+=("$_key")
    done
    _grp_out=("${_all[@]}")
  else
    _grp_out=("${_raw_chosen[@]}")
  fi
}

# ─── our own checklist: one dialog per group, in GROUP_ORDER order ─────────
# Esc in any of them cancels dev-packages entirely (same behavior the old
# single checklist had); "Skip" only skips that one group and moves on to the
# next. A new group is registered only in GROUP_ORDER/GROUP_TITLE/
# GROUP_PROMPT; nothing needs to change here.
select_packages() {
  local -n _out_ref="$1"
  _out_ref=()

  local _group _chosen=()
  for _group in "${GROUP_ORDER[@]}"; do
    select_group "$_group" _chosen || return 1
    _out_ref+=("${_chosen[@]}")
  done
}

# ─── utilities shared by the installers ─────────────────────────────────────

# Remote HEAD SHA of a git repo (peaclock/lavat don't publish versions).
remote_head_sha() {
  git ls-remote "$1" HEAD 2>/dev/null | awk '{print $1}'
}

# Fails with a useful message if a tool is missing. $2 = apt package, if it
# isn't named like the command.
need_cmd() {
  command -v "$1" &>/dev/null && return 0
  err "$1 not found — install it first (sudo apt install ${2:-$1})."
  return 1
}

# Yes/No with dialog; without dialog, asks in plain text. Default: No.
ask_yes_no() {
  if command -v dialog &>/dev/null; then
    local rc=0
    dialog --clear --backtitle "$BACKTITLE" --title " Confirm " --defaultno \
      --yesno "$1" 8 72 || rc=$?
    clear
    return "$rc"
  fi
  warn "$1 [y/N]"
  local reply
  read -r reply
  [[ "$reply" =~ ^[yY]$ ]]
}

# Go ahead with the install? $1=name $2=installed version (empty if none)
# $3=candidate version. Different -> yes. Equal -> non-interactive mode
# reinstalls (as --all always did); interactive mode asks.
# 0 = go ahead, 1 = the user doesn't want to reinstall the same version.
confirm_version() {
  local name="$1" current="$2" new="$3"
  if [[ -z "$current" || "$current" != "$new" ]]; then
    info "Updating $name: ${current:-<none>} → ${new:-<unknown>}"
    return 0
  fi
  if [[ "$NONINTERACTIVE" == "true" ]]; then
    info "Non-interactive — reinstalling the same version ($new)."
    return 0
  fi
  ask_yes_no "You already have $new installed.\n\nInstall anyway?"
}

# Keeps the sudo ticket alive during long builds. The loop's PID goes to a
# file in WORK_DIR, not a variable: install_nvim/install_tmux call it from
# their subshell, and a variable wouldn't make it back to the parent process
# (the one that kills it in cleanup). The loop also ends on its own if the
# script dies, even with kill -9: `kill -0 $$` stops answering.
sudo_keepalive() {
  local pidfile="$WORK_DIR/sudo-keepalive.pid"
  [[ -f "$pidfile" ]] && kill -0 "$(<"$pidfile")" 2>/dev/null && return 0
  info "Administrator privileges required..."
  sudo -v || return 1
  (while kill -0 "$$" 2>/dev/null; do
    sudo -n true
    sleep 55
  done) &
  echo "$!" >"$pidfile"
}

# Purges the same-named apt package (nvim/tmux/tree-sitter) so only the
# dev-packages version is left in PATH. KEEP_APT_PKGS=true (or --keep-apt)
# keeps it installed instead of purging it.
KEEP_APT_PKGS="${KEEP_APT_PKGS:-false}"
remove_apt_if_present() {
  local pkg="$1"
  if dpkg -s "$pkg" &>/dev/null; then
    if [[ "$KEEP_APT_PKGS" == "true" ]]; then
      warn "$pkg is still installed via apt (KEEP_APT_PKGS=true) — there may be two binaries in PATH."
      return 0
    fi
    info "Removing $pkg installed via apt..."
    sudo apt-get remove --purge -y "$pkg"
    sudo apt-get autoremove -y
  else
    ok "$pkg isn't installed via apt"
  fi
}

# Puts a finished install (STAGED, built as the user in WORK_DIR and already
# smoke-tested) at PREFIX, keeping the old one until the very end:
#   swap_prefix STAGED PREFIX
# nvim/tmux used to do it the other way around: rm -rf PREFIX and purge apt
# first, then `make install` — when the install step failed there was no
# nvim/tmux left at all. Now it's copied as root to PREFIX.new (same
# filesystem as PREFIX, so the swap is two renames), the old one goes to
# PREFIX.old, the new one takes its place and .old is dropped. If the second
# rename fails the old install is put back. Leftovers from an interrupted run
# are cleared first.
swap_prefix() {
  local staged="$1" prefix="${2:?}"
  sudo rm -rf -- "$prefix.new" "$prefix.old" || return 1
  if ! { sudo cp -a -- "$staged" "$prefix.new" && sudo chown -R root:root -- "$prefix.new"; }; then
    err "Couldn't copy the new install to $prefix.new"
    sudo rm -rf -- "$prefix.new"
    return 1
  fi
  if [[ -e "$prefix" ]] && ! sudo mv -- "$prefix" "$prefix.old"; then
    err "Couldn't move the current $prefix aside"
    sudo rm -rf -- "$prefix.new"
    return 1
  fi
  if ! sudo mv -- "$prefix.new" "$prefix"; then
    err "Couldn't put the new install in place — restoring the previous one"
    if [[ -e "$prefix.old" ]]; then sudo mv -- "$prefix.old" "$prefix"; fi
    sudo rm -rf -- "$prefix.new"
    return 1
  fi
  sudo rm -rf -- "$prefix.old"
}

# A binary's version: the first `--version` line that has a number, without
# indentation. Blindly taking the first line doesn't work: yazi 26+ prints
# just "Yazi" on the first one and "Version: 26.9.1 (...)" further down, so
# every version looked equal to the installed one. The output is captured in
# full before filtering so a SIGPIPE isn't read as "the binary doesn't run".
bin_version() {
  local out
  out="$("$1" --version 2>/dev/null)" || return 1
  grep -m1 '[0-9]' <<<"$out" | sed 's/^[[:space:]]*//'
}

# Extracts an asset by its extension into $2 (a bare .gz: in place).
extract() {
  case "$1" in
    *.zip) need_cmd unzip && unzip -q -o "$1" -d "$2" ;;
    *.tar.gz | *.tgz) tar -xzf "$1" -C "$2" ;;
    *.gz) gunzip -f "$1" ;;
    *)
      err "Unsupported asset format: $1"
      return 1
      ;;
  esac
}

# Installs binaries from the latest GitHub release into ~/.local/bin.
#   github_release_install [--purge-apt=PKG] REPO ASSET BIN[:DEST]...
# Each BIN is a path inside the extracted asset; DEST is the final name
# (default: BIN's basename). The first one defines the tool: its `--version`
# (the freshly downloaded binary vs. the installed one) decides whether
# ~/.local/bin needs touching. If the downloaded binary doesn't run on this
# host (e.g. it needs a newer glibc), it aborts without touching anything.
# --purge-apt purges that apt package ONLY after a real install: if the user
# chose not to reinstall, the binary in use might be the apt one.
github_release_install() {
  local purge_apt=""
  if [[ "$1" == --purge-apt=* ]]; then
    purge_apt="${1#--purge-apt=}"
    shift
  fi
  local repo="$1" asset="$2"
  shift 2
  local specs=("$@") spec src dst

  local name="${specs[0]#*:}"
  name="${name##*/}"

  local dir
  dir="$(mktemp -d -p "$WORK_DIR" "$name.XXXXXX")" || return 1

  local url="https://github.com/$repo/releases/latest/download/$asset"
  info "Downloading $url ..."
  if ! curl -fL --progress-bar -o "$dir/$asset" "$url"; then
    err "Downloading $asset failed"
    return 1
  fi
  if ! extract "$dir/$asset" "$dir"; then
    err "Couldn't extract $asset"
    return 1
  fi

  for spec in "${specs[@]}"; do
    src="${spec%%:*}"
    if [[ ! -f "$dir/$src" ]]; then
      err "$src isn't in $asset"
      return 1
    fi
    chmod +x "$dir/$src"
  done

  local current="" new
  if command -v "$name" &>/dev/null; then
    current="$(bin_version "$name")"
  fi
  if ! new="$(bin_version "$dir/${specs[0]%%:*}")" || [[ -z "$new" ]]; then
    err "The downloaded $name doesn't run on this host (glibc $(ldd --version 2>/dev/null | awk 'NR == 1 {print $NF}'))."
    return 1
  fi

  if ! confirm_version "$name" "$current" "$new"; then
    skip "$name stays at $new"
    return 0
  fi

  mkdir -p "$HOME/.local/bin"
  for spec in "${specs[@]}"; do
    src="${spec%%:*}"
    dst="${spec#*:}"
    install -m 755 "$dir/$src" "$HOME/.local/bin/${dst##*/}"
  done
  ok "$name installed -> $HOME/.local/bin ($new)"
  if [[ -n "$purge_apt" ]]; then remove_apt_if_present "$purge_apt"; fi
}

# ─── installers ─────────────────────────────────────────────────────────────

# Installs/updates Neovim choosing between two methods:
#   - tarball : official prebuilt binary from the GitHub releases
#               (fast, safe, works on x86_64 and arm64).
#   - build   : compiles from source with -march=native (x86_64 only, optimized).
# Both methods install to /opt/nvim + a /usr/local/bin/nvim symlink, so they're
# INTERCHANGEABLE: reinstalling with the other method cleanly replaces the
# previous one. Non-interactive mode ALWAYS uses the safest method: tarball.
#
# Runs in its own subshell with `set -euo pipefail`: the simplest way for any
# step (download, build, cmake --install...) to abort this particular install
# without taking down the rest of dev-packages; die() leaves that subshell,
# not the script.
install_nvim() {
  sep
  (
    set -euo pipefail

    ARCH="$(uname -m)"
    NVIM_PREFIX="/opt/nvim"
    NVIM_SYMLINK="/usr/local/bin/nvim"

    case "$ARCH" in
      x86_64) TARBALL_ARCH="x86_64" ;;
      aarch64) TARBALL_ARCH="arm64" ;;
      *) TARBALL_ARCH="" ;;
    esac

    BUILD_SUPPORTED=false
    [[ "$ARCH" == "x86_64" ]] && BUILD_SUPPORTED=true

    sudo_keepalive || die "Can't install to $NVIM_PREFIX without administrator privileges"
    TMP_DIR="$(mktemp -d -p "$WORK_DIR" nvim.XXXXXX)"

    CHOSEN_METHOD=""
    choose_method() {
      CHOSEN_METHOD=""
      if command -v dialog &>/dev/null; then
        local choice rc
        if choice=$(dialog --clear --backtitle "$BACKTITLE" \
          --title " Install Neovim " \
          --ok-label "Install" --cancel-label "Cancel" \
          --menu "\nPick the install method:" \
          13 72 2 \
          "build" "Build from source  (-march=native, optimized)" \
          "tarball" "Official prebuilt tarball  (fast, safe)" \
          3>&1 1>&2 2>&3); then
          rc=0
        else
          rc=$?
        fi
        clear
        if ((rc == 0)); then CHOSEN_METHOD="$choice"; fi
        return 0
      fi
      echo ""
      echo "  Neovim install method:"
      echo "    1) build   — build from source (-march=native, optimized)"
      echo "    2) tarball — official prebuilt (fast, safe)"
      echo "    q) cancel"
      local choice
      read -rp "  Option [1/2/q]: " choice
      case "$choice" in
        1 | build | b) CHOSEN_METHOD="build" ;;
        2 | tarball | t) CHOSEN_METHOD="tarball" ;;
        q | Q | c | cancel) CHOSEN_METHOD="" ;;
        *) CHOSEN_METHOD="tarball" ;;
      esac
      return 0
    }

    CURRENT_VERSION="$(nvim --version 2>/dev/null | head -1 || true)"
    if [[ -n "$CURRENT_VERSION" ]]; then
      info "Current version: $CURRENT_VERSION"
    else
      warn "nvim not found, proceeding with the install..."
    fi

    get_source_version() {
      local cml="$1/CMakeLists.txt"
      [[ -f "$cml" ]] || {
        echo ""
        return
      }
      local maj min pat pre
      maj=$(grep -m1 -E 'set\(NVIM_VERSION_MAJOR' "$cml" | grep -oE '[0-9]+' | head -1)
      min=$(grep -m1 -E 'set\(NVIM_VERSION_MINOR' "$cml" | grep -oE '[0-9]+' | head -1)
      pat=$(grep -m1 -E 'set\(NVIM_VERSION_PATCH' "$cml" | grep -oE '[0-9]+' | head -1)
      pre=$(grep -m1 -E 'set\(NVIM_VERSION_PRERELEASE' "$cml" | sed -E 's/[^"]*"([^"]*)".*/\1/')
      [[ -n "$maj$min$pat" ]] || {
        echo ""
        return
      }
      echo "NVIM v${maj}.${min}.${pat}${pre}"
    }

    # The staged nvim (STAGED_DIR) runs and finds its OWN runtime: nvim
    # resolves $VIMRUNTIME relative to its binary, so this also proves it
    # will once it's at /opt/nvim — and that it didn't pick up the installed
    # one. --clean: the user config (LazyVim) isn't loaded.
    nvim_works() {
      # shellcheck disable=SC2016 # $VIMRUNTIME/$NVIM_STAGE are expanded by nvim, not bash
      NVIM_STAGE="$(readlink -f "$1")" "$1/bin/nvim" --clean --headless \
        -c 'if stridx($VIMRUNTIME, $NVIM_STAGE) != 0 || !filereadable($VIMRUNTIME .. "/filetype.lua") | cquit | endif' \
        -c 'qa!' </dev/null &>/dev/null
    }

    # apt's neovim is purged only after the swap: see swap_prefix.
    finalize() {
      nvim_works "$STAGED_DIR" \
        || die "The new nvim doesn't run or can't find its runtime — the installed one is untouched"
      info "Installing to $NVIM_PREFIX..."
      swap_prefix "$STAGED_DIR" "$NVIM_PREFIX" || die "Install to $NVIM_PREFIX failed"
      sudo ln -sf "$NVIM_PREFIX/bin/nvim" "$NVIM_SYMLINK"
      remove_apt_if_present neovim
      echo ""
      ok "Install complete: $("$NVIM_PREFIX/bin/nvim" --version | head -1)"
    }

    install_tarball() {
      [[ -n "$TARBALL_ARCH" ]] || die "There's no official tarball for the $ARCH architecture"

      info "Mode: install from the prebuilt tarball (${TARBALL_ARCH})"
      local tarball="nvim-linux-${TARBALL_ARCH}.tar.gz"
      local extract_dir="$TMP_DIR/nvim-linux-${TARBALL_ARCH}"

      info "Downloading $tarball..."
      curl -fL --progress-bar \
        "https://github.com/neovim/neovim/releases/download/stable/${tarball}" \
        -o "$TMP_DIR/$tarball" || die "Downloading the tarball failed"

      info "Extracting..."
      tar xzf "$TMP_DIR/$tarball" -C "$TMP_DIR"

      local new_version
      new_version=$("$extract_dir/bin/nvim" --version | head -1)

      confirm_version nvim "$CURRENT_VERSION" "$new_version" || return 1

      STAGED_DIR="$extract_dir"
    }

    install_build_deps() {
      info "Installing build dependencies..."
      if ! grep -qE '^deb-src' /etc/apt/sources.list /etc/apt/sources.list.d/*.list 2>/dev/null; then
        info "Enabling deb-src in sources.list..."
        sudo sed -i 's/^deb \(.*\)/deb \1\ndeb-src \1/' /etc/apt/sources.list
        sudo apt-get update -qq
      fi
      sudo apt-get build-dep -y neovim
      sudo apt-get install -y --no-install-recommends \
        git ninja-build curl ca-certificates cmake \
        libutf8proc-dev libluajit-5.1-dev
    }

    build_source() {
      info "Mode: build from source with native flags"

      if ! command -v git &>/dev/null; then
        info "git not found — installing it..."
        sudo apt-get install -y git
      fi

      local nvim_src="$TMP_DIR/neovim"
      info "Cloning the neovim repo (stable branch)..."
      git clone --depth 1 --branch stable \
        https://github.com/neovim/neovim.git "$nvim_src"
      git -C "$nvim_src" config advice.detachedHead false

      local new_version
      new_version=$(get_source_version "$nvim_src")

      confirm_version nvim "$CURRENT_VERSION" "$new_version" || return 1

      install_build_deps

      local gcc_major march_flag
      gcc_major=$(gcc -dumpversion | cut -d. -f1)
      if ((gcc_major >= 9)); then
        march_flag="-march=native"
      else
        warn "gcc $gcc_major < 9: using the -march=x86-64 baseline"
        march_flag="-march=x86-64"
      fi

      local native_cc append_flags cc_wrapper deps_dir build_dir nproc
      native_cc="$(command -v gcc)"
      append_flags="$march_flag -mtune=native -g -pipe"
      cc_wrapper="$TMP_DIR/cc-native"
      cat >"$cc_wrapper" <<EOF
#!/usr/bin/env bash
exec "$native_cc" "\$@" $append_flags
EOF
      chmod +x "$cc_wrapper"
      deps_dir="$nvim_src/.deps"
      build_dir="$nvim_src/build"
      nproc=$(nproc)

      info "Compiler: $native_cc ($(gcc --version | head -1))"
      info "Native flags (append): $append_flags"

      info "Building bundled dependencies (treesitter, luajit, luv...)..."
      cmake -S "$nvim_src/cmake.deps" -B "$deps_dir" \
        -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_C_COMPILER="$cc_wrapper" \
        -DCMAKE_C_FLAGS_RELEASE="-O3 -DNDEBUG" \
        -DUSE_BUNDLED=ON \
        -DUSE_BUNDLED_TS=ON \
        -DUSE_BUNDLED_LUAJIT=ON \
        -DUSE_BUNDLED_LUV=ON
      cmake --build "$deps_dir" --parallel "$nproc"

      info "Configuring the main build..."
      cmake -S "$nvim_src" -B "$build_dir" \
        -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_C_COMPILER="$cc_wrapper" \
        -DCMAKE_C_FLAGS_RELEASE="-O3 -DNDEBUG" \
        -DCMAKE_INSTALL_PREFIX="$NVIM_PREFIX" \
        -DCMAKE_PREFIX_PATH="$deps_dir/usr"

      info "Building with $nproc cores..."
      cmake --build "$build_dir" --parallel "$nproc"

      # DESTDIR: still built for /opt/nvim, but the files land in WORK_DIR
      # (no sudo); finalize swaps them in.
      info "Staging the install..."
      DESTDIR="$TMP_DIR/stage" cmake --install "$build_dir"
      STAGED_DIR="$TMP_DIR/stage$NVIM_PREFIX"

      info "Checking the new binary's flags..."
      local producer detected_march ymm
      producer=$(readelf -wi "$STAGED_DIR/bin/nvim" 2>/dev/null \
        | grep -am1 "DW_AT_producer" | sed -E 's/.*\): //')
      detected_march=$(grep -oE -- '-march=[^ ]+' <<<"$producer" | head -1)
      ymm=$(objdump -d "$STAGED_DIR/bin/nvim" 2>/dev/null | grep -c "ymm")
      case "$detected_march" in
        "" | "-march=x86-64")
          warn "The binary isn't optimized (${detected_march:-no -march}): ${producer:-<no DWARF>}"
          ;;
        *)
          ok "DWARF producer: ${detected_march} confirmed"
          ;;
      esac
      info "AVX2 instructions (ymm): $ymm"
    }

    if [[ "$NONINTERACTIVE" == "true" ]] || ! [ -t 0 ]; then
      info "Non-interactive mode — using the tarball (safe method)."
      METHOD="tarball"
    else
      choose_method
      METHOD="$CHOSEN_METHOD"
    fi

    if [[ -z "$METHOD" ]]; then
      info "Installation cancelled."
      exit 0
    fi

    if [[ "$METHOD" == "build" && "$BUILD_SUPPORTED" != "true" ]]; then
      warn "Building isn't supported on $ARCH — using the prebuilt tarball."
      METHOD="tarball"
    fi

    case "$METHOD" in
      build)
        if build_source; then
          finalize
        else
          info "Installation cancelled."
        fi
        ;;
      tarball)
        if install_tarball; then
          finalize
        else
          info "Installation cancelled."
        fi
        ;;
      *)
        die "Unknown method: $METHOD"
        ;;
    esac
  )
}

# Installs/updates tmux by building it from source. tmux doesn't publish
# prebuilt binaries in its GitHub releases (only source tarballs), so, unlike
# nvim, there's only one method here: build. The target version is fetched
# cheaply (no clone) with `git ls-remote --tags`, compared against `tmux -V`,
# and it only clones/builds/installs when needed.
#
# Same pattern as install_nvim: /opt/tmux prefix + /usr/local/bin/tmux
# symlink, its own subshell with `set -euo pipefail`, and it purges the
# same-named apt package by default (see remove_apt_if_present / KEEP_APT_PKGS).
install_tmux() {
  sep
  (
    set -euo pipefail

    TMUX_PREFIX="/opt/tmux"
    TMUX_SYMLINK="/usr/local/bin/tmux"
    TMUX_REPO="https://github.com/tmux/tmux.git"

    CURRENT_VERSION="$(tmux -V 2>/dev/null || true)"
    if [[ -n "$CURRENT_VERSION" ]]; then
      info "Current version: $CURRENT_VERSION"
    else
      warn "tmux not found, proceeding with the install..."
    fi

    info "Looking up the latest upstream tmux tag..."
    LATEST_TAG=$(git ls-remote --tags --refs "$TMUX_REPO" 2>/dev/null \
      | awk -F/ '{print $NF}' | grep -E '^[0-9]+\.[0-9]+[a-z]?$' | sort -V | tail -1)
    [[ -n "$LATEST_TAG" ]] || die "Couldn't determine the latest tmux tag"
    NEW_VERSION="tmux $LATEST_TAG"

    confirm_version tmux "$CURRENT_VERSION" "$NEW_VERSION" || {
      info "Installation cancelled."
      exit 0
    }

    sudo_keepalive || die "Can't install to $TMUX_PREFIX without administrator privileges"
    TMP_DIR="$(mktemp -d -p "$WORK_DIR" tmux.XXXXXX)"

    info "Installing build dependencies..."
    sudo apt-get install -y --no-install-recommends \
      build-essential libevent-dev libncurses-dev bison pkg-config \
      autoconf automake git

    info "Cloning tmux $LATEST_TAG..."
    git clone --depth 1 --branch "$LATEST_TAG" "$TMUX_REPO" "$TMP_DIR/tmux"

    info "Generating configure (autogen.sh)..."
    (cd "$TMP_DIR/tmux" && sh autogen.sh)

    info "Configuring the build (prefix: $TMUX_PREFIX)..."
    (cd "$TMP_DIR/tmux" && ./configure --prefix="$TMUX_PREFIX")

    nproc_count=$(nproc)
    info "Building with $nproc_count cores..."
    (cd "$TMP_DIR/tmux" && make -j"$nproc_count")

    # DESTDIR: still built for /opt/tmux, but staged in WORK_DIR (no sudo)
    # and smoke-tested before swap_prefix touches the installed one; apt's
    # tmux is purged only after the swap.
    info "Staging the install..."
    (cd "$TMP_DIR/tmux" && make install DESTDIR="$TMP_DIR/stage")
    STAGED_DIR="$TMP_DIR/stage$TMUX_PREFIX"
    "$STAGED_DIR/bin/tmux" -V &>/dev/null \
      || die "The new tmux doesn't run — the installed one is untouched"

    info "Installing to $TMUX_PREFIX..."
    swap_prefix "$STAGED_DIR" "$TMUX_PREFIX" || die "Install to $TMUX_PREFIX failed"
    sudo ln -sf "$TMUX_PREFIX/bin/tmux" "$TMUX_SYMLINK"
    remove_apt_if_present tmux
    echo ""
    ok "Install complete: $("$TMUX_PREFIX/bin/tmux" -V)"
  )
}

# Installs/updates kitty through the official installer (no apt package:
# Debian's version usually lags far behind). The installer replaces
# ~/.local/kitty.app in place without touching symlinks or .desktop files, but
# downloads the whole bundle every time: so it's compared first against
# current-version.txt, which kitty publishes for exactly this. The installer
# is downloaded to a file and then run — never `curl | sh`: without -f, an
# HTTP error ended up executed by sh, and a cut-off download would run
# half-way.
install_kitty() {
  sep
  local current="" latest
  if command -v kitty &>/dev/null; then
    current="kitty $(kitty --version 2>/dev/null | awk '{print $2}')"
  fi

  if latest="$(curl -fsSL https://sw.kovidgoyal.net/kitty/current-version.txt)" && [[ -n "$latest" ]]; then
    if ! confirm_version kitty "$current" "kitty $latest"; then
      skip "kitty stays at kitty $latest"
      return 0
    fi
  else
    warn "Couldn't look up the latest kitty version — running the installer anyway."
  fi

  local installer="$WORK_DIR/kitty-installer.sh"
  if ! curl -fsSL -o "$installer" https://sw.kovidgoyal.net/kitty/installer.sh; then
    err "Downloading the kitty installer failed"
    return 1
  fi
  if ! sh "$installer"; then
    err "The kitty installer failed"
    return 1
  fi
  ok "kitty installed/updated -> $HOME/.local/kitty.app"
}

# yazi (terminal file manager): official binary; the zip ships yazi and ya.
install_yazi() {
  sep
  local triple
  case "$(uname -m)" in
    x86_64) triple="x86_64-unknown-linux-gnu" ;;
    aarch64) triple="aarch64-unknown-linux-gnu" ;;
    *)
      warn "yazi doesn't publish a binary for $(uname -m) — skipping."
      return 1
      ;;
  esac
  github_release_install sxyazi/yazi "yazi-$triple.zip" "yazi-$triple/yazi" "yazi-$triple/ya"
}

# tree-sitter CLI: nvim-treesitter (main branch, LazyVim 15+) needs it to
# compile parsers and asks for a recent version that older Debians' apt
# doesn't ship. The upstream binary needs glibc >= 2.39; if it doesn't run
# here, github_release_install aborts without touching anything. After
# installing, it purges apt's tree-sitter-cli so only ~/.local/bin/tree-sitter
# is left.
install_tree_sitter() {
  sep
  local arch
  case "$(uname -m)" in
    x86_64) arch="x64" ;;
    aarch64) arch="arm64" ;;
    *)
      warn "tree-sitter doesn't publish a binary for $(uname -m) — skipping."
      return 1
      ;;
  esac
  github_release_install --purge-apt=tree-sitter-cli tree-sitter/tree-sitter \
    "tree-sitter-linux-$arch.gz" "tree-sitter-linux-$arch:tree-sitter" || {
    warn "If the binary doesn't run here: cargo install --locked tree-sitter-cli"
    return 1
  }
}

# Makes sure pipx is installed before using it. If it's missing, it installs it
# via apt on its own (on Debian/Ubuntu that pulls in python3-venv as a
# dependency) instead of failing and asking the user to install it by hand.
# Idempotent: if it already exists, it does nothing.
ensure_pipx() {
  command -v pipx &>/dev/null && return 0
  info "pipx not found — installing it via apt..."
  sudo apt-get install -y pipx || {
    err "'apt-get install pipx' failed"
    return 1
  }
  pipx ensurepath &>/dev/null || true
  ok "pipx installed -> $(command -v pipx)"
}

# Generic install/upgrade through pipx: shared by tmuxp/pgcli/mycli (and any
# Python CLI added later). pipx has its own update mechanism — we use it
# directly instead of reimplementing version detection.
install_via_pipx() {
  local pkg="$1"
  ensure_pipx || return 1

  if command -v "$pkg" &>/dev/null; then
    info "Updating $pkg via pipx..."
    if ! pipx upgrade "$pkg"; then
      err "'pipx upgrade $pkg' failed"
      return 1
    fi
    ok "$pkg updated -> $(command -v "$pkg")"
  else
    info "Installing $pkg via pipx..."
    if ! pipx install "$pkg" &>/dev/null; then
      err "'pipx install $pkg' failed"
      return 1
    fi
    ok "$pkg installed via pipx -> $HOME/.local/bin/$pkg"
  fi
}

install_tmuxp() {
  sep
  install_via_pipx tmuxp
}

install_pgcli() {
  sep
  install_via_pipx pgcli
}

install_mycli() {
  sep
  install_via_pipx mycli
}

install_csvkit() {
  sep
  install_via_pipx csvkit
}

# Builds peaclock (a pretty terminal clock) from source. There's no official
# binary or versioned releases, so "is there an update?" is decided by
# comparing the remote HEAD SHA against the one saved after the last
# successful build — if it didn't change, rebuilding isn't worth it.
install_peaclock() {
  sep
  local repo="https://github.com/octobanana/peaclock"
  local state_file="$STATE_DIR/peaclock.sha"
  local remote_sha local_sha=""
  remote_sha="$(remote_head_sha "$repo")"
  [[ -f "$state_file" ]] && local_sha="$(<"$state_file")"

  if command -v peaclock &>/dev/null && [[ -n "$remote_sha" && "$remote_sha" == "$local_sha" ]]; then
    skip "peaclock is already up to date ($(command -v peaclock), $remote_sha)"
    return 0
  fi

  need_cmd git || return 1
  need_cmd cmake || return 1
  dpkg -s libicu-dev &>/dev/null || {
    err "ICU is missing — install libicu-dev first (sudo apt install libicu-dev)."
    return 1
  }

  local src
  src="$(mktemp -d -p "$WORK_DIR" peaclock.XXXXXX)" || return 1

  info "Cloning peaclock..."
  if ! git clone --depth=1 "$repo" "$src" &>/dev/null; then
    err "Cloning peaclock failed"
    return 1
  fi

  info "Building peaclock (RUNME.sh build)..."
  if ! (cd "$src" && ./RUNME.sh build --release) &>/dev/null; then
    err "Building peaclock failed"
    return 1
  fi

  info "Installing peaclock (RUNME.sh install)..."
  if ! (cd "$src" && ./RUNME.sh install --release); then
    err "Installing peaclock failed"
    return 1
  fi

  mkdir -p "$STATE_DIR"
  [[ -n "$remote_sha" ]] && echo "$remote_sha" >"$state_file"
  ok "peaclock installed/updated -> $(command -v peaclock)"
}

# Builds lavat (a terminal lava lamp) from source — same approach as peaclock:
# no versioned releases, so the remote HEAD SHA is compared.
install_lavat() {
  sep
  local repo="https://github.com/AngelJumbo/lavat"
  local state_file="$STATE_DIR/lavat.sha"
  local remote_sha local_sha=""
  remote_sha="$(remote_head_sha "$repo")"
  [[ -f "$state_file" ]] && local_sha="$(<"$state_file")"

  if command -v lavat &>/dev/null && [[ -n "$remote_sha" && "$remote_sha" == "$local_sha" ]]; then
    skip "lavat is already up to date ($(command -v lavat), $remote_sha)"
    return 0
  fi

  need_cmd git || return 1

  local src
  src="$(mktemp -d -p "$WORK_DIR" lavat.XXXXXX)" || return 1

  info "Cloning lavat..."
  if ! git clone --depth=1 "$repo" "$src" &>/dev/null; then
    err "Cloning lavat failed"
    return 1
  fi

  info "Building lavat (make)..."
  if ! (cd "$src" && make) &>/dev/null; then
    err "Building lavat failed"
    return 1
  fi

  info "Installing lavat (sudo make install)..."
  if ! (cd "$src" && sudo make install) &>/dev/null; then
    err "lavat's 'sudo make install' failed"
    return 1
  fi

  mkdir -p "$STATE_DIR"
  [[ -n "$remote_sha" ]] && echo "$remote_sha" >"$state_file"
  ok "lavat installed/updated -> $(command -v lavat)"
}

# ─── help ───────────────────────────────────────────────────────────────────
# Prints the "# Usage:" block from this very file's header: a single source
# for the docs, with no duplicated text to go stale.
usage() {
  sed -n '/^# Usage:/,/^[^#]/{/^#/s/^# \{0,1\}//p}' "$0"
  printf '\nKeys: %s\n' "${PKG_KEYS[*]}"
}

# ─── arg parsing ─────────────────────────────────────────────────────────────
ONLY_KEYS=()
for arg in "$@"; do
  case "$arg" in
    --all) NONINTERACTIVE=true ;;
    --only=*)
      IFS=',' read -ra ONLY_KEYS <<<"${arg#--only=}"
      ;;
    --keep-apt) KEEP_APT_PKGS=true ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      err "Unknown argument: $arg"
      usage >&2
      exit 1
      ;;
  esac
done

# ─── work dir + cleanup ─────────────────────────────────────────────────────
# A single directory for everything temporary; each installer creates its
# subfolder with `mktemp -d -p "$WORK_DIR"`. The trap deletes it (and kills
# the sudo keepalive) no matter what: success, error or Ctrl-C. The INT/TERM
# traps turn the signal into a normal exit so the EXIT one runs.
WORK_DIR="$(mktemp -d -t dev-packages.XXXXXX)" || {
  err "Couldn't create the work directory"
  exit 1
}
cleanup() {
  local pidfile="$WORK_DIR/sudo-keepalive.pid"
  [[ -f "$pidfile" ]] && kill "$(<"$pidfile")" 2>/dev/null
  rm -rf "$WORK_DIR"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

# ─── key selection ──────────────────────────────────────────────────────────
CHOSEN=()
if [[ ${#ONLY_KEYS[@]} -gt 0 ]]; then
  CHOSEN=("${ONLY_KEYS[@]}")
elif [[ "$NONINTERACTIVE" == "true" ]] || ! [ -t 0 ]; then
  info "Non-interactive mode — installing/updating all ${#PKG_KEYS[@]} package(s)"
  CHOSEN=("${PKG_KEYS[@]}")
else
  if ! command -v dialog &>/dev/null; then
    err "dialog not found — install it first (sudo apt install dialog) or use --all/--only=."
    exit 1
  fi
  if ! select_packages CHOSEN; then
    warn "dev-packages cancelled."
    exit 0
  fi
fi

if [[ ${#CHOSEN[@]} -eq 0 ]]; then
  skip "No packages selected — nothing to do."
  exit 0
fi

# ─── run + summary ──────────────────────────────────────────────────────────
succeeded=0
failed=()
for key in "${CHOSEN[@]}"; do
  fn="${PKG_FN[$key]:-}"
  if [[ -z "$fn" ]]; then
    warn "Unknown package key: $key"
    failed+=("$key")
    continue
  fi
  if "$fn"; then
    ((succeeded++)) || true
  else
    warn "Install/update failed: ${PKG_LABEL[$key]:-$key}"
    failed+=("$key")
  fi
done

sep
ok "Done — ok: $succeeded  failed: ${#failed[@]}"
if [[ ${#failed[@]} -gt 0 ]]; then
  warn "Failed: ${failed[*]}"
  exit 1
fi
exit 0
