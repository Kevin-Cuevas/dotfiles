# Tuned motion-blur cursor trail (kitty.conf: custom_shaders trail).
# Options in the header of kitty/shaders/custom/cursor-trail-motion-blur.slang
startgroup
    animation_start cursor-trail-move
    animation_stop cursor-trail-stop
    # a single continuous stroke up to the cursor, without the lagging tail
    var bool CONNECTED true
    # more intermediate positions per frame: smoother (max 64)
    var int MOTION_BLUR_SAMPLES 32
    shaders cursor-trail-motion-blur
endgroup
