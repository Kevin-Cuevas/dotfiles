#!/usr/bin/env bash
# dev-packages — front door para todas las herramientas no-apt (nvim, tmux,
# kitty, yazi, tree-sitter, peaclock, tmuxp, lavat, pgcli, mycli, csvkit): dos
# checklists `dialog` en secuencia (build/tarball, luego pipx) que instalan o
# actualizan lo que el usuario marque. Standalone, igual que dev-ssh/dev-motd:
# no depende de bootstrap.d/*.sh ni de $DOTFILES_DIR, así que también corre
# suelto una vez stow-eado a ~/.local/bin.
#
# Cada instalador decide "¿ya está al día?" con lo mejor disponible para esa
# herramienta:
#   - nvim    -> build/tarball + detección de versión (corre en su propio
#                subshell con `set -e`, ver install_nvim más abajo).
#   - tmux    -> build desde fuente + último tag de git vs. versión instalada
#                (mismo patrón que nvim, ver install_tmux más abajo).
#   - yazi, tree-sitter -> binario del último release de GitHub, versión del
#                binario descargado vs. la instalada (github_release_install).
#   - kitty   -> current-version.txt oficial vs. la instalada; si hace falta,
#                re-corre el instalador oficial (in-place, seguro).
#   - tmuxp/pgcli/mycli/csvkit -> pipx install / pipx upgrade (ver
#                install_via_pipx más abajo). Si pipx no está instalado,
#                dev-packages lo instala solo vía apt antes de tocar
#                cualquiera de los cuatro.
#   - peaclock/lavat -> no publican versiones (solo git+build), así que se
#                compara el SHA remoto del HEAD contra uno guardado en
#                ~/.local/share/dev-packages/<tool>.sha tras el último build.
#
# nvim, tmux y tree-sitter también tienen paquete apt: por defecto,
# instalarlos vía dev-packages remueve la versión apt (ver KEEP_APT_PKGS /
# --keep-apt más abajo) para que solo quede una versión en el PATH.
#
# Todo lo temporal (descargas, clones, builds) vive en un único WORK_DIR que
# un trap borra al salir, incluido Ctrl-C: ningún instalador limpia a mano.
#
# Uso:
#   dev-packages                 checklist interactivo (dialog)
#   dev-packages --all           instala/actualiza todo, sin diálogo
#   dev-packages --only=a,b,c    instala/actualiza solo esas keys, sin diálogo
#   dev-packages --keep-apt      no purga el paquete apt homónimo
#                                (nvim/tmux/tree-sitter), deja ambos instalados
#   dev-packages -h | --help     esta ayuda
set -uo pipefail

# ─── helpers (mismo estilo que bootstrap.d/00-core.sh) ───────────────────────
RED='\e[38;2;191;97;106m'
GRN='\e[38;2;163;190;140m'
YLW='\e[38;2;235;203;139m'
BLU='\e[38;2;136;192;208m'
CYN='\e[38;2;143;188;187m'
DIM='\e[38;2;94;129;172m'
# shellcheck disable=SC2034 # paleta Nord compartida entre scripts; aquí no se usa
BLD='\e[1m'
RST='\e[0m'

info() { printf "${BLU}[INFO]${RST}  %s\n" "$*"; }
ok() { printf "${GRN}[OK]${RST}    %s\n" "$*"; }
err() { printf "${RED}[ERR]${RST}   %s\n" "$*" >&2; }
warn() { printf "${YLW}[WARN]${RST}  %s\n" "$*"; }
skip() { printf "${CYN}[SKIP]${RST}  %s\n" "$*"; }
sep() { printf "${DIM}%s${RST}\n" "  ──────────────────────────────────────────────────"; }

# Fatal solo dentro de los instaladores que corren en su propio subshell
# (install_nvim / install_tmux): `exit` sale de ese subshell, no del script.
die() {
  err "$*"
  exit 1
}

NONINTERACTIVE="${NONINTERACTIVE:-false}"
BACKTITLE="${DEV_PACKAGES_BACKTITLE:-dev-packages · $(hostname) · $(date '+%Y-%m-%d %H:%M')}"
STATE_DIR="$HOME/.local/share/dev-packages"

# ─── registro ─────────────────────────────────────────────────────────────
PKG_KEYS=(nvim tmux kitty yazi tree-sitter peaclock tmuxp lavat pgcli mycli csvkit)
declare -A PKG_LABEL=(
  [nvim]="Neovim (build/tarball + versión)"
  [tmux]="tmux (terminal multiplexer, build desde fuente, versión-checked)"
  [kitty]="kitty (instalador oficial, versión-checked)"
  [yazi]="Yazi (file manager, release de GitHub, versión-checked)"
  ["tree-sitter"]="tree-sitter CLI (parsers de nvim-treesitter, release de GitHub)"
  [peaclock]="Peaclock (reloj de terminal, build desde fuente, sha-checked)"
  [tmuxp]="tmuxp (tmux session manager, pipx install/upgrade)"
  [lavat]="lavat (lava lamp de terminal, build desde fuente, sha-checked)"
  [pgcli]="pgcli (cliente Postgres, pipx install/upgrade)"
  [mycli]="mycli (cliente MySQL/MariaDB, pipx install/upgrade)"
  [csvkit]="csvkit (utilidades CLI para CSV, pipx install/upgrade)"
)
declare -A PKG_FN=(
  [nvim]="install_nvim"
  [tmux]="install_tmux"
  [kitty]="install_kitty"
  [yazi]="install_yazi"
  ["tree-sitter"]="install_tree_sitter"
  [peaclock]="install_peaclock"
  [tmuxp]="install_tmuxp"
  [lavat]="install_lavat"
  [pgcli]="install_pgcli"
  [mycli]="install_mycli"
  [csvkit]="install_csvkit"
)

# A qué checklist (paso) pertenece cada key: "build" se muestra primero,
# "pipx" segundo. Ver select_group/select_packages más abajo.
declare -A PKG_GROUP=(
  [nvim]="build"
  [tmux]="build"
  [kitty]="build"
  [yazi]="build"
  ["tree-sitter"]="build"
  [peaclock]="build"
  [lavat]="build"
  [tmuxp]="pipx"
  [pgcli]="pipx"
  [mycli]="pipx"
  [csvkit]="pipx"
)
GROUP_ORDER=(build pipx)
declare -A GROUP_TITLE=(
  [build]="build / tarball"
  [pipx]="pipx"
)
declare -A GROUP_PROMPT=(
  [build]="Select build/tarball tools to install/update  [SPACE=toggle  ENTER=confirm]\n\nLeave everything unchecked and press ENTER to install/update ALL of this group.\nCheck 'Skip' to skip this group."
  [pipx]="Select pipx-managed CLIs to install/update  [SPACE=toggle  ENTER=confirm]\n\nLeave everything unchecked and press ENTER to install/update ALL of this group.\nCheck 'Skip' to skip this group."
)

# ─── checklist de un solo grupo (build o pipx) ───────────────────────────────
select_group() {
  local _group="$1"
  local -n _grp_out="$2"
  _grp_out=()

  local _items=("__skip__" "Skip -- install none from this group" "off")
  local _key
  for _key in "${PKG_KEYS[@]}"; do
    [[ "${PKG_GROUP[$_key]}" == "$_group" ]] || continue
    _items+=("$_key" "${PKG_LABEL[$_key]}" "off")
  done

  local _raw
  _raw=$(dialog --clear --colors --backtitle "$BACKTITLE" \
    --title " dev-packages · ${GROUP_TITLE[$_group]} " --separate-output --checklist \
    "${GROUP_PROMPT[$_group]}" \
    18 72 10 "${_items[@]}" \
    3>&1 1>&2 2>&3) || return 1

  clear

  local _raw_chosen=() _line
  while IFS= read -r _line; do [[ -n "$_line" ]] && _raw_chosen+=("$_line"); done <<<"$_raw"

  for _line in "${_raw_chosen[@]}"; do
    [[ "$_line" == "__skip__" ]] && {
      _grp_out=()
      return 0
    }
  done

  if [[ ${#_raw_chosen[@]} -eq 0 ]]; then
    local _all=()
    for _key in "${PKG_KEYS[@]}"; do
      [[ "${PKG_GROUP[$_key]}" == "$_group" ]] && _all+=("$_key")
    done
    _grp_out=("${_all[@]}")
  else
    _grp_out=("${_raw_chosen[@]}")
  fi
}

# ─── checklist propio: un diálogo por grupo, en el orden de GROUP_ORDER ────
# Esc en cualquiera de ellos cancela dev-packages entero (mismo
# comportamiento que antes tenía un único checklist); "Skip" solo salta ese
# grupo puntual y sigue con el siguiente. Un grupo nuevo solo se registra en
# GROUP_ORDER/GROUP_TITLE/GROUP_PROMPT, aquí no hay que tocar nada.
select_packages() {
  local -n _out_ref="$1"
  _out_ref=()

  local _group _chosen=()
  for _group in "${GROUP_ORDER[@]}"; do
    select_group "$_group" _chosen || return 1
    _out_ref+=("${_chosen[@]}")
  done
}

# ─── utilidades compartidas por los instaladores ─────────────────────────────

# SHA remoto del HEAD de un repo git (peaclock/lavat no publican versiones).
remote_head_sha() {
  git ls-remote "$1" HEAD 2>/dev/null | awk '{print $1}'
}

# Falla con un mensaje útil si falta una herramienta. $2 = paquete apt, si no
# se llama igual que el comando.
need_cmd() {
  command -v "$1" &>/dev/null && return 0
  err "$1 no encontrado — instálalo primero (sudo apt install ${2:-$1})."
  return 1
}

# Sí/No con dialog; sin dialog, pregunta en texto plano. Default: No.
ask_yes_no() {
  if command -v dialog &>/dev/null; then
    local rc=0
    dialog --clear --backtitle "$BACKTITLE" --title " Confirmar " --defaultno \
      --yesno "$1" 8 72 || rc=$?
    clear
    return "$rc"
  fi
  warn "$1 [s/N]"
  local reply
  read -r reply
  [[ "$reply" =~ ^[sS]$ ]]
}

# ¿Seguir con la instalación? $1=nombre $2=versión instalada (vacía si no hay)
# $3=versión candidata. Distintas -> sí. Iguales -> en modo no interactivo se
# reinstala (como siempre lo hizo --all); en interactivo, se pregunta.
# 0 = seguir, 1 = el usuario no quiere reinstalar la misma versión.
confirm_version() {
  local name="$1" current="$2" new="$3"
  if [[ -z "$current" || "$current" != "$new" ]]; then
    info "Actualizando $name: ${current:-<ninguna>} → ${new:-<desconocida>}"
    return 0
  fi
  if [[ "$NONINTERACTIVE" == "true" ]]; then
    info "No interactivo — reinstalando la misma versión ($new)."
    return 0
  fi
  ask_yes_no "Ya tienes instalada $new.\n\n¿Instalar de todas formas?"
}

# Mantiene vivo el ticket de sudo durante builds largos. El PID del loop va a
# un archivo en WORK_DIR y no a una variable: install_nvim/install_tmux lo
# llaman desde su subshell, y una variable no volvería al proceso padre (que
# es quien lo mata en cleanup). Además el loop termina solo si el script
# muere aunque sea con kill -9: `kill -0 $$` deja de responder.
sudo_keepalive() {
  local pidfile="$WORK_DIR/sudo-keepalive.pid"
  [[ -f "$pidfile" ]] && kill -0 "$(<"$pidfile")" 2>/dev/null && return 0
  info "Se requieren permisos de administrador..."
  sudo -v || return 1
  (while kill -0 "$$" 2>/dev/null; do
    sudo -n true
    sleep 55
  done) &
  echo "$!" >"$pidfile"
}

# Purga el paquete apt homónimo (nvim/tmux/tree-sitter) para que solo quede
# la versión de dev-packages en el PATH. KEEP_APT_PKGS=true (o --keep-apt) lo
# deja instalado en vez de purgarlo.
KEEP_APT_PKGS="${KEEP_APT_PKGS:-false}"
remove_apt_if_present() {
  local pkg="$1"
  if dpkg -s "$pkg" &>/dev/null; then
    if [[ "$KEEP_APT_PKGS" == "true" ]]; then
      warn "$pkg sigue instalado vía apt (KEEP_APT_PKGS=true) — puede haber dos binarios en PATH."
      return 0
    fi
    info "Removiendo $pkg instalado vía apt..."
    sudo apt-get remove --purge -y "$pkg"
    sudo apt-get autoremove -y
  else
    ok "$pkg no está instalado vía apt"
  fi
}

# Versión de un binario: la primera línea de `--version` que tenga un número,
# sin sangría. No sirve tomar la primera línea a ciegas: yazi 26+ imprime
# "Yazi" solo en la primera y "Version: 26.9.1 (...)" más abajo, así que
# cualquier versión parecía igual a la instalada. La salida se captura entera
# antes de filtrar para que un SIGPIPE no se lea como "el binario no corre".
bin_version() {
  local out
  out="$("$1" --version 2>/dev/null)" || return 1
  grep -m1 '[0-9]' <<<"$out" | sed 's/^[[:space:]]*//'
}

# Extrae un asset según su extensión, dentro de $2 (.gz suelto: en su sitio).
extract() {
  case "$1" in
    *.zip) need_cmd unzip && unzip -q -o "$1" -d "$2" ;;
    *.tar.gz | *.tgz) tar -xzf "$1" -C "$2" ;;
    *.gz) gunzip -f "$1" ;;
    *)
      err "Formato de asset no soportado: $1"
      return 1
      ;;
  esac
}

# Instala binarios del último release de GitHub en ~/.local/bin.
#   github_release_install [--purge-apt=PKG] REPO ASSET BIN[:DESTINO]...
# Cada BIN es una ruta dentro del asset ya extraído; DESTINO es el nombre
# final (por defecto, el basename de BIN). El primero define la herramienta:
# su `--version` (el binario recién descargado vs. el instalado) decide si
# hace falta tocar ~/.local/bin. Si el binario descargado no corre en este
# host (p. ej. pide una glibc más nueva), aborta sin tocar nada.
# --purge-apt purga ese paquete apt SOLO tras instalar de verdad: si no se
# quiso reinstalar, el binario en uso podría ser justo el de apt.
github_release_install() {
  local purge_apt=""
  if [[ "$1" == --purge-apt=* ]]; then
    purge_apt="${1#--purge-apt=}"
    shift
  fi
  local repo="$1" asset="$2"
  shift 2
  local specs=("$@") spec src dst

  local name="${specs[0]#*:}"
  name="${name##*/}"

  local dir
  dir="$(mktemp -d -p "$WORK_DIR" "$name.XXXXXX")" || return 1

  local url="https://github.com/$repo/releases/latest/download/$asset"
  info "Descargando $url ..."
  if ! curl -fL --progress-bar -o "$dir/$asset" "$url"; then
    err "Falló la descarga de $asset"
    return 1
  fi
  if ! extract "$dir/$asset" "$dir"; then
    err "No se pudo extraer $asset"
    return 1
  fi

  for spec in "${specs[@]}"; do
    src="${spec%%:*}"
    if [[ ! -f "$dir/$src" ]]; then
      err "$src no está en $asset"
      return 1
    fi
    chmod +x "$dir/$src"
  done

  local current="" new
  if command -v "$name" &>/dev/null; then
    current="$(bin_version "$name")"
  fi
  if ! new="$(bin_version "$dir/${specs[0]%%:*}")" || [[ -z "$new" ]]; then
    err "El $name descargado no corre en este host (glibc $(ldd --version 2>/dev/null | awk 'NR == 1 {print $NF}'))."
    return 1
  fi

  if ! confirm_version "$name" "$current" "$new"; then
    skip "$name se queda en $new"
    return 0
  fi

  mkdir -p "$HOME/.local/bin"
  for spec in "${specs[@]}"; do
    src="${spec%%:*}"
    dst="${spec#*:}"
    install -m 755 "$dir/$src" "$HOME/.local/bin/${dst##*/}"
  done
  ok "$name instalado -> $HOME/.local/bin ($new)"
  if [[ -n "$purge_apt" ]]; then remove_apt_if_present "$purge_apt"; fi
}

# ─── instaladores ────────────────────────────────────────────────────────────

# Instala/actualiza Neovim eligiendo entre dos métodos:
#   - tarball : binario precompilado oficial de los releases de GitHub
#               (rápido, seguro, funciona en x86_64 y arm64).
#   - build   : compila desde fuente con -march=native (solo x86_64, optimizado).
# Ambos métodos instalan en /opt/nvim + symlink /usr/local/bin/nvim, así que
# son INTERCAMBIABLES: reinstalar con el otro método reemplaza limpio lo
# anterior. En modo no interactivo usa SIEMPRE el método más seguro: tarball.
#
# Corre en un subshell propio con `set -euo pipefail`: es la forma más simple
# de que cualquier paso (descarga, compilación, cmake --install...) aborte
# esta instalación en particular sin tumbar el resto de dev-packages; die()
# sale de ese subshell, no del script.
install_nvim() {
  sep
  (
    set -euo pipefail

    ARCH="$(uname -m)"
    NVIM_PREFIX="/opt/nvim"
    NVIM_SYMLINK="/usr/local/bin/nvim"

    case "$ARCH" in
      x86_64) TARBALL_ARCH="x86_64" ;;
      aarch64) TARBALL_ARCH="arm64" ;;
      *) TARBALL_ARCH="" ;;
    esac

    BUILD_SUPPORTED=false
    [[ "$ARCH" == "x86_64" ]] && BUILD_SUPPORTED=true

    sudo_keepalive || die "Sin permisos de administrador no se puede instalar en $NVIM_PREFIX"
    TMP_DIR="$(mktemp -d -p "$WORK_DIR" nvim.XXXXXX)"

    CHOSEN_METHOD=""
    choose_method() {
      CHOSEN_METHOD=""
      if command -v dialog &>/dev/null; then
        local choice rc
        if choice=$(dialog --clear --backtitle "$BACKTITLE" \
          --title " Instalar Neovim " \
          --ok-label "Instalar" --cancel-label "Cancelar" \
          --menu "\nElige el método de instalación:" \
          13 72 2 \
          "build" "Compilar desde fuente  (-march=native, optimizado)" \
          "tarball" "Tarball precompilado oficial  (rápido, seguro)" \
          3>&1 1>&2 2>&3); then
          rc=0
        else
          rc=$?
        fi
        clear
        if ((rc == 0)); then CHOSEN_METHOD="$choice"; fi
        return 0
      fi
      echo ""
      echo "  Método de instalación de Neovim:"
      echo "    1) build   — compilar desde fuente (-march=native, optimizado)"
      echo "    2) tarball — precompilado oficial (rápido, seguro)"
      echo "    q) cancelar"
      local choice
      read -rp "  Opción [1/2/q]: " choice
      case "$choice" in
        1 | build | b) CHOSEN_METHOD="build" ;;
        2 | tarball | t) CHOSEN_METHOD="tarball" ;;
        q | Q | c | cancel) CHOSEN_METHOD="" ;;
        *) CHOSEN_METHOD="tarball" ;;
      esac
      return 0
    }

    CURRENT_VERSION="$(nvim --version 2>/dev/null | head -1 || true)"
    if [[ -n "$CURRENT_VERSION" ]]; then
      info "Versión actual: $CURRENT_VERSION"
    else
      warn "nvim no encontrado, procediendo con instalación..."
    fi

    get_source_version() {
      local cml="$1/CMakeLists.txt"
      [[ -f "$cml" ]] || {
        echo ""
        return
      }
      local maj min pat pre
      maj=$(grep -m1 -E 'set\(NVIM_VERSION_MAJOR' "$cml" | grep -oE '[0-9]+' | head -1)
      min=$(grep -m1 -E 'set\(NVIM_VERSION_MINOR' "$cml" | grep -oE '[0-9]+' | head -1)
      pat=$(grep -m1 -E 'set\(NVIM_VERSION_PATCH' "$cml" | grep -oE '[0-9]+' | head -1)
      pre=$(grep -m1 -E 'set\(NVIM_VERSION_PRERELEASE' "$cml" | sed -E 's/[^"]*"([^"]*)".*/\1/')
      [[ -n "$maj$min$pat" ]] || {
        echo ""
        return
      }
      echo "NVIM v${maj}.${min}.${pat}${pre}"
    }

    remove_previous_install() {
      info "Eliminando instalación anterior..."
      sudo rm -f "$NVIM_SYMLINK"
      sudo rm -rf "$NVIM_PREFIX"
      remove_apt_if_present neovim
    }

    finalize() {
      sudo ln -sf "$NVIM_PREFIX/bin/nvim" "$NVIM_SYMLINK"
      echo ""
      ok "Instalación completa: $("$NVIM_PREFIX/bin/nvim" --version | head -1)"
    }

    install_tarball() {
      [[ -n "$TARBALL_ARCH" ]] || die "No hay tarball oficial para la arquitectura $ARCH"

      info "Modo: instalación desde tarball precompilado (${TARBALL_ARCH})"
      local tarball="nvim-linux-${TARBALL_ARCH}.tar.gz"
      local extract_dir="$TMP_DIR/nvim-linux-${TARBALL_ARCH}"

      info "Descargando $tarball..."
      curl -fL --progress-bar \
        "https://github.com/neovim/neovim/releases/download/stable/${tarball}" \
        -o "$TMP_DIR/$tarball" || die "Falló la descarga del tarball"

      info "Extrayendo..."
      tar xzf "$TMP_DIR/$tarball" -C "$TMP_DIR"

      local new_version
      new_version=$("$extract_dir/bin/nvim" --version | head -1)

      confirm_version nvim "$CURRENT_VERSION" "$new_version" || return 1

      remove_previous_install
      info "Instalando en $NVIM_PREFIX..."
      sudo mv "$extract_dir" "$NVIM_PREFIX"
    }

    install_build_deps() {
      info "Instalando dependencias de compilación..."
      if ! grep -qE '^deb-src' /etc/apt/sources.list /etc/apt/sources.list.d/*.list 2>/dev/null; then
        info "Habilitando deb-src en sources.list..."
        sudo sed -i 's/^deb \(.*\)/deb \1\ndeb-src \1/' /etc/apt/sources.list
        sudo apt-get update -qq
      fi
      sudo apt-get build-dep -y neovim
      sudo apt-get install -y --no-install-recommends \
        git ninja-build curl ca-certificates cmake \
        libutf8proc-dev libluajit-5.1-dev
    }

    build_source() {
      info "Modo: compilación desde fuente con flags nativos"

      if ! command -v git &>/dev/null; then
        info "git no encontrado — instalando..."
        sudo apt-get install -y git
      fi

      local nvim_src="$TMP_DIR/neovim"
      info "Clonando repositorio neovim (rama stable)..."
      git clone --depth 1 --branch stable \
        https://github.com/neovim/neovim.git "$nvim_src"
      git -C "$nvim_src" config advice.detachedHead false

      local new_version
      new_version=$(get_source_version "$nvim_src")

      confirm_version nvim "$CURRENT_VERSION" "$new_version" || return 1

      install_build_deps

      local gcc_major march_flag
      gcc_major=$(gcc -dumpversion | cut -d. -f1)
      if ((gcc_major >= 9)); then
        march_flag="-march=native"
      else
        warn "gcc $gcc_major < 9: usando baseline -march=x86-64"
        march_flag="-march=x86-64"
      fi

      local native_cc append_flags cc_wrapper deps_dir build_dir nproc
      native_cc="$(command -v gcc)"
      append_flags="$march_flag -mtune=native -g -pipe"
      cc_wrapper="$TMP_DIR/cc-native"
      cat >"$cc_wrapper" <<EOF
#!/usr/bin/env bash
exec "$native_cc" "\$@" $append_flags
EOF
      chmod +x "$cc_wrapper"
      deps_dir="$nvim_src/.deps"
      build_dir="$nvim_src/build"
      nproc=$(nproc)

      info "Compilador: $native_cc ($(gcc --version | head -1))"
      info "Flags nativos (append): $append_flags"

      info "Compilando dependencias bundled (treesitter, luajit, luv...)..."
      cmake -S "$nvim_src/cmake.deps" -B "$deps_dir" \
        -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_C_COMPILER="$cc_wrapper" \
        -DCMAKE_C_FLAGS_RELEASE="-O3 -DNDEBUG" \
        -DUSE_BUNDLED=ON \
        -DUSE_BUNDLED_TS=ON \
        -DUSE_BUNDLED_LUAJIT=ON \
        -DUSE_BUNDLED_LUV=ON
      cmake --build "$deps_dir" --parallel "$nproc"

      info "Configurando build principal..."
      cmake -S "$nvim_src" -B "$build_dir" \
        -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_C_COMPILER="$cc_wrapper" \
        -DCMAKE_C_FLAGS_RELEASE="-O3 -DNDEBUG" \
        -DCMAKE_INSTALL_PREFIX="$NVIM_PREFIX" \
        -DCMAKE_PREFIX_PATH="$deps_dir/usr"

      info "Compilando con $nproc núcleos..."
      cmake --build "$build_dir" --parallel "$nproc"

      remove_previous_install
      info "Instalando en $NVIM_PREFIX..."
      sudo cmake --install "$build_dir"

      info "Verificando flags del binario instalado..."
      local producer detected_march ymm
      producer=$(readelf -wi "$NVIM_PREFIX/bin/nvim" 2>/dev/null \
        | grep -am1 "DW_AT_producer" | sed -E 's/.*\): //')
      detected_march=$(grep -oE -- '-march=[^ ]+' <<<"$producer" | head -1)
      ymm=$(objdump -d "$NVIM_PREFIX/bin/nvim" 2>/dev/null | grep -c "ymm")
      case "$detected_march" in
        "" | "-march=x86-64")
          warn "El binario no quedó optimizado (${detected_march:-sin -march}): ${producer:-<sin DWARF>}"
          ;;
        *)
          ok "DWARF producer: ${detected_march} confirmado"
          ;;
      esac
      info "Instrucciones AVX2 (ymm): $ymm"
    }

    if [[ "$NONINTERACTIVE" == "true" ]] || ! [ -t 0 ]; then
      info "Modo no interactivo — usando tarball (método seguro)."
      METHOD="tarball"
    else
      choose_method
      METHOD="$CHOSEN_METHOD"
    fi

    if [[ -z "$METHOD" ]]; then
      info "Instalación cancelada."
      exit 0
    fi

    if [[ "$METHOD" == "build" && "$BUILD_SUPPORTED" != "true" ]]; then
      warn "Compilación no soportada en $ARCH — usando tarball precompilado."
      METHOD="tarball"
    fi

    case "$METHOD" in
      build)
        if build_source; then
          finalize
        else
          info "Instalación cancelada."
        fi
        ;;
      tarball)
        if install_tarball; then
          finalize
        else
          info "Instalación cancelada."
        fi
        ;;
      *)
        die "Método desconocido: $METHOD"
        ;;
    esac
  )
}

# Instala/actualiza tmux compilando desde fuente. tmux no publica binarios
# precompilados en sus releases de GitHub (solo tarballs de código), así que,
# a diferencia de nvim, aquí solo hay un método: build. La versión objetivo
# se obtiene barato (sin clonar) con `git ls-remote --tags`, se compara contra
# `tmux -V` y solo si hace falta se clona/compila/instala.
#
# Mismo patrón que install_nvim: prefix /opt/tmux + symlink
# /usr/local/bin/tmux, subshell propio con `set -euo pipefail`, y purga el
# paquete apt homónimo por defecto (ver remove_apt_if_present / KEEP_APT_PKGS).
install_tmux() {
  sep
  (
    set -euo pipefail

    TMUX_PREFIX="/opt/tmux"
    TMUX_SYMLINK="/usr/local/bin/tmux"
    TMUX_REPO="https://github.com/tmux/tmux.git"

    CURRENT_VERSION="$(tmux -V 2>/dev/null || true)"
    if [[ -n "$CURRENT_VERSION" ]]; then
      info "Versión actual: $CURRENT_VERSION"
    else
      warn "tmux no encontrado, procediendo con instalación..."
    fi

    info "Consultando último tag de tmux upstream..."
    LATEST_TAG=$(git ls-remote --tags --refs "$TMUX_REPO" 2>/dev/null \
      | awk -F/ '{print $NF}' | grep -E '^[0-9]+\.[0-9]+[a-z]?$' | sort -V | tail -1)
    [[ -n "$LATEST_TAG" ]] || die "No se pudo determinar el último tag de tmux"
    NEW_VERSION="tmux $LATEST_TAG"

    confirm_version tmux "$CURRENT_VERSION" "$NEW_VERSION" || {
      info "Instalación cancelada."
      exit 0
    }

    sudo_keepalive || die "Sin permisos de administrador no se puede instalar en $TMUX_PREFIX"
    TMP_DIR="$(mktemp -d -p "$WORK_DIR" tmux.XXXXXX)"

    info "Instalando dependencias de compilación..."
    sudo apt-get install -y --no-install-recommends \
      build-essential libevent-dev libncurses-dev bison pkg-config \
      autoconf automake git

    info "Clonando tmux $LATEST_TAG..."
    git clone --depth 1 --branch "$LATEST_TAG" "$TMUX_REPO" "$TMP_DIR/tmux"

    info "Generando configure (autogen.sh)..."
    (cd "$TMP_DIR/tmux" && sh autogen.sh)

    info "Configurando build (prefix: $TMUX_PREFIX)..."
    (cd "$TMP_DIR/tmux" && ./configure --prefix="$TMUX_PREFIX")

    nproc_count=$(nproc)
    info "Compilando con $nproc_count núcleos..."
    (cd "$TMP_DIR/tmux" && make -j"$nproc_count")

    info "Eliminando instalación anterior..."
    sudo rm -f "$TMUX_SYMLINK"
    sudo rm -rf "$TMUX_PREFIX"
    remove_apt_if_present tmux

    info "Instalando en $TMUX_PREFIX..."
    (cd "$TMP_DIR/tmux" && sudo make install)

    sudo ln -sf "$TMUX_PREFIX/bin/tmux" "$TMUX_SYMLINK"
    echo ""
    ok "Instalación completa: $("$TMUX_PREFIX/bin/tmux" -V)"
  )
}

# Instala/actualiza kitty vía el instalador oficial (no hay paquete apt: la
# versión de Debian suele ir muy atrás). El instalador reemplaza
# ~/.local/kitty.app in-place sin tocar symlinks ni .desktop files, pero baja
# todo el bundle cada vez: antes se compara contra current-version.txt, que
# kitty publica justo para esto. El instalador se descarga a un archivo y
# luego se ejecuta — nunca `curl | sh`: sin -f, un error HTTP terminaba
# ejecutado por sh, y una descarga cortada se ejecutaría a medias.
install_kitty() {
  sep
  local current="" latest
  if command -v kitty &>/dev/null; then
    current="kitty $(kitty --version 2>/dev/null | awk '{print $2}')"
  fi

  if latest="$(curl -fsSL https://sw.kovidgoyal.net/kitty/current-version.txt)" && [[ -n "$latest" ]]; then
    if ! confirm_version kitty "$current" "kitty $latest"; then
      skip "kitty se queda en kitty $latest"
      return 0
    fi
  else
    warn "No se pudo consultar la última versión de kitty — se corre el instalador igual."
  fi

  local installer="$WORK_DIR/kitty-installer.sh"
  if ! curl -fsSL -o "$installer" https://sw.kovidgoyal.net/kitty/installer.sh; then
    err "Falló la descarga del instalador de kitty"
    return 1
  fi
  if ! sh "$installer"; then
    err "Falló el instalador de kitty"
    return 1
  fi
  ok "kitty instalado/actualizado -> $HOME/.local/kitty.app"
}

# yazi (terminal file manager): binario oficial; el zip trae yazi y ya.
install_yazi() {
  sep
  local triple
  case "$(uname -m)" in
    x86_64) triple="x86_64-unknown-linux-gnu" ;;
    aarch64) triple="aarch64-unknown-linux-gnu" ;;
    *)
      warn "yazi no publica binario para $(uname -m) — se omite."
      return 1
      ;;
  esac
  github_release_install sxyazi/yazi "yazi-$triple.zip" "yazi-$triple/yazi" "yazi-$triple/ya"
}

# CLI de tree-sitter: nvim-treesitter (rama main, LazyVim 15+) lo necesita
# para compilar parsers y pide una versión reciente que el apt de Debians
# anteriores no trae. El binario upstream pide glibc >= 2.39; si no corre
# aquí, github_release_install aborta sin tocar nada. Tras instalar, purga
# tree-sitter-cli de apt para que solo quede ~/.local/bin/tree-sitter.
install_tree_sitter() {
  sep
  local arch
  case "$(uname -m)" in
    x86_64) arch="x64" ;;
    aarch64) arch="arm64" ;;
    *)
      warn "tree-sitter no publica binario para $(uname -m) — se omite."
      return 1
      ;;
  esac
  github_release_install --purge-apt=tree-sitter-cli tree-sitter/tree-sitter \
    "tree-sitter-linux-$arch.gz" "tree-sitter-linux-$arch:tree-sitter" || {
    warn "Si el binario no corre aquí: cargo install --locked tree-sitter-cli"
    return 1
  }
}

# Asegura pipx instalado antes de usarlo. Si falta, lo instala solo vía apt
# (que en Debian/Ubuntu arrastra python3-venv como dependencia) en vez de
# fallar pidiéndole al usuario que lo instale a mano. Idempotente: si ya
# existe, no hace nada.
ensure_pipx() {
  command -v pipx &>/dev/null && return 0
  info "pipx no encontrado — instalando vía apt..."
  sudo apt-get install -y pipx || {
    err "Falló 'apt-get install pipx'"
    return 1
  }
  pipx ensurepath &>/dev/null || true
  ok "pipx instalado -> $(command -v pipx)"
}

# Install/upgrade genérico vía pipx: común a tmuxp/pgcli/mycli (y a cualquier
# CLI de Python que se agregue después). pipx trae su propio mecanismo de
# actualización — lo usamos directo en vez de reimplementar detección de
# versión.
install_via_pipx() {
  local pkg="$1"
  ensure_pipx || return 1

  if command -v "$pkg" &>/dev/null; then
    info "Actualizando $pkg vía pipx..."
    if ! pipx upgrade "$pkg"; then
      err "Falló 'pipx upgrade $pkg'"
      return 1
    fi
    ok "$pkg actualizado -> $(command -v "$pkg")"
  else
    info "Instalando $pkg vía pipx..."
    if ! pipx install "$pkg" &>/dev/null; then
      err "Falló 'pipx install $pkg'"
      return 1
    fi
    ok "$pkg instalado vía pipx -> $HOME/.local/bin/$pkg"
  fi
}

install_tmuxp() {
  sep
  install_via_pipx tmuxp
}

install_pgcli() {
  sep
  install_via_pipx pgcli
}

install_mycli() {
  sep
  install_via_pipx mycli
}

install_csvkit() {
  sep
  install_via_pipx csvkit
}

# Compila peaclock (reloj estético de terminal) desde fuente. No hay binario
# oficial ni releases con versión, así que "¿hay actualización?" se decide
# comparando el SHA remoto del HEAD contra el que quedó guardado tras el
# último build exitoso — si no cambió, no vale la pena recompilar.
install_peaclock() {
  sep
  local repo="https://github.com/octobanana/peaclock"
  local state_file="$STATE_DIR/peaclock.sha"
  local remote_sha local_sha=""
  remote_sha="$(remote_head_sha "$repo")"
  [[ -f "$state_file" ]] && local_sha="$(<"$state_file")"

  if command -v peaclock &>/dev/null && [[ -n "$remote_sha" && "$remote_sha" == "$local_sha" ]]; then
    skip "peaclock ya está al día ($(command -v peaclock), $remote_sha)"
    return 0
  fi

  need_cmd git || return 1
  need_cmd cmake || return 1
  dpkg -s libicu-dev &>/dev/null || {
    err "Falta ICU — instala libicu-dev primero (sudo apt install libicu-dev)."
    return 1
  }

  local src
  src="$(mktemp -d -p "$WORK_DIR" peaclock.XXXXXX)" || return 1

  info "Clonando peaclock..."
  if ! git clone --depth=1 "$repo" "$src" &>/dev/null; then
    err "Falló el clone de peaclock"
    return 1
  fi

  info "Compilando peaclock (RUNME.sh build)..."
  if ! (cd "$src" && ./RUNME.sh build --release) &>/dev/null; then
    err "Falló la compilación de peaclock"
    return 1
  fi

  info "Instalando peaclock (RUNME.sh install)..."
  if ! (cd "$src" && ./RUNME.sh install --release); then
    err "Falló la instalación de peaclock"
    return 1
  fi

  mkdir -p "$STATE_DIR"
  [[ -n "$remote_sha" ]] && echo "$remote_sha" >"$state_file"
  ok "peaclock instalado/actualizado -> $(command -v peaclock)"
}

# Compila lavat (lava lamp de terminal) desde fuente — mismo criterio que
# peaclock: sin releases con versión, se compara el SHA remoto del HEAD.
install_lavat() {
  sep
  local repo="https://github.com/AngelJumbo/lavat"
  local state_file="$STATE_DIR/lavat.sha"
  local remote_sha local_sha=""
  remote_sha="$(remote_head_sha "$repo")"
  [[ -f "$state_file" ]] && local_sha="$(<"$state_file")"

  if command -v lavat &>/dev/null && [[ -n "$remote_sha" && "$remote_sha" == "$local_sha" ]]; then
    skip "lavat ya está al día ($(command -v lavat), $remote_sha)"
    return 0
  fi

  need_cmd git || return 1

  local src
  src="$(mktemp -d -p "$WORK_DIR" lavat.XXXXXX)" || return 1

  info "Clonando lavat..."
  if ! git clone --depth=1 "$repo" "$src" &>/dev/null; then
    err "Falló el clone de lavat"
    return 1
  fi

  info "Compilando lavat (make)..."
  if ! (cd "$src" && make) &>/dev/null; then
    err "Falló la compilación de lavat"
    return 1
  fi

  info "Instalando lavat (sudo make install)..."
  if ! (cd "$src" && sudo make install) &>/dev/null; then
    err "Falló 'sudo make install' de lavat"
    return 1
  fi

  mkdir -p "$STATE_DIR"
  [[ -n "$remote_sha" ]] && echo "$remote_sha" >"$state_file"
  ok "lavat instalado/actualizado -> $(command -v lavat)"
}

# ─── ayuda ───────────────────────────────────────────────────────────────────
# Se imprime el bloque "# Uso:" de la cabecera de este mismo archivo: una sola
# fuente para la documentación, sin un texto duplicado que se desactualice.
usage() {
  sed -n '/^# Uso:/,/^[^#]/{/^#/s/^# \{0,1\}//p}' "$0"
  printf '\nKeys: %s\n' "${PKG_KEYS[*]}"
}

# ─── arg parsing ─────────────────────────────────────────────────────────────
ONLY_KEYS=()
for arg in "$@"; do
  case "$arg" in
    --all) NONINTERACTIVE=true ;;
    --only=*)
      IFS=',' read -ra ONLY_KEYS <<<"${arg#--only=}"
      ;;
    --keep-apt) KEEP_APT_PKGS=true ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      err "Argumento desconocido: $arg"
      usage >&2
      exit 1
      ;;
  esac
done

# ─── directorio de trabajo + limpieza ────────────────────────────────────────
# Un solo directorio para todo lo temporal; cada instalador crea su
# subcarpeta con `mktemp -d -p "$WORK_DIR"`. El trap lo borra (y mata el
# keepalive de sudo) pase lo que pase: éxito, error o Ctrl-C. Los traps de
# INT/TERM convierten la señal en un exit normal para que corra el de EXIT.
WORK_DIR="$(mktemp -d -t dev-packages.XXXXXX)" || {
  err "No se pudo crear el directorio de trabajo"
  exit 1
}
cleanup() {
  local pidfile="$WORK_DIR/sudo-keepalive.pid"
  [[ -f "$pidfile" ]] && kill "$(<"$pidfile")" 2>/dev/null
  rm -rf "$WORK_DIR"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

# ─── selección de keys a procesar ────────────────────────────────────────────
CHOSEN=()
if [[ ${#ONLY_KEYS[@]} -gt 0 ]]; then
  CHOSEN=("${ONLY_KEYS[@]}")
elif [[ "$NONINTERACTIVE" == "true" ]] || ! [ -t 0 ]; then
  info "Non-interactive mode — installing/updating all ${#PKG_KEYS[@]} package(s)"
  CHOSEN=("${PKG_KEYS[@]}")
else
  if ! command -v dialog &>/dev/null; then
    err "dialog no encontrado — instálalo primero (sudo apt install dialog) o usa --all/--only=."
    exit 1
  fi
  if ! select_packages CHOSEN; then
    warn "dev-packages cancelado."
    exit 0
  fi
fi

if [[ ${#CHOSEN[@]} -eq 0 ]]; then
  skip "No packages selected — nothing to do."
  exit 0
fi

# ─── ejecución + resumen ─────────────────────────────────────────────────────
succeeded=0
failed=()
for key in "${CHOSEN[@]}"; do
  fn="${PKG_FN[$key]:-}"
  if [[ -z "$fn" ]]; then
    warn "Unknown package key: $key"
    failed+=("$key")
    continue
  fi
  if "$fn"; then
    ((succeeded++)) || true
  else
    warn "Install/update failed: ${PKG_LABEL[$key]:-$key}"
    failed+=("$key")
  fi
done

sep
ok "Done — ok: $succeeded  failed: ${#failed[@]}"
if [[ ${#failed[@]} -gt 0 ]]; then
  warn "Failed: ${failed[*]}"
  exit 1
fi
exit 0
