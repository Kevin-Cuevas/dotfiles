[Unit]
Description=Push the system light/dark preference to remote tmux sessions for nvim
After=graphical-session.target
Wants=graphical-session.target

[Service]
ExecStart=%h/.local/bin/dev-theme-push
# always, not on-failure: this is a monitor loop, so it stopping for ANY
# reason (even a clean exit from some future bug) means it silently stops
# reacting to theme changes — worth an automatic restart either way.
Restart=always
RestartSec=2

[Install]
WantedBy=graphical-session.target
