#!/usr/bin/env bash
set -uo pipefail

# ==============================================================================
# dev-motd — install the dotfiles' MOTD (system/motd/) on this host
# ==============================================================================
# Standalone, like the other dev-* CLIs: system/motd/ is found from this
# script's own real path, not from $DOTFILES_DIR.
#
# What it sets up:
#   /etc/update-motd.d/<NAME>     the MOTD script (root, 0755). Copied, not linked:
#                                 the directory is root-owned and pam_motd runs it
#                                 as root.
#   /etc/default/nivek-motd       its options (Debian's place for them):
#                                 MOTD_ANIMATION=splash|off: the animated splash
#                                 (hostname banner with a Nord-blue aurora until a
#                                 key is pressed) or the usual static MOTD. Off
#                                 unless you say yes.
#                                 MOTD_NAME=<text>: the name in the banner, for
#                                 hosts whose hostname can't be changed (a cloud
#                                 default like ip-172-31-18-47). Empty = hostname;
#                                 the MOTD's Host line always shows the real one.
#   toilet (apt)                  draws the banner (pagga font); installed if
#                                 missing, since without it the banner is plain
#                                 text.
#   ~/.hushlogin                  silences pam_motd for you. zsh/.zshrc prints the
#                                 MOTD instead, once per interactive SSH login:
#                                 pam_motd only prints on the first session of each
#                                 connection (ControlMaster reuses them) and
#                                 Tailscale SSH has no PAM at all.
#
# Usage:
#   dev-motd                      install; asks whether to turn the animation on
#   dev-motd --animation=on|off   install with that setting, no question
#   dev-motd --name=TEXT          install with that banner name (--name= = hostname)
#   dev-motd --status             what is installed, drift vs the repo, setting
#   dev-motd --remove             undo all three
#   dev-motd -h | --help          this help
#   (`dev-motd install|remove [NAME]` still works; NAME defaults to 99-nivek-banner)
#
# Interactive installs ask two things with dialog: the animation (yes/no,
# default No) and the banner name (prefilled with the current one, else the
# host's mesh name when it differs from the hostname, else the hostname). Both
# are skipped, keeping the current values (animation off and the hostname on a
# first install), when there is no terminal or when bootstrap runs with --all
# (NONINTERACTIVE=true).
# ==============================================================================

MOTD_SRC_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../../.." && pwd)/system/motd"
TARGET_DIR="/etc/update-motd.d"
CONF="/etc/default/nivek-motd"
HUSH="${HOME}/.hushlogin"
NAME="99-nivek-banner"

# ------------------------------------------------------------------------------
# Look & feel (shared with the other dev-* scripts)
# ------------------------------------------------------------------------------
RED='\e[38;2;191;97;106m'
GRN='\e[38;2;163;190;140m'
YLW='\e[38;2;235;203;139m'
BLU='\e[38;2;136;192;208m'
CYN='\e[38;2;143;188;187m'
RST='\e[0m'

info() { printf "${BLU}[INFO]${RST}  %s\n" "$*"; }
ok() { printf "${GRN}[OK]${RST}    %s\n" "$*"; }
warn() { printf "${YLW}[WARN]${RST}  %s\n" "$*"; }
err() { printf "${RED}[ERR]${RST}   %s\n" "$*" >&2; }
skip() { printf "${CYN}[SKIP]${RST}  %s\n" "$*"; }
die() {
  err "$*"
  exit 1
}

usage() { sed -n '/^# Usage:/,/^# =====/{/^# =====/d;s/^# \{0,1\}//;p}' "$(readlink -f "${BASH_SOURCE[0]}")"; }

# ------------------------------------------------------------------------------
# Helpers
# ------------------------------------------------------------------------------
# Current options into CUR_ANIM / CUR_NAME; empty when not installed yet.
CUR_ANIM="" CUR_NAME=""
read_conf() {
  local key val
  CUR_ANIM="" CUR_NAME=""
  [[ -r $CONF ]] || return 0
  while IFS='=' read -r key val; do
    val=${val#[\"\']} val=${val%[\"\']}
    case $key in
      MOTD_ANIMATION) CUR_ANIM=${val// /} ;;
      MOTD_NAME) CUR_NAME=$val ;;
    esac
  done <"$CONF"
}

# This host's name on the tailnet/mesh (first label of Self.DNSName), if any.
mesh_name() {
  command -v tailscale &>/dev/null || return 0
  tailscale status --json 2>/dev/null | tr -d '\n' \
    | sed -n 's/.*"Self": *{[^{}]*"DNSName": *"\([^".]*\)[.\"].*/\1/p'
}

# Up to 40 characters: letters, digits, space, dot, dash, underscore.
valid_name() { [[ $1 =~ ^[[:alnum:]\ ._-]{1,40}$ ]]; }

# toilet draws the banner. Mandatory: install it if missing (apt), refreshing
# the package lists once if the first try fails (stale lists on a cloud image).
ensure_toilet() {
  command -v toilet &>/dev/null && return 0
  command -v apt-get &>/dev/null || die "toilet is required and there is no apt-get here: install it, then rerun"
  info "Installing toilet (draws the banner)..."
  if ! sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y -qq toilet; then
    sudo apt-get update -qq || die "apt-get update failed"
    sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y -qq toilet || die "Couldn't install toilet"
  fi
  ok "toilet installed"
}

# Ask on a terminal, default No (or the current setting if there is one).
ask_animation() {
  local cur=$1 default_no=--defaultno
  [[ $cur == splash ]] && default_no=""
  local text="Turn on the animated MOTD splash?\n\nOn an SSH login the hostname banner shows centered, with a Nord-blue aurora drifting over it, until you press any key; then the usual MOTD.\n\nNo = the usual static MOTD."
  if command -v dialog &>/dev/null; then
    # Called as $(ask_animation): stdout is the capture, so dialog draws on the tty.
    # shellcheck disable=SC2086 # $default_no is empty or one flag
    if dialog --clear --colors --title " MOTD animation " $default_no --yesno "$text" 13 64 >/dev/tty; then
      clear >/dev/tty
      echo splash
    else
      clear >/dev/tty
      echo off
    fi
    return
  fi
  local r="" hint="[y/N]"
  [[ $cur == splash ]] && hint="[Y/n]"
  printf '%b %s ' "${text//\\n/ }" "$hint" >&2
  read -r r </dev/tty || r=""
  case $r in
    [yY]*) echo splash ;;
    [nN]*) echo off ;;
    *) if [[ $cur == splash ]]; then echo splash; else echo off; fi ;;
  esac
}

# Ask for the banner name on a terminal; $1 = the prefilled value.
ask_name() {
  local def=$1 out text host
  host=$(hostname)
  text="Name shown in the MOTD banner.\n\nHostname: $host. Use another name when the hostname can't be changed (e.g. a cloud default). Empty = the hostname."
  if command -v dialog &>/dev/null; then
    # dialog's answer goes to fd 3 (captured); it draws on the tty.
    if out=$(dialog --clear --title " MOTD name " --output-fd 3 --inputbox "$text" 12 64 "$def" 3>&1 >/dev/tty); then
      clear >/dev/tty
      printf '%s' "$out"
    else
      clear >/dev/tty
      printf '%s' "$def"
    fi
    return
  fi
  printf '%b [%s] ' "${text//\\n/ }" "$def" >&2
  read -r out </dev/tty || out=""
  printf '%s' "${out:-$def}"
}

write_conf() { # $1 = splash | off, $2 = banner name ("" = hostname)
  local tmp
  tmp=$(mktemp) || return 1
  cat >"$tmp" <<EOF
# Options for /etc/update-motd.d/$NAME. Written by dev-motd (dotfiles);
# change them with: dev-motd --animation=on|off --name=TEXT
#
# MOTD_ANIMATION=splash  on an SSH login, the hostname banner with a Nord-blue
#                        aurora until a key is pressed, then the usual MOTD
# MOTD_ANIMATION=off     the usual static MOTD
# MOTD_NAME=<text>       name in the banner; empty = the hostname
MOTD_ANIMATION=$1
MOTD_NAME="$2"
EOF
  sudo install -m 0644 -o root -g root "$tmp" "$CONF"
  local rc=$?
  rm -f "$tmp"
  return $rc
}

# ------------------------------------------------------------------------------
# Actions
# ------------------------------------------------------------------------------
do_install() { # uses WANT / WANT_NAME (+ WANT_NAME_SET) from the flags
  local want=$WANT name=$WANT_NAME src="$MOTD_SRC_DIR/$NAME" dst="$TARGET_DIR/$NAME"
  local interactive=true mesh
  [[ -f $src ]] || die "Source not found: $src"
  [[ ${NONINTERACTIVE:-false} == true || ! -t 0 || ! -t 1 ]] && interactive=false
  ensure_toilet

  read_conf
  if [[ -z $want ]]; then
    if [[ $interactive == true ]]; then
      want=$(ask_animation "$CUR_ANIM")
    else
      want=${CUR_ANIM:-off}
      skip "Animation question (non-interactive): keeping '$want'"
    fi
  fi
  if ((! WANT_NAME_SET)); then
    if [[ $interactive == true ]]; then
      mesh=$(mesh_name)
      [[ $mesh == "$(hostname)" ]] && mesh=""
      name=$(ask_name "${CUR_NAME:-${mesh:-$(hostname)}}")
    else
      name=$CUR_NAME
    fi
  fi
  # Trim; the hostname itself is stored as empty (follows a later rename).
  name=${name#"${name%%[![:space:]]*}"} name=${name%"${name##*[![:space:]]}"}
  [[ $name == "$(hostname)" ]] && name=""
  if [[ -n $name ]] && ! valid_name "$name"; then
    die "Invalid name '$name': up to 40 letters, digits, spaces, dots, dashes or underscores"
  fi

  info "Installing $NAME -> $dst"
  # A fresh machine may not have the directory yet.
  if ! sudo mkdir -p "$TARGET_DIR" || ! sudo install -m 0755 -o root -g root "$src" "$dst"; then
    die "Couldn't install $dst"
  fi
  ok "MOTD installed"

  write_conf "$want" "$name" || die "Couldn't write $CONF"
  ok "Animation: $want, banner name: ${name:-$(hostname) (hostname)} ($CONF)"

  touch "$HUSH" && ok "Created ~/.hushlogin (zsh prints the MOTD, PAM stays quiet)"
  info "Shown on your next SSH login (zsh, outside tmux)"
}

do_remove() {
  local dst="$TARGET_DIR/$NAME"
  if [[ -e $dst ]]; then
    sudo rm -f "$dst" && ok "Removed $dst"
  else
    skip "Not installed: $dst"
  fi
  if [[ -e $CONF ]]; then
    sudo rm -f "$CONF" && ok "Removed $CONF"
  fi
  # With no MOTD left, let pam_motd speak again (Debian's uname + /etc/motd).
  rm -f "$HUSH" && ok "Removed ~/.hushlogin"
}

do_status() {
  local src="$MOTD_SRC_DIR/$NAME" dst="$TARGET_DIR/$NAME"
  if [[ ! -e $dst ]]; then
    warn "MOTD: not installed ($dst)"
  elif cmp -s "$src" "$dst"; then
    ok "MOTD: installed, same as the repo"
  else
    warn "MOTD: installed, differs from the repo (run dev-motd to update)"
  fi
  read_conf
  info "Animation: ${CUR_ANIM:-off (no $CONF)}"
  info "Banner name: ${CUR_NAME:-$(hostname) (hostname)}"
  if [[ -e $HUSH ]]; then
    ok "$HUSH: present"
  else
    warn "$HUSH: missing (PAM prints the MOTD too)"
  fi
  command -v toilet &>/dev/null || warn "toilet: missing (plain-text banner; dev-motd installs it)"
}

# ------------------------------------------------------------------------------
# Main
# ------------------------------------------------------------------------------
ACTION=install WANT="" WANT_NAME="" WANT_NAME_SET=0
while (($#)); do
  case $1 in
    -h | --help)
      usage
      exit 0
      ;;
    --status) ACTION=status ;;
    --remove | remove) ACTION=remove ;;
    install) ACTION=install ;;
    --animation=on | --animation=splash) WANT=splash ;;
    --animation=off) WANT=off ;;
    --animation=*) die "Unknown animation '${1#*=}' (on or off)" ;;
    --name=*) WANT_NAME=${1#--name=} WANT_NAME_SET=1 ;;
    -*) die "Unknown option: $1 (see --help)" ;;
    *) NAME=$1 ;;
  esac
  shift
done

case $ACTION in
  install) do_install ;;
  remove) do_remove ;;
  status) do_status ;;
esac
