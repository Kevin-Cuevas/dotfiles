#!/usr/bin/env bash
set -uo pipefail

# ==============================================================================
# dev-ssh — manage per-machine SSH hosts in ~/.ssh/config.local
# ==============================================================================
# Run with no args to open the dialog menu (control dir + add servers via Manual
# or Tailscale autocomplete). Run with --setup for the non-interactive bits only
# (control-master dir + ensure config.local exists). bootstrap calls this script.
#
#   dev-ssh                  open the interactive menu
#   dev-ssh --setup          create ~/.ssh/cm + ensure config.local (no prompts)
#   dev-ssh --target=DIR     operate against DIR instead of $HOME (bootstrap test)
#   dev-ssh --add-host=ALIAS [--user=U] [--port=P] [--group=G]
#                            add/update one host, no prompts (for other scripts).
#                            Group defaults to the active tailnet, else 'manual'.
#   dev-ssh --remove-host=ALIAS
#                            remove one host from whatever group holds it, no
#                            prompts (exit 3 if it isn't there).
#   dev-ssh --list-hosts[=GROUP]
#                            managed hosts as TSV: alias, user, port, group.
#   dev-ssh --setup-dns      let systemd-resolved own /etc/resolv.conf, so MagicDNS
#                            and the network manager stop overwriting each other
#   dev-ssh --dns-status     checks for the above (exit 1 if something is off)
#   dev-ssh --remove-dns     undo --setup-dns
# ==============================================================================

TARGET="$HOME"
MODE="menu"
ADD_HOST="" ADD_USER="" ADD_PORT="" ADD_GROUP="" RM_HOST="" LIST_GROUP=""
for arg in "$@"; do
  case "$arg" in
    --setup) MODE="setup" ;;
    --target=*) TARGET="${arg#--target=}" ;;
    --add-host=*) MODE="add" ADD_HOST="${arg#--add-host=}" ;;
    --remove-host=*) MODE="remove" RM_HOST="${arg#--remove-host=}" ;;
    --list-hosts) MODE="list" ;;
    --list-hosts=*) MODE="list" LIST_GROUP="${arg#--list-hosts=}" ;;
    --setup-dns) MODE="setup-dns" ;;
    --dns-status) MODE="dns-status" ;;
    --remove-dns) MODE="remove-dns" ;;
    --user=*) ADD_USER="${arg#--user=}" ;;
    --port=*) ADD_PORT="${arg#--port=}" ;;
    --group=*) ADD_GROUP="${arg#--group=}" ;;
    *) ;;
  esac
done

# ------------------------------------------------------------------------------
# Look & feel (shared with bootstrap)
# ------------------------------------------------------------------------------
RED='\e[38;2;191;97;106m'
GRN='\e[38;2;163;190;140m'
YLW='\e[38;2;235;203;139m'
BLU='\e[38;2;136;192;208m'
CYN='\e[38;2;143;188;187m'
DIM='\e[38;2;94;129;172m'
BLD='\e[1m'
RST='\e[0m'

info() { printf "${BLU}[INFO]${RST}  %s\n" "$*"; }
ok() { printf "${GRN}[OK]${RST}    %s\n" "$*"; }
err() { printf "${RED}[ERR]${RST}   %s\n" "$*" >&2; }
warn() { printf "${YLW}[WARN]${RST}  %s\n" "$*"; }
skip() { printf "${CYN}[SKIP]${RST}  %s\n" "$*"; }
die() {
  err "$*"
  exit 1
}
sep() { printf "${DIM}%s${RST}\n" "  ──────────────────────────────────────────────────"; }

# When launched from bootstrap, reuse its backtitle so it looks identical.
BACKTITLE="${DEV_SSH_BACKTITLE:-DEV-SSH · $(hostname) · $(date '+%Y-%m-%d %H:%M')}"

print_header() {
  clear
  printf "${DIM}  ════════════════════════════════════════════════${RST}\n"
  printf "${BLU}${BLD}   DEV-SSH${RST}\n"
  printf "${CYN}   Host: %s   Date: %s${RST}\n" "$(hostname)" "$(date '+%Y-%m-%d %H:%M')"
  printf "${DIM}  ════════════════════════════════════════════════${RST}\n\n"
}

# Trim leading/trailing whitespace (no subprocess).
trim() {
  local s="$1"
  s="${s#"${s%%[![:space:]]*}"}"
  s="${s%"${s##*[![:space:]]}"}"
  printf '%s' "$s"
}

# Markers of the managed host block inside ~/.ssh/config.local. dev-ssh ONLY
# rewrites whatever is between these two lines; everything else (e.g. your
# IdentityFile entries) is preserved untouched across runs.
SSH_MARK_BEGIN="# >>> dotfiles:ssh-hosts (managed — do not edit by hand) >>>"
SSH_MARK_END="# <<< dotfiles:ssh-hosts <<<"
# Legacy (pre-English) begin marker, upgraded in place on first run.
SSH_MARK_BEGIN_LEGACY="# >>> dotfiles:ssh-hosts (managed — no editar a mano) >>>"

# ------------------------------------------------------------------------------
# Control dir + config.local
# ------------------------------------------------------------------------------
setup_ssh() {
  sep
  info "Setting up SSH control-master directory..."
  local ssh_dir="$TARGET/.ssh"
  local cm_dir="$ssh_dir/cm"
  mkdir -p "$cm_dir"
  chmod 700 "$ssh_dir"
  chmod 700 "$cm_dir"
  ok "SSH ready — $cm_dir (700)"
  ensure_config_local
}

# Create/repair ~/.ssh/config.local idempotently. User content (outside the
# markers) is always preserved; this only guarantees the empty managed block.
ensure_config_local() {
  local ssh_dir="$TARGET/.ssh"
  local cfg="$ssh_dir/config.local"
  mkdir -p "$ssh_dir"
  chmod 700 "$ssh_dir"

  # Upgrade the legacy (Spanish) begin marker to the current one, if present.
  if [[ -f "$cfg" ]] && grep -qF "$SSH_MARK_BEGIN_LEGACY" "$cfg"; then
    sed -i "s|$SSH_MARK_BEGIN_LEGACY|$SSH_MARK_BEGIN|" "$cfg"
    ok "Upgraded managed-block marker to the current format — $cfg"
  fi

  if [[ ! -e "$cfg" ]]; then
    (
      umask 077
      {
        printf '%s\n' "# ~/.ssh/config.local — machine-specific, NOT tracked by dotfiles."
        printf '%s\n' "# Anything OUTSIDE the managed block below is preserved across dev-ssh"
        printf '%s\n' "# runs; the managed block is regenerated by dev-ssh. Your IdentityFile"
        printf '%s\n' "# entries, hand-written hosts, etc. go here (outside the markers)."
        printf '\n'
        printf '%s\n' "$SSH_MARK_BEGIN"
        printf '%s\n' "$SSH_MARK_END"
      } >"$cfg"
    )
    chmod 600 "$cfg"
    ok "config.local created (empty managed block) — $cfg"
    return
  fi

  if ! grep -qF "$SSH_MARK_BEGIN" "$cfg"; then
    {
      printf '\n'
      printf '%s\n' "$SSH_MARK_BEGIN"
      printf '%s\n' "$SSH_MARK_END"
    } >>"$cfg"
    chmod 600 "$cfg"
    ok "Managed block added (preserving your config.local) — $cfg"
    return
  fi

  skip "config.local already has a managed block — $cfg"
}

# Read "Host ..." blocks from stdin and insert/update them in the managed block
# of config.local, under group $1 (e.g. "manual" or "tailnet:<name>"). Hosts are
# tagged with "#@ group:<gid>" comment headers. GLOBAL dedup by alias: an alias
# lives in a single group (the last one it was added to). Atomic, chmod 600,
# preserves everything outside the markers.
ssh_upsert_hosts() {
  local gid="${1:-}"
  local replace="${2:-}" # "replace" = remove existing hosts in gid not in new set
  ensure_config_local
  local cfg="$TARGET/.ssh/config.local"

  local newblocks
  newblocks="$(cat)"
  if [[ -z "${newblocks//[$' \t\n']/}" ]]; then
    if [[ "$replace" != "replace" ]]; then
      warn "Nothing to add."
      return
    fi
    # replace mode with empty set: remove all hosts in the group
  fi

  local newfile tmp
  newfile="$(mktemp)"
  tmp="$(mktemp)"
  printf '%s\n' "$newblocks" >"$newfile"

  awk -v B="$SSH_MARK_BEGIN" -v E="$SSH_MARK_END" -v G="$gid" -v REPL="$replace" '
    # Phase 1: new blocks (FNR==NR -> first file). All go into group G.
    FNR==NR {
      if ($0 ~ /^[[:space:]]*$/) next
      if ($0 ~ /^Host /) { a=$2; cur=a; if (!(a in blk)) ord[++n]=a; blk[a]=$0 ORS; group[a]=G; next }
      if (cur != "") blk[cur]=blk[cur] $0 ORS
      next
    }
    # Phase 2: existing config.local
    {
      if ($0 == B) { print; inman=1; cg=""; next }
      if ($0 == E) { emit(); print; inman=0; next }
      if (inman) {
        if ($0 ~ /^[[:space:]]*$/) next
        if ($0 ~ /^#@ group:/) { cg=substr($0, length("#@ group:") + 1); next }
        if ($0 ~ /^Host /) {
          a=$2
          if (a in blk) { cur2="" }                                    # in new set: use new entry
          else if (REPL=="replace" && G!="" && cg==G) { cur2="" }     # same group, not selected: remove
          else { cur2=a; ord[++n]=a; blk[a]=$0 ORS; group[a]=cg }
          next
        }
        if (cur2 != "") blk[cur2]=blk[cur2] $0 ORS
        next
      }
      print
    }
    # Emit: loose hosts first (gid=""), then each group (alphabetical) with its
    # header; hosts sorted within each group.
    function emit(   i,j,t,a,g,gl,gn,keys,m) {
      emit_one("")
      gn=0
      for (i=1;i<=n;i++) { a=ord[i]; g=group[a]; if (g!="" && !(g in gseen)) { gseen[g]=1; gl[++gn]=g } }
      for (i=1;i<=gn;i++) for (j=i+1;j<=gn;j++) if (gl[j] < gl[i]) { t=gl[i]; gl[i]=gl[j]; gl[j]=t }
      for (i=1;i<=gn;i++) { print "#@ group:" gl[i]; emit_one(gl[i]) }
    }
    function emit_one(g,   i,j,t,a,keys,m) {
      m=0
      for (i=1;i<=n;i++) { a=ord[i]; if (group[a]==g) keys[++m]=a }
      for (i=1;i<=m;i++) for (j=i+1;j<=m;j++) if (keys[j] < keys[i]) { t=keys[i]; keys[i]=keys[j]; keys[j]=t }
      for (i=1;i<=m;i++) printf "%s", blk[keys[i]]
    }
  ' "$newfile" "$cfg" >"$tmp"

  chmod 600 "$tmp"
  mv "$tmp" "$cfg"
  rm -f "$newfile"
}

# ------------------------------------------------------------------------------
# Tailscale helpers
# ------------------------------------------------------------------------------
# Returns Tailscale peers (self excluded) as "name<TAB>state". Uses the MagicDNS
# label (.DNSName, first label) — not .HostName, which may carry spaces or OS
# hostnames (e.g. "Pixel 9 Pro XL", "ip-172-31-...").
ssh_tailscale_peers() {
  if command -v jq &>/dev/null; then
    tailscale status --json 2>/dev/null \
      | jq -r '.Peer[]? | [(.DNSName | split(".")[0]), (if .Online then "online" else "offline" end)] | @tsv'
  elif command -v python3 &>/dev/null; then
    tailscale status --json 2>/dev/null | python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(0)
for p in (d.get("Peer") or {}).values():
    label = (p.get("DNSName", "") or "").split(".")[0]
    if label:
        print("%s\t%s" % (label, "online" if p.get("Online") else "offline"))
'
  else
    local self_ip
    self_ip="$(tailscale ip -4 2>/dev/null | head -1)"
    tailscale status 2>/dev/null \
      | awk -v self="$self_ip" '$1 ~ /^100\./ && $1 != self { printf "%s\t?\n", $2 }'
  fi
}

# tailscale installed but no visible tailnets usually means the user isn't the
# daemon's 'operator', so status/switch return nothing without sudo. We grant
# that permission (needs sudo) so they work without sudo afterwards.
# Idempotent; only called when no tailnet is detected.
ssh_tailscale_fix_operator() {
  info "No tailnets detected — granting control to $USER (sudo tailscale set --operator=$USER)..."
  if sudo tailscale set --operator="$USER" &>/dev/null; then
    ok "Tailscale operator set: $USER"
    return 0
  fi
  warn "Couldn't run: sudo tailscale set --operator=$USER"
  return 1
}

# ------------------------------------------------------------------------------
# Username history per (tailnet, node)
# ------------------------------------------------------------------------------
# Hidden, per-machine, NOT tracked file. Share it across your own nodes manually
# (scp). TSV per line: tailnet \t node \t username \t port \t epoch. Append-only;
# queries dedup and order by recency. Tailscale flow only.
# (Legacy 4-field lines without port are handled transparently.)
ssh_hist_file() { printf '%s\n' "$TARGET/.ssh/.ssh_user_history"; }

# Distinct usernames for (tailnet, node), most recent first.
# Handles both 4-field (old: no port) and 5-field (new: with port) formats.
ssh_hist_users() { # $1=tailnet  $2=node
  local f
  f="$(ssh_hist_file)"
  [[ -f "$f" ]] || return 0
  awk -F'\t' -v t="$1" -v n="$2" \
    '$1==t && $2==n { epoch=(NF>=5)?$5:$4; print epoch"\t"NR"\t"$3 }' "$f" \
    | sort -t"$(printf '\t')" -k1,1nr -k2,2nr \
    | awk -F'\t' '!seen[$3]++ { print $3 }'
}

# Record the use of a username+port for (tailnet, node) with a timestamp.
# Format (5 fields): tailnet \t node \t username \t port \t epoch
# One line per (tailnet, node, username, port): using it again only moves it to
# the end with a new time, so re-adding the same host (e.g. every
# `dev-ssh --add-host` from a script) doesn't grow the file. A legacy 4-field
# line (no port, meaning 22) for the same combination is replaced too.
ssh_hist_record() { # $1=tailnet  $2=node  $3=username  $4=port
  [[ -z "$3" ]] && return 0
  local f tmp port="${4:-22}"
  f="$(ssh_hist_file)"
  mkdir -p "$(dirname "$f")"
  tmp="$(mktemp)"
  if [[ -f "$f" ]]; then
    awk -F'\t' -v t="$1" -v n="$2" -v u="$3" -v p="$port" \
      '!($1 == t && $2 == n && $3 == u && (NF >= 5 ? $4 == p : p == "22"))' "$f" >"$tmp"
  fi
  printf '%s\t%s\t%s\t%s\t%s\n' "$1" "$2" "$3" "$port" "$(date +%s)" >>"$tmp"
  chmod 600 "$tmp"
  mv "$tmp" "$f"
}

# Most recent port for (tailnet, node); "22" if no record exists.
# Only reads 5-field entries; 4-field (old format) entries have no port → falls back to 22.
ssh_hist_port() { # $1=tailnet  $2=node
  local f
  f="$(ssh_hist_file)"
  [[ -f "$f" ]] || {
    printf '22'
    return 0
  }
  local p
  p=$(awk -F'\t' -v t="$1" -v n="$2" \
    '$1==t && $2==n && NF>=5 { print $5"\t"NR"\t"$4 }' "$f" \
    | sort -t"$(printf '\t')" -k1,1nr -k2,2nr \
    | awk -F'\t' 'NR==1 { print $3; exit }')
  printf '%s' "${p:-22}"
}

# Hostnames currently saved in config.local for the given group.
ssh_group_hosts() { # $1=group
  local cfg="$TARGET/.ssh/config.local"
  [[ -f "$cfg" ]] || return 0
  awk -v B="$SSH_MARK_BEGIN" -v E="$SSH_MARK_END" -v G="$1" '
    $0==B { inman=1; cg=""; next }
    $0==E { inman=0; next }
    inman && /^#@ group:/ { cg=substr($0, length("#@ group:")+1); next }
    inman && /^Host / && cg==G { print $2 }
  ' "$cfg"
}

# ------------------------------------------------------------------------------
# Add hosts — Manual
# ------------------------------------------------------------------------------
# Manual host entry (form). Everything optional except Host.
ssh_add_manual() {
  sep
  command -v dialog &>/dev/null || {
    warn "dialog not available"
    return
  }

  local out
  out=$(dialog \
    --clear --colors \
    --backtitle "$BACKTITLE" \
    --title " SSH · Manual " \
    --form "Define a host. Only 'Host' is required.\n(empty HostName = Host · empty User = $USER)" \
    16 64 5 \
    "Host" 1 1 "" 1 16 40 0 \
    "HostName" 2 1 "" 2 16 40 0 \
    "User" 3 1 "" 3 16 40 0 \
    "Port" 4 1 "" 4 16 40 0 \
    "IdentityFile" 5 1 "" 5 16 40 0 \
    3>&1 1>&2 2>&3) || {
    clear
    skip "Cancelled."
    return
  }
  clear

  local host hostname user port idfile
  {
    IFS= read -r host
    IFS= read -r hostname
    IFS= read -r user
    IFS= read -r port
    IFS= read -r idfile
  } <<<"$out"
  host="$(trim "$host")"
  hostname="$(trim "$hostname")"
  user="$(trim "$user")"
  port="$(trim "$port")"
  idfile="$(trim "$idfile")"

  if [[ -z "$host" ]]; then
    warn "Empty Host — nothing to do."
    return
  fi
  [[ -z "$hostname" ]] && hostname="$host"
  [[ -z "$user" ]] && user="$USER"

  local block="Host $host"$'\n'"    HostName $hostname"$'\n'"    User $user"$'\n'
  [[ -n "$port" ]] && block+="    Port $port"$'\n'
  [[ -n "$idfile" ]] && block+="    IdentityFile $idfile"$'\n'

  printf '%s' "$block" | ssh_upsert_hosts "manual"
  ok "Host '$host' saved to config.local (group: manual)"
}

# ------------------------------------------------------------------------------
# Add hosts — Tailscale autocomplete
# ------------------------------------------------------------------------------
ssh_add_tailscale() {
  sep
  command -v dialog &>/dev/null || {
    warn "dialog not available"
    return
  }
  command -v tailscale &>/dev/null || {
    warn "tailscale is not installed"
    return
  }

  # --- pick a tailnet (profile) --------------------------------------------
  # `tailscale switch --list`: ID  Tailnet(name)  Account(* = active).
  # tailscale is installed but sometimes the tailnets aren't visible because
  # the user isn't 'operator'. When that happens, we run 'sudo tailscale set
  # --operator' once and retry the detection.
  local cur_id="" sw line lid lname operator_fixed=false
  local ts_items=()
  local -A TS_NAME=()
  for _ in 1 2; do
    ts_items=()
    TS_NAME=()
    if tailscale status &>/dev/null; then
      sw="$(tailscale switch --list 2>/dev/null)"
      cur_id="$(awk 'NR>1 && index($0,"*"){print $1}' <<<"$sw")"
      while IFS= read -r line; do
        [[ "$line" == ID* ]] && continue
        [[ -z "${line// /}" ]] && continue
        lid="${line%% *}"
        lname="$(awk '{print $2}' <<<"$line")"
        TS_NAME["$lid"]="$lname"
        [[ "$lid" == "$cur_id" ]] && lname="$lname [active]"
        ts_items+=("$lid" "$lname")
      done <<<"$sw"
    fi

    [[ ${#ts_items[@]} -gt 0 ]] && break

    # No tailnet detected: try to fix the operator once.
    if [[ "$operator_fixed" == false ]] && ssh_tailscale_fix_operator; then
      operator_fixed=true
      continue
    fi
    break
  done

  if [[ ${#ts_items[@]} -eq 0 ]]; then
    warn "No tailnets detected. Are you logged in? — tailscale up / tailscale login"
    return
  fi

  local chosen_id
  if [[ ${#ts_items[@]} -eq 2 ]]; then
    chosen_id="${ts_items[0]}" # single profile: use it without asking
  else
    chosen_id=$(dialog \
      --clear --colors \
      --backtitle "$BACKTITLE" \
      --title " SSH · Tailscale " \
      --default-item "$cur_id" \
      --menu "Pick the tailnet whose nodes you want to autodetect:" \
      14 70 6 \
      "${ts_items[@]}" \
      3>&1 1>&2 2>&3) || {
      clear
      skip "Cancelled."
      return
    }
    clear
  fi

  local tailnet_name="${TS_NAME[$chosen_id]:-$chosen_id}"

  # If the chosen one is not the active profile, switch to it (no restore).
  if [[ -n "$chosen_id" && "$chosen_id" != "$cur_id" ]]; then
    info "Switching to tailnet '$tailnet_name' (tailscale switch $chosen_id)..."
    if ! tailscale switch "$chosen_id" &>/dev/null; then
      warn "Could not switch to tailnet '$tailnet_name'."
      return
    fi
    tailscale status &>/dev/null || sleep 1
    ok "Active tailnet now: $tailnet_name"
  fi

  local peers
  peers="$(ssh_tailscale_peers)"
  if [[ -z "${peers//[$' \t\n']/}" ]]; then
    warn "No peers found in your tailnet."
    return
  fi

  local -a saved_hosts=()
  local _sh
  while IFS= read -r _sh; do [[ -n "$_sh" ]] && saved_hosts+=("$_sh"); done \
    < <(ssh_group_hosts "tailnet:$tailnet_name")

  local items=() name state
  while IFS=$'\t' read -r name state; do
    [[ -z "$name" ]] && continue
    local check="off"
    for _sh in "${saved_hosts[@]}"; do [[ "$_sh" == "$name" ]] && check="on" && break; done
    items+=("$name" "$state" "$check")
  done <<<"$peers"

  local count=$((${#items[@]} / 3))
  local list_height="$count"
  [[ $list_height -gt 14 ]] && list_height=14
  [[ $list_height -lt 4 ]] && list_height=4
  local win_height=$((list_height + 9))
  [[ $win_height -gt 22 ]] && win_height=22

  local raw
  raw=$(dialog \
    --clear --colors \
    --backtitle "$BACKTITLE" \
    --title " SSH · Tailscale " \
    --separate-output \
    --checklist \
    "Select the nodes to add  [SPACE=toggle  ENTER=confirm]\n\nYou'll then set the User and Port for each node (with carry-over)." \
    "$win_height" 64 "$list_height" \
    "${items[@]}" \
    3>&1 1>&2 2>&3) || {
    clear
    skip "Cancelled."
    return
  }
  clear

  local chosen=()
  while IFS= read -r name; do
    [[ -n "$name" ]] && chosen+=("$name")
  done <<<"$raw"
  if [[ ${#chosen[@]} -eq 0 ]]; then
    if [[ ${#saved_hosts[@]} -gt 0 ]]; then
      printf '' | ssh_upsert_hosts "tailnet:$tailnet_name" "replace"
      ok "${#saved_hosts[@]} host(s) from '$tailnet_name' removed from config.local"
    else
      warn "No nodes selected."
    fi
    return
  fi

  # User+Port per node. Default priority: node history (most recent) > session carry
  # ($last_user, starts at $USER). If the node has history, a selector of the
  # usernames used before is shown + "type another". Every choice is recorded.
  local total=${#chosen[@]} last_user="$USER" blocks="" n u idx=0
  for n in "${chosen[@]}"; do
    idx=$((idx + 1))

    local -a hist=()
    local hu
    while IFS= read -r hu; do [[ -n "$hu" ]] && hist+=("$hu"); done < <(ssh_hist_users "$tailnet_name" "$n")
    local recent="${hist[0]:-}"

    u=""
    if [[ ${#hist[@]} -gt 0 ]]; then
      local menu_items=()
      for hu in "${hist[@]}"; do menu_items+=("$hu" "used before"); done
      menu_items+=("+" "✎ Type another username…")
      local lh=$((${#hist[@]} + 1))
      [[ $lh -gt 10 ]] && lh=10
      # Window must fit the 3-line prompt + the full list (no scroll) + buttons.
      local win=$((lh + 10))

      local pick
      pick=$(dialog \
        --clear --colors \
        --backtitle "$BACKTITLE" \
        --title " SSH · Tailscale " \
        --default-item "$recent" \
        --menu "User for '$n'   ($idx/$total)\n\nPick a username already used on this node, or type another:" \
        "$win" 64 "$lh" \
        "${menu_items[@]}" \
        3>&1 1>&2 2>&3) || {
        clear
        skip "Cancelled."
        return
      }
      clear

      if [[ "$pick" == "+" ]]; then
        u=$(dialog \
          --clear --colors \
          --backtitle "$BACKTITLE" \
          --title " SSH · Tailscale " \
          --inputbox "New User for '$n'   ($idx/$total)" \
          9 64 "$recent" \
          3>&1 1>&2 2>&3) || {
          clear
          skip "Cancelled."
          return
        }
        clear
      else
        u="$pick"
      fi
    else
      u=$(dialog \
        --clear --colors \
        --backtitle "$BACKTITLE" \
        --title " SSH · Tailscale " \
        --inputbox "User for '$n'   ($idx/$total)\n\n(no history for this node · Enter = '$last_user')" \
        10 64 "$last_user" \
        3>&1 1>&2 2>&3) || {
        clear
        skip "Cancelled."
        return
      }
      clear
    fi

    u="$(trim "$u")"
    [[ -z "$u" ]] && u="${recent:-$last_user}"
    last_user="$u"

    # Port prompt — pre-filled with history value or 22
    local hist_port
    hist_port="$(ssh_hist_port "$tailnet_name" "$n")"
    local p
    p=$(dialog \
      --clear --colors \
      --backtitle "$BACKTITLE" \
      --title " SSH · Tailscale " \
      --inputbox "Port for '$n'   ($idx/$total)\n\n(SSH port · Enter = '${hist_port}')" \
      9 64 "$hist_port" \
      3>&1 1>&2 2>&3) || {
      clear
      skip "Cancelled."
      return
    }
    clear
    p="$(trim "$p")"
    [[ -z "$p" ]] && p="$hist_port"
    [[ "$p" =~ ^[0-9]+$ ]] || p="22"

    ssh_hist_record "$tailnet_name" "$n" "$u" "$p"
    blocks+="Host $n"$'\n'"    HostName $n"$'\n'"    User $u"$'\n'
    [[ "$p" != "22" ]] && blocks+="    Port $p"$'\n'
  done

  printf '%s' "$blocks" | ssh_upsert_hosts "tailnet:$tailnet_name" "replace"
  ok "$total host(s) from '$tailnet_name' saved"

  if dns_needed && [[ $TARGET == "$HOME" ]]; then
    if dialog --clear --colors --backtitle "$BACKTITLE" --title " SSH · DNS " \
      --yesno "MagicDNS is on, but $(dns_netmgr) also writes /etc/resolv.conf:\nthese hosts stop resolving whenever it rewrites the file.\n\nSet up DNS now (systemd-resolved)?" 10 68; then
      clear
      dns_setup
    else
      clear
      warn "later: dev-ssh --setup-dns"
    fi
  fi
}

# ------------------------------------------------------------------------------
# DNS: systemd-resolved owns /etc/resolv.conf, so tailscaled (MagicDNS) and the
# network manager stop overwriting each other. The drop-in records how to undo it.
# ------------------------------------------------------------------------------
DNS_DROPIN=/etc/systemd/resolved.conf.d/dev-ssh-dns.conf
DNS_NM_DROPIN=/etc/NetworkManager/conf.d/dev-ssh-dns.conf
DNS_HAND=(/etc/systemd/resolved.conf.d/10-local.conf /etc/NetworkManager/conf.d/10-dns-resolved.conf)
DNS_HAND_BACKUP=/etc/resolv.conf.pre-resolved

dns_mode() {
  if systemctl is-active -q systemd-resolved 2>/dev/null \
    && [[ $(readlink -f /etc/resolv.conf) == /run/systemd/resolve/* ]]; then
    echo resolved
  else
    echo direct
  fi
}

dns_netmgr() {
  if systemctl is-active -q NetworkManager 2>/dev/null; then echo NetworkManager
  elif systemctl is-active -q systemd-networkd 2>/dev/null; then echo networkd
  elif pgrep -x dhclient >/dev/null 2>&1; then echo dhclient
  elif pgrep -x dhcpcd >/dev/null 2>&1; then echo dhcpcd
  else echo static; fi
}

dns_pkg() { [[ $(dpkg-query -W -f='${Status}' "$1" 2>/dev/null) == "install ok installed" ]]; }

dns_magic() { # on | off | none
  command -v tailscale &>/dev/null || { echo none; return; }
  case $(tailscale debug prefs 2>/dev/null | sed -n 's/.*"CorpDNS": *\(true\|false\).*/\1/p' | head -1) in
    true) echo on ;;
    false) echo off ;;
    *) echo none ;;
  esac
}

dns_needed() { [[ $(dns_magic) == on && $(dns_mode) == direct ]]; }

dns_block() {
  [[ $(dns_mode) == resolved ]] && return 0
  local p l
  for p in resolvconf openresolv; do
    dns_pkg "$p" && { echo "$p is installed (it conflicts with systemd-resolved)"; return; }
  done
  case $(dns_netmgr) in
    dhcpcd) echo "dhcpcd writes the DNS here and has no systemd-resolved hook"; return ;;
    dhclient)
      compgen -G '/etc/dhcp/dhclient-enter-hooks.d/*resolved*' >/dev/null \
        || { echo "dhclient has no systemd-resolved hook"; return; } ;;
  esac
  l=$(ss -Hlntu 'sport = :53' 2>/dev/null | awk '{print $5}' \
    | grep -E '^(0\.0\.0\.0|\*|\[::\]|127\.0\.0\.5[34])(%[^:]+)?:53$' | head -1)
  [[ -n $l ]] && echo "something else listens on $l"
}

dns_resolves() { # $1 = name; a few tries
  local i
  for ((i = 0; i < ${2:-10}; i++)); do
    getent ahosts "$1" >/dev/null 2>&1 && return 0
    sleep 1
  done
  return 1
}

dns_nm_reload() {
  sudo nmcli general reload conf,dns-rc >/dev/null 2>&1 || sudo systemctl reload NetworkManager
}

dns_owner() {
  if [[ -e $DNS_DROPIN ]]; then echo dev-ssh
  elif [[ -e ${DNS_HAND[0]} || -e ${DNS_HAND[1]} ]]; then echo "by hand"
  elif compgen -G '/etc/systemd/resolved.conf.d/*infra-mesh*' >/dev/null; then echo infra-mesh
  else echo system; fi
}

dns_status() {
  local bad=0 peer=""
  sep
  info "DNS on $(hostname)"
  if [[ $(dns_mode) == resolved ]]; then
    ok "/etc/resolv.conf -> $(readlink /etc/resolv.conf) (systemd-resolved, set up: $(dns_owner))"
  else
    warn "/etc/resolv.conf is written by $(dns_netmgr), not systemd-resolved"
    [[ $(dns_magic) == on ]] && bad=1
  fi
  if [[ $(dns_netmgr) == NetworkManager ]]; then
    if NetworkManager --print-config 2>/dev/null | grep -qx 'dns=systemd-resolved' \
      || grep -rqsx 'dns=systemd-resolved' /etc/NetworkManager/conf.d/ /etc/NetworkManager/NetworkManager.conf; then
      ok "NetworkManager hands its DNS to systemd-resolved"
    elif [[ $(dns_mode) == resolved ]]; then
      warn "NetworkManager has no dns=systemd-resolved (it detects the link, but may write the file again)"
    fi
  fi
  case $(dns_magic) in
    on)
      if resolvectl dns tailscale0 2>/dev/null | grep -q '100\.100\.100\.100'; then
        ok "MagicDNS: tailscale0 answers $(resolvectl domain tailscale0 2>/dev/null | tr ' ' '\n' | grep -v '^~' | grep -m1 '\.')"
      else
        err "MagicDNS is on, but tailscale0 has no DNS in systemd-resolved"
        bad=1
      fi
      command -v jq &>/dev/null \
        && peer=$(tailscale status --json 2>/dev/null | jq -r '[.Peer[]? | select(.Online) | .DNSName | split(".")[0]][0] // empty')
      if [[ -n $peer ]]; then
        if dns_resolves "$peer" 3; then ok "a mesh name resolves ($peer)"
        else err "a mesh name does not resolve ($peer)"; bad=1; fi
      fi
      if tailscale status 2>/dev/null | grep -q 'dns-fight'; then
        err "tailscale reports a DNS fight (/etc/resolv.conf overwritten)"
        bad=1
      fi
      ;;
    off) info "MagicDNS is off on this machine (tailscale set --accept-dns to use it)" ;;
    none) info "Tailscale is not installed or not running" ;;
  esac
  if dns_resolves deb.debian.org 3; then ok "a public name resolves (deb.debian.org)"
  else err "a public name does not resolve (deb.debian.org)"; bad=1; fi
  [[ $(dns_mode) == direct && -n $(dns_block) ]] && warn "setup blocked here: $(dns_block)"
  return "$bad"
}

dns_write_dropin() { # pkg was prev lines ns dom
  {
    echo "# Written by dev-ssh --setup-dns. Undo with: dev-ssh --remove-dns"
    echo "# dev-ssh-installed-package: $1"
    echo "# dev-ssh-was-enabled: $2"
    echo "# dev-ssh-previous: $3"
    [[ -n $4 ]] && sed 's/^/# dev-ssh-prev: /' <<<"$4"
    echo "[Resolve]"
    echo "LLMNR=no"
    dns_pkg avahi-daemon && echo "MulticastDNS=no"
    [[ -n $5 ]] && echo "DNS=$5"
    [[ -n $6 ]] && echo "Domains=$6"
  } | sudo tee "$DNS_DROPIN" >/dev/null
  sudo chmod 644 "$DNS_DROPIN"
}

dns_adopt() {
  local lines=""
  [[ -r $DNS_HAND_BACKUP ]] && lines=$(grep -vE '^\s*(#|$)' "$DNS_HAND_BACKUP")
  sudo install -d -m 755 /etc/systemd/resolved.conf.d
  dns_write_dropin no no file "$lines" "" ""
  if [[ -e ${DNS_HAND[1]} ]]; then
    printf '[main]\ndns=systemd-resolved\n' | sudo tee "$DNS_NM_DROPIN" >/dev/null
    sudo chmod 644 "$DNS_NM_DROPIN"
  fi
  sudo rm -f "${DNS_HAND[@]}" "$DNS_HAND_BACKUP"
  sudo systemctl restart systemd-resolved
  systemctl is-active -q NetworkManager 2>/dev/null && dns_nm_reload
  ok "hand-made setup adopted: now $DNS_DROPIN${lines:+ (it keeps the old resolv.conf for --remove-dns)}"
}

dns_setup() {
  [[ $TARGET == "$HOME" ]] || { skip "DNS setup changes the system: not with --target"; return 0; }
  sep
  if [[ $(dns_mode) == resolved ]]; then
    case $(dns_owner) in
      dev-ssh) skip "systemd-resolved already owns /etc/resolv.conf (dev-ssh)" ;;
      "by hand") info "adopting the hand-made systemd-resolved setup"; sudo -v && dns_adopt ;;
      *) skip "systemd-resolved already owns /etc/resolv.conf ($(dns_owner))" ;;
    esac
    return 0
  fi
  local why nm pkg=no was=no prev=file lines="" ns="" dom="" r=""
  why=$(dns_block)
  [[ -z $why ]] || { err "DNS setup blocked: $why"; return 1; }
  nm=$(dns_netmgr)
  info "systemd-resolved will own /etc/resolv.conf ($nm writes it today)"
  if [[ ${NONINTERACTIVE:-false} != true && -t 0 ]]; then
    read -rp "  Continue? [y/N] " r
    [[ $r == [yY]* ]] || { skip "Cancelled."; return 0; }
  fi
  sudo -v || return 1
  systemctl is-enabled -q systemd-resolved 2>/dev/null && was=yes
  if [[ -L /etc/resolv.conf ]]; then prev="link:$(readlink /etc/resolv.conf)"
  else lines=$(grep -vE '^\s*(#|$)' /etc/resolv.conf 2>/dev/null); fi
  if [[ $nm != NetworkManager && $nm != networkd ]]; then
    ns=$(awk '$1=="nameserver" && $2 !~ /^(127\.|::1$|100\.100\.100\.100$)/ {printf "%s ", $2}' /etc/resolv.conf 2>/dev/null)
    dom=$(awk '$1=="search" || $1=="domain" {for (i=2; i<=NF; i++) printf "%s ", $i}' /etc/resolv.conf 2>/dev/null)
  fi
  if [[ ! -x /usr/lib/systemd/systemd-resolved && ! -x /lib/systemd/systemd-resolved ]]; then
    info "Installing systemd-resolved..."
    sudo apt-get install -y -qq systemd-resolved >/dev/null || { err "apt-get install systemd-resolved failed"; return 1; }
    pkg=yes
  fi
  sudo install -d -m 755 /etc/systemd/resolved.conf.d
  dns_write_dropin "$pkg" "$was" "$prev" "$lines" "${ns% }" "${dom% }"
  sudo systemctl unmask -q systemd-resolved 2>/dev/null
  if ! sudo systemctl enable -q --now systemd-resolved; then
    dns_undo
    err "systemd-resolved did not start; rolled back"
    return 1
  fi
  sudo systemctl restart systemd-resolved
  [[ $(readlink -f /etc/resolv.conf) == /run/systemd/resolve/* ]] \
    || sudo ln -sfn ../run/systemd/resolve/stub-resolv.conf /etc/resolv.conf
  case $nm in
    NetworkManager)
      printf '[main]\ndns=systemd-resolved\n' | sudo tee "$DNS_NM_DROPIN" >/dev/null
      sudo chmod 644 "$DNS_NM_DROPIN"
      dns_nm_reload
      ;;
    networkd) sudo networkctl reload >/dev/null 2>&1 ;;
  esac
  if ! dns_resolves deb.debian.org; then
    [[ $nm == NetworkManager ]] && sudo systemctl restart NetworkManager && sleep 3
    if ! dns_resolves deb.debian.org; then
      dns_undo
      err "names stopped resolving after the switch; rolled back"
      return 1
    fi
  fi
  systemctl is-active -q tailscaled 2>/dev/null && sudo systemctl restart tailscaled
  ok "systemd-resolved owns /etc/resolv.conf ($nm hands it its DNS)"
}

dns_undo() {
  local pkg was prev lines
  pkg=$(sed -n 's/^# dev-ssh-installed-package: //p' "$DNS_DROPIN")
  was=$(sed -n 's/^# dev-ssh-was-enabled: //p' "$DNS_DROPIN")
  prev=$(sed -n 's/^# dev-ssh-previous: //p' "$DNS_DROPIN")
  lines=$(sed -n 's/^# dev-ssh-prev: //p' "$DNS_DROPIN")
  sudo rm -f "$DNS_DROPIN" "$DNS_NM_DROPIN"
  if [[ $pkg == yes ]]; then
    sudo apt-get purge -y -qq systemd-resolved >/dev/null 2>&1
  elif [[ $was != yes ]]; then
    sudo systemctl disable -q --now systemd-resolved 2>/dev/null
  else
    sudo systemctl restart systemd-resolved
  fi
  sudo rm -f /etc/resolv.conf
  case $prev in
    link:*) sudo ln -sfn "${prev#link:}" /etc/resolv.conf ;;
    *) { echo "# restored by dev-ssh"; [[ -n $lines ]] && printf '%s\n' "$lines"; } | sudo tee /etc/resolv.conf >/dev/null ;;
  esac
  systemctl is-active -q NetworkManager 2>/dev/null && dns_nm_reload
  systemctl is-active -q tailscaled 2>/dev/null && sudo systemctl restart tailscaled
}

dns_remove() {
  [[ $TARGET == "$HOME" ]] || { skip "DNS setup changes the system: not with --target"; return 0; }
  sep
  if [[ ! -e $DNS_DROPIN ]]; then
    skip "no dev-ssh DNS setup here ($(dns_owner))"
    exit 3
  fi
  [[ $(dns_magic) == on ]] && warn "MagicDNS is on: without systemd-resolved, tailscaled and $(dns_netmgr) fight over /etc/resolv.conf again"
  sudo -v || return 1
  dns_undo
  ok "DNS setup removed: /etc/resolv.conf is as before"
}

# ------------------------------------------------------------------------------
# Menu
# ------------------------------------------------------------------------------
ssh_menu() {
  while true; do
    local choice
    choice=$(dialog \
      --clear --colors \
      --backtitle "$BACKTITLE" \
      --title " Configure SSH " \
      --menu "\ZbSelect an action:\ZB" \
      14 64 5 \
      "1" "Control dir (~/.ssh/cm) + ensure config.local" \
      "2" "Add server — Manual" \
      "3" "Add servers — Autocomplete (Tailscale)" \
      "4" "Setup DNS (MagicDNS via systemd-resolved)" \
      "b" "Back" \
      3>&1 1>&2 2>&3) || break

    print_header
    case "$choice" in
      1) (setup_ssh) || true ;;
      2) (ssh_add_manual) || true ;;
      3) (ssh_add_tailscale) || true ;;
      4) (dns_setup && dns_status) || true ;;
      b | B) break ;;
    esac

    [[ "$choice" == "b" || "$choice" == "B" ]] && break
    echo
    read -rp "  Press ENTER to continue..." _
  done
}

# ------------------------------------------------------------------------------
# Main
# ------------------------------------------------------------------------------
# Non-interactive add/update of a single host, the same entry the Tailscale flow
# writes (HostName = alias, resolved by MagicDNS). Upsert only, never "replace":
# the rest of the group must survive a scripted add.
ssh_add_host_cli() {
  local alias="$ADD_HOST" user="${ADD_USER:-$USER}" port="${ADD_PORT:-22}" group="$ADD_GROUP"
  [[ "$alias" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || die "invalid alias: '$alias'"
  [[ "$user" =~ ^[A-Za-z0-9._][A-Za-z0-9._-]*$ ]] || die "invalid user: '$user'"
  if [[ ! "$port" =~ ^[0-9]+$ ]] || ((port < 1 || port > 65535)); then
    die "invalid port: '$port'"
  fi
  if [[ -z "$group" ]]; then
    local active=""
    if command -v tailscale &>/dev/null; then
      active="$(tailscale switch --list 2>/dev/null | awk 'NR>1 && index($0,"*"){print $2; exit}')"
    fi
    group="${active:+tailnet:$active}"
    group="${group:-manual}"
  fi
  [[ "$group" == manual || "$group" == tailnet:?* ]] || die "invalid group: '$group' (manual or tailnet:<name>)"

  local block="Host $alias"$'\n'"    HostName $alias"$'\n'"    User $user"$'\n'
  [[ "$port" != "22" ]] && block+="    Port $port"$'\n'
  printf '%s' "$block" | ssh_upsert_hosts "$group"
  [[ "$group" == tailnet:* ]] && ssh_hist_record "${group#tailnet:}" "$alias" "$user" "$port"
  ok "$alias ($user@$alias:$port) saved under group:$group"
}

ssh_list_hosts_cli() {
  local cfg="$TARGET/.ssh/config.local"
  [[ -f "$cfg" ]] || return 0
  awk -v B="$SSH_MARK_BEGIN" -v E="$SSH_MARK_END" -v G="${1:-}" '
    function flush() { if (a != "" && (G == "" || cg == G)) printf "%s\t%s\t%s\t%s\n", a, u, p, cg; a="" }
    $0==B { inman=1; cg=""; next }
    $0==E { flush(); inman=0; next }
    !inman { next }
    /^#@ group:/ { flush(); cg=substr($0, length("#@ group:")+1); next }
    /^Host / { flush(); a=$2; u=""; p="22"; next }
    $1=="User" { u=$2 }
    $1=="Port" { p=$2 }
  ' "$cfg"
}

ssh_group_blocks() { # $1=group
  local cfg="$TARGET/.ssh/config.local"
  [[ -f "$cfg" ]] || return 0
  awk -v B="$SSH_MARK_BEGIN" -v E="$SSH_MARK_END" -v G="$1" '
    $0==B { inman=1; cg=""; next }
    $0==E { inman=0; next }
    !inman { next }
    /^#@ group:/ { cg=substr($0, length("#@ group:")+1); on=0; next }
    /^Host / { on=(cg==G) }
    on { print }
  ' "$cfg"
}

# Remove one host. Same path the Tailscale checklist takes when a node is
# unticked: the group is rewritten in "replace" mode with every block but this
# one, so the awk in ssh_upsert_hosts stays the only writer of config.local.
ssh_remove_host_cli() {
  local alias="$RM_HOST" row group blocks
  [[ "$alias" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || die "invalid alias: '$alias'"
  row="$(ssh_list_hosts_cli | awk -F'\t' -v a="$alias" '$1==a {print; exit}')"
  if [[ -z "$row" ]]; then
    skip "$alias is not in config.local"
    exit 3
  fi
  group="${row##*$'\t'}"
  [[ -n "$group" ]] || die "$alias has no group in config.local; remove it from the dev-ssh menu"
  blocks="$(ssh_group_blocks "$group" | awk -v a="$alias" '/^Host / {on=($2!=a)} on')"
  printf '%s' "$blocks" | ssh_upsert_hosts "$group" replace
  ok "$alias removed from config.local${group:+ (group:$group)}"
}

main() {
  case "$MODE" in
    setup)
      setup_ssh
      ;;
    add)
      ssh_add_host_cli
      ;;
    remove)
      ssh_remove_host_cli
      ;;
    list)
      ssh_list_hosts_cli "$LIST_GROUP"
      ;;
    setup-dns)
      dns_setup
      ;;
    dns-status)
      dns_status
      ;;
    remove-dns)
      dns_remove
      ;;
    menu)
      command -v dialog &>/dev/null || die "dialog not found. Install it: sudo apt install dialog"
      ssh_menu
      ;;
  esac
}

main
