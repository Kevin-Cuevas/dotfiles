#!/usr/bin/env bash
# Applies the tmux color theme matching the current freedesktop
# (org.freedesktop.appearance color-scheme) light/dark preference.
# 0 = no preference, 1 = prefer-dark, 2 = prefer-light.
set -euo pipefail

scheme=$(gdbus call --session \
  --dest org.freedesktop.portal.Desktop \
  --object-path /org/freedesktop/portal/desktop \
  --method org.freedesktop.portal.Settings.Read \
  org.freedesktop.appearance color-scheme 2>/dev/null | grep -oP 'uint32\s+\K[0-9]+' || true)

if [[ "$scheme" == "2" ]]; then
  theme_file="$HOME/.tmux-theme-light.conf"
else
  theme_file="$HOME/.tmux-theme-dark.conf"
fi

if tmux info &>/dev/null; then
  tmux source-file "$theme_file"
fi
