# ====================================
# Dotfiles gitignore
# ====================================

# Temporary files
.DS_Store
Thumbs.db

# ====================================
# SSH (per-machine, never tracked)
# ====================================
# Username history per (tailnet, node). Shared by hand via scp, not through git.
.ssh_user_history

# Everything inside ssh/.ssh is per-machine material (keys, known_hosts,
# config.local, control masters, etc.); only "config" (the shared base) is tracked.
ssh/.ssh/*
!ssh/.ssh/config

# Sessions and cache
*.swp
*.swo
*.bak
*.tmp
*.log

# ====================================
# zsh
# ====================================
# The zsh/ package only tracks .zshrc and .p10k.zsh; completions go in zsh-completions/.
zsh/.zsh/

# ====================================
# Neovim
# ====================================
nvim/.config/nvim/spell/
nvim/.config/nvim/tt.*
nvim/.config/nvim/.tests
nvim/.config/nvim/doc/tags
nvim/.config/nvim/debug
nvim/.config/nvim/.repro
nvim/.config/nvim/foo.*
nvim/.config/nvim/*.log
nvim/.config/nvim/data
nvim/.config/nvim/.stfolder/
nvim/.config/nvim/.stignore
# lazy-lock.json: per-machine state (nvim rewrites it) — not tracked
nvim/.config/nvim/lazy-lock.json
