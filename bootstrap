#!/usr/bin/env bash
set -uo pipefail

DOTFILES_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

NONINTERACTIVE=false
TARGET="$HOME"
for arg in "$@"; do
  case "$arg" in
    --all) NONINTERACTIVE=true ;;
    --*) ;;
    *) TARGET="$arg" ;;
  esac
done
export NONINTERACTIVE

TEST_MODE=false
[[ "$TARGET" != "$HOME" ]] && TEST_MODE=true

BACKTITLE="DOTFILES BOOTSTRAP · $(hostname) · $(date '+%Y-%m-%d %H:%M')"
[[ "$TEST_MODE" == true ]] && BACKTITLE="$BACKTITLE · [TEST → $TARGET]"

# ==============================================================================
# Load implementation modules
# ==============================================================================
# Everything this script actually DOES lives in bootstrap.d/*.sh, sourced
# here in lexical order. The NN- prefixes exist only to fix that order: 00-
# core.sh must load first since every other module calls its logging/dialog
# helpers. Beyond that, load order genuinely doesn't matter — no module
# calls a function at source time, they only define functions/data tables
# that run later, from run_all()/main_menu() below. So a cross-file
# reference like EXTRA_FN[nvim]="run_dev_nvim" (defined in 10-packages.sh,
# pointing at a function defined in 40-misc.sh) resolves fine regardless of
# load order, as long as both load before `main "$@"` runs.
#
# To add a new module: drop a bootstrap.d/NN-name.sh file next to the
# others (pick a number with room around it — steps of 10 — so later
# modules can slot in without renumbering). Nothing else to wire up here;
# wire it into EXTRA_FN/RUNTIME_FN/the menu below only if it needs to be
# reachable from there.
for _module in "$DOTFILES_DIR"/bootstrap.d/*.sh; do
  # shellcheck source=/dev/null
  source "$_module" || { echo "Failed to load $_module" >&2; exit 1; }
done
unset _module

run_all() {
  install_packages # también dispara install_extra_packages -> nvim + yazi
  set_permissions
  stow_packages
  run_dev_motd  || warn "dev-motd encountered errors — check output above"
  install_fonts
  setup_tw_hook || warn "Timewarrior hook setup failed — check output above"
  install_tpm
  run_dev_ssh --setup || warn "dev-ssh setup encountered errors — check output above"
  if [[ "$NONINTERACTIVE" == false ]]; then
    run_dev_ssh || warn "dev-ssh encountered errors — check output above"
  fi
  set_default_shell confirm || warn "Cambio de shell falló — revisa la salida"
  install_runtimes
  sep
  printf "${GRN}${BLD}  Bootstrap complete.${RST}\n\n"
}

main_menu() {
  local stow_label="Stow packages -> $HOME"
  [[ "$TEST_MODE" == true ]] && stow_label="Stow packages -> $TARGET  [TEST]"

  while true; do
    local choice
    choice=$(dialog \
      --clear --colors \
      --backtitle "$BACKTITLE" \
      --title " Main Menu " \
      --menu "\ZbSelect an action:\ZB" \
      26 64 14 \
      "1" "Run everything  (2 through 12)" \
      "2" "Install apt packages & extra packages" \
      "3" "Set permissions on dev-* scripts" \
      "4" "$stow_label" \
      "5" "Install Neovim      (dev-nvim)" \
      "6" "Install MOTD        (dev-motd)" \
      "7" "Install Nerd Fonts  (FiraCode + FiraMono)" \
      "8" "Setup Timewarrior hook" \
      "9" "Install TPM         (Tmux Plugin Manager)" \
      "10" "Configure SSH    (control dir + servers)" \
      "11" "Set zsh as default shell" \
      "12" "Install language runtimes (rust, node, ...)" \
      "q" "Quit" \
      3>&1 1>&2 2>&3) || break

    print_header
    case "$choice" in
    1) (run_all) || true ;;
    2) (install_packages) || true ;;
    3) (set_permissions) || true ;;
    4) (stow_packages) || true ;;
    5) (run_dev_nvim) || true ;;
    6) (run_dev_motd) || true ;;
    7) (install_fonts) || true ;;
    8) (setup_tw_hook) || true ;;
    9) (install_tpm) || true ;;
    10) (run_dev_ssh) || true ;;
    11) (set_default_shell) || true ;;
    12) (install_runtimes) || true ;;
    q | Q) break ;;
    esac

    echo
    read -rp "  Press ENTER to return to menu..." _
  done

  clear
  ok "Bye."
}

main() {
  preflight
  if [[ "$NONINTERACTIVE" == "true" ]]; then
    print_header
    run_all
  else
    main_menu
  fi
}

main "$@"
