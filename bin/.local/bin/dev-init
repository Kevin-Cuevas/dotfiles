#!/usr/bin/env bash

# Usage: dev-init <ProjectName> <type: frontend|backend> [--git]
PROJECT_NAME="$1"
PROJECT_TYPE="$2"
GIT_FLAG="$3"
TEMPLATES="$HOME/.templates/nvim"
DEST="$PWD/$PROJECT_NAME"

if [ -z "$PROJECT_NAME" ] || [ -z "$PROJECT_TYPE" ]; then
  echo "Usage: dev-init <ProjectName> <type: frontend|backend> [--git]"
  exit 1
fi

mkdir -p "$DEST"

if [ "$PROJECT_TYPE" = "frontend" ]; then
  mkdir -p "$DEST/css" "$DEST/js"
  cp -r "$TEMPLATES/frontend/." "$DEST/"
elif [ "$PROJECT_TYPE" = "backend" ]; then
  cp -r "$TEMPLATES/backend/." "$DEST/"
else
  echo "Unknown project type: frontend | backend"
  exit 1
fi

find "$DEST" -type f | while IFS= read -r f; do
  sed -i "s/{{PROJECT_NAME}}/$PROJECT_NAME/g" "$f"
done

cd "$DEST" || exit
if [ "$GIT_FLAG" = "--git" ]; then
  if git rev-parse --is-inside-work-tree &>/dev/null; then
    echo "Already inside a Git repository. Skipped git init."
  else
    git init
    echo "Git repository initialized."
  fi
else
  echo "Git not initialized (use the --git flag to initialize it)."
fi

echo "Project '$PROJECT_NAME' ($PROJECT_TYPE) created in $DEST"

nvim "$DEST"
